---
import '../styles/tokens.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { useTranslations, getLocaleFromUrl, languages } from '../i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
// Strip any trailing slash so `${base}/path` is correct regardless (config
// base is '/flora-website', without a trailing slash).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = locale === 'en' ? `${base}/` : `${base}/${locale}/`;
const year = new Date().getFullYear(); // SSR fallback; a client script keeps it live
const { title, description } = Astro.props; // optional per-page <title>/meta overrides
const pageTitle = title ?? t.meta.title; // used for <title> and og:/twitter: titles
const pageDescription = description ?? t.meta.description; // used for meta + og/twitter

// SEO: canonical + hreflang alternates, built from Astro.site.
// pagePath is the current path with base and locale prefix stripped ('' = home).
let pagePath = Astro.url.pathname;
if (base !== '/' && pagePath.startsWith(base)) pagePath = pagePath.slice(base.length);
pagePath = pagePath.replace(/^\//, '');
const [maybeLocale, ...restPath] = pagePath.split('/');
if (maybeLocale in languages) pagePath = restPath.join('/');
if (pagePath && !pagePath.endsWith('/')) pagePath += '/';
const abs = (p) => (Astro.site ? new URL(`${base}/${p}`, Astro.site).href : `${base}/${p}`);
const canonical = abs((locale === 'en' ? '' : `${locale}/`) + pagePath);
const ogImage = abs('og-img.png');
const siteHome = abs(''); // absolute default-locale homepage (JSON-LD url + x-default)

// Per-locale OG locale codes (regional variants) + the alternates for the other two.
const ogLocales = { en: 'en_GB', fr: 'fr_BE', es: 'es_ES' };
const ogLocale = ogLocales[locale] ?? ogLocales.en;
const ogLocaleAlternates = Object.keys(ogLocales)
  .filter((l) => l !== locale)
  .map((l) => ogLocales[l]);

// Per-locale share-image alt text.
const ogImageAlts = {
  en: 'Flora Fosset · senior designer, Brussels and Madrid',
  fr: 'Flora Fosset · profil senior en design, Bruxelles et Madrid',
  es: 'Flora Fosset · perfil sénior en diseño, Bruselas y Madrid',
};
const ogImageAlt = ogImageAlts[locale] ?? ogImageAlts.en;

// hreflang: the home page exists in all three locales (reciprocal set +
// x-default). Single-locale pages (e.g. the work article) only self-reference
// by their own locale, plus x-default → default homepage. No fake fr/es URLs.
const alternates =
  pagePath === ''
    ? [
        { hreflang: 'en', href: abs('') },
        { hreflang: 'fr', href: abs('fr/') },
        { hreflang: 'es', href: abs('es/') },
        { hreflang: 'x-default', href: siteHome },
      ]
    : [
        { hreflang: locale, href: canonical },
        { hreflang: 'x-default', href: siteHome },
      ];

// schema.org Person — one JSON-LD block per page. jobTitle is the descriptor
// after "·" in the locale title. sameAs left empty for social links.
const jobTitle = (t.meta.title.split('·')[1] ?? t.meta.title).trim();
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Flora Fosset',
  url: siteHome,
  jobTitle,
  knowsLanguage: ['French', 'Spanish', 'English'],
  areaServed: ['Brussels', 'Madrid'],
  address: [
    { '@type': 'PostalAddress', addressLocality: 'Brussels', addressCountry: 'BE' },
    { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
  ],
  sameAs: [],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}

    <!-- Open Graph / Twitter (link-share previews) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Flora Fosset" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternates.map((l) => (
      <meta property="og:locale:alternate" content={l} />
    ))}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data: schema.org Person -->
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />

    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
  </head>
  <body>
    <header class="site-header at-top">
      <div class="container">
        <nav class="nav-bar" aria-label={t.a11y.mainNav}>
          <a href={home} class="wordmark" aria-label={t.a11y.homeLink}>fosset.co</a>

          <div class="nav-collapse" id="site-nav" data-nav-menu>
            <ul class="nav-links">
              <li><a href="#services" data-nav-link>{t.nav.services}</a></li>
              <li><a href="#work" data-nav-link>{t.nav.work}</a></li>
              <li><a href="#about" data-nav-link>{t.nav.about}</a></li>
              <li><a href="#contact" data-nav-link>{t.nav.contact}</a></li>
            </ul>
            <LanguageSwitcher currentLocale={locale} />
          </div>

          <button
            type="button"
            class="menu-toggle"
            aria-expanded="false"
            aria-controls="site-nav"
            aria-label={t.a11y.openMenu}
            data-menu-toggle
          >
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
          </button>
        </nav>
      </div>
    </header>

    {/* Mobile menu scrim: darkens the page beneath the open full-width menu. */}
    <div class="nav-scrim" data-nav-scrim aria-hidden="true"></div>

    <main>
      <slot />
    </main>

    <footer id="contact" class="site-footer footer-reveal">
      <div class="container footer-cta">
        <h2>{t.contact.sectionTitle}</h2>
        <p class="footer-sub">{t.contact.subhead}{t.contact.note && ` ${t.contact.note}`}</p>
        <div class="footer-links">
          <a href={`mailto:${t.contact.email}`} class="footer-cta-btn">{t.contact.email}</a>
        </div>
      </div>
      <div class="container footer-meta">
        <span>{t.footer.rights} <span data-year>{year}</span></span>
        <span class="footer-meta-end">
          <a href={t.contact.linkedin} target="_blank" rel="noopener" class="footer-linkedin">
            {t.contact.linkedinLabel}
          </a>
          <LanguageSwitcher currentLocale={locale} variant="footer" />
        </span>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('[data-menu-toggle]');
      const menu = document.querySelector('[data-nav-menu]');
      const scrim = document.querySelector('[data-nav-scrim]');
      if (toggle && menu) {
        const setOpen = (open) => {
          toggle.setAttribute('aria-expanded', String(open));
          toggle.classList.toggle('is-open', open);
          menu.classList.toggle('is-open', open);
          if (scrim) scrim.classList.toggle('is-open', open);
        };
        toggle.addEventListener('click', () => {
          setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });
        // Close after picking a destination (nav link or language).
        menu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setOpen(false));
        });
        // Tapping the darkened area (or Escape) closes the menu.
        if (scrim) scrim.addEventListener('click', () => setOpen(false));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });
      }

      // Hide the nav on scroll down, reveal it on scroll up (swipe in/out).
      const header = document.querySelector('.site-header');
      if (header) {
        const hero = document.querySelector('[data-hero]');
        let lastY = window.scrollY;
        let ticking = false;
        // Wear the borderless "default" nav while the hero still fills the top
        // of the viewport; drop it (revealing the sticky pill) once scrolled
        // past. Pages with no hero (subpages) always use the pill.
        const syncTop = () => {
          const atTop = !!hero && hero.getBoundingClientRect().bottom > 120;
          header.classList.toggle('at-top', atTop);
        };
        const update = () => {
          const y = window.scrollY;
          const delta = y - lastY;
          // Ignore tiny jitters and the rubber-band overscroll at the very top.
          if (Math.abs(delta) > 6) {
            // Keep it shown while the mobile menu is open, and near the top.
            const menuOpen = menu && menu.classList.contains('is-open');
            if (delta > 0 && y > 80 && !menuOpen) {
              header.classList.add('is-hidden');
            } else if (delta < 0) {
              header.classList.remove('is-hidden');
            }
            lastY = y;
          }
          syncTop();
          ticking = false;
        };
        syncTop();
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              window.requestAnimationFrame(update);
              ticking = true;
            }
          },
          { passive: true }
        );
      }

      // Keep the copyright year current without a rebuild.
      const yearEl = document.querySelector('[data-year]');
      if (yearEl) yearEl.textContent = String(new Date().getFullYear());

      // The footer is position:fixed, so a plain #contact anchor doesn't move.
      // Intercept "let's chat" links (nav + hero photo) and scroll to the
      // bottom of the page, which reveals the footer drawer.
      document.addEventListener('click', (e) => {
        const link = e.target instanceof Element ? e.target.closest('a[href="#contact"]') : null;
        if (!link) return;
        e.preventDefault();
        window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
      });

      // Active nav state: highlight the link for the section currently in view.
      const navLinks = Array.from(document.querySelectorAll('.nav-links a[data-nav-link]'));
      if (navLinks.length) {
        const setActive = (hash) => {
          navLinks.forEach((a) => a.classList.toggle('is-active', a.getAttribute('href') === hash));
        };
        const spied = ['services', 'work', 'about']
          .map((id) => document.getElementById(id))
          .filter(Boolean);
        if (spied.length && 'IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((en) => {
                if (en.isIntersecting) setActive('#' + en.target.id);
              });
            },
            // Effective viewport is a thin band at the vertical centre.
            { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
          );
          spied.forEach((s) => io.observe(s));
        }
        // At the bottom, the revealed footer is the active "section".
        window.addEventListener(
          'scroll',
          () => {
            const atBottom =
              window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
            if (atBottom) setActive('#contact');
          },
          { passive: true }
        );
      }
    </script>

    <style>
      /* Fixed, floating just below the top edge. Slides out of view on scroll
         down and swipes back in on scroll up (see the scroll-direction script). */
      .site-header {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 20;
        padding-top: var(--space-2);
        transition: transform 0.35s var(--ease);
        will-change: transform;
      }
      /* Hidden: lift the whole bar (plus its top padding) above the viewport. */
      .site-header.is-hidden {
        transform: translateY(calc(-100% - var(--space-2)));
      }
      @media (prefers-reduced-motion: reduce) {
        .site-header { transition: none; }
      }

      /* Scrim behind the mobile menu (toggled by .is-open in the script).
         Burnt-orange brand tint at partial opacity; only shown on mobile,
         where the menu becomes a full-width sheet. */
      .nav-scrim {
        position: fixed;
        inset: 0;
        z-index: 15;
        background: color-mix(in srgb, var(--color-primary) 42%, transparent);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s var(--ease);
      }
      @media (min-width: 768px) {
        .nav-scrim { display: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        .nav-scrim { transition: none; }
      }

      /* The floating translucent bar (matches the Figma frame). */
      .nav-bar {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        padding: 16px 24px;
        font-family: var(--font-display);
        font-size: 1rem;
        background: rgba(255, 255, 255, 0.7);
        -webkit-backdrop-filter: blur(4.5px);
        backdrop-filter: blur(4.5px);
        box-shadow: 0 4px 16px 0 rgba(222, 220, 218, 0.15);
        border-radius: var(--radius-pill);
        transition: background-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
      }

      /* Default (landing) state: while the hero fills the top of the viewport,
         the bar sheds its pill — no wrapper, no background — and spans the
         hero's full width, aligned to the hero gutter like the rest of it.
         Scrolling past the hero restores the sticky pill above. */
      .site-header.at-top > .container {
        max-width: var(--maxw-hero);
      }
      .site-header.at-top .nav-bar {
        padding-inline: 0;
        background-color: transparent;
        box-shadow: none;
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
        border-radius: 0;
      }

      /* "fosset.co" wordmark — light weight, primary color. */
      .wordmark {
        flex-shrink: 0;
        text-decoration: none;
        font-weight: 300;
        line-height: 1;
        color: var(--color-primary);
      }

      /* On desktop the collapse is transparent: its children (links + langs)
         become direct flex items of the bar. */
      .nav-collapse { display: contents; }

      .nav-links {
        flex: 1 0 0;
        display: flex;
        justify-content: center;
        gap: 40px;
        list-style: none;
        color: var(--color-muted-soft);
        font-weight: 300;
      }
      .nav-links a {
        position: relative;
        text-decoration: none;
        color: inherit;
        white-space: nowrap;
        transition: color 0.2s var(--ease);
      }
      /* Underline that wipes in from the left on hover / focus / active. */
      .nav-links a::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.3em;
        height: 1.5px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.25s var(--ease);
      }
      .nav-links a:hover,
      .nav-links a:focus-visible,
      .nav-links a.is-active {
        color: var(--color-primary);
      }
      .nav-links a:hover::after,
      .nav-links a:focus-visible::after,
      .nav-links a.is-active::after {
        transform: scaleX(1);
      }
      @media (prefers-reduced-motion: reduce) {
        .nav-links a::after { transition: none; }
      }

      /* Hamburger — hidden on desktop. */
      .menu-toggle {
        display: none;
        width: 28px;
        height: 24px;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        padding: 0;
        color: var(--color-text);
      }
      .menu-toggle .bar {
        display: block;
        height: 2px;
        width: 100%;
        background: currentColor;
        transition: transform 0.25s var(--ease), opacity 0.2s var(--ease);
        transform-origin: center;
      }
      .menu-toggle.is-open .bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
      .menu-toggle.is-open .bar:nth-child(2) { opacity: 0; }
      .menu-toggle.is-open .bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

      /* --- Mobile: collapse links + langs into a dropdown --- */
      @media (max-width: 767px) {
        .menu-toggle { display: inline-flex; }
        .nav-collapse {
          display: none;
          position: absolute;
          /* Joins directly onto the bottom of the (now white) bar — no gap,
             so the wordmark + close button read as part of the same sheet. */
          top: 100%;
          /* Break out of the pill + container gutter to span the full screen
             width; the height is whatever the links + language picker need. */
          left: 50%;
          right: auto;
          width: 100vw;
          transform: translateX(-50%);
          flex-direction: column;
          align-items: flex-start;
          gap: var(--space-4);
          padding: var(--space-4) var(--gutter);
          background: rgba(255, 255, 255, 0.98);
          -webkit-backdrop-filter: blur(4.5px);
          backdrop-filter: blur(4.5px);
          box-shadow: 0 12px 24px 0 rgba(222, 220, 218, 0.25);
          border-radius: 0;
        }
        .nav-collapse.is-open { display: flex; }

        /* When the menu is open, pull the wordmark + close button onto the same
           white sheet: the bar sheds its pill, breaks out to the full screen
           width, and butts up against the dropdown below it. */
        .nav-bar:has(.nav-collapse.is-open) {
          margin-inline: calc(var(--gutter) * -1);
          padding: 16px var(--gutter);
          background: rgba(255, 255, 255, 0.98);
          -webkit-backdrop-filter: blur(4.5px);
          backdrop-filter: blur(4.5px);
          border-radius: 0;
          box-shadow: none;
        }

        /* Dark-orange translucent layer over the page below the open menu.
           Sits above the page (main z-index 1) but below the header (20), so
           the bar + full-width menu stay clear while everything else dims. */
        .nav-scrim.is-open { opacity: 1; pointer-events: auto; }
        .nav-links {
          flex: none;
          flex-direction: column;
          align-items: flex-start;
          gap: var(--space-3);
          justify-content: flex-start;
        }
      }

      /* Fixed-footer reveal. The page content rides ABOVE the footer on its own
         opaque layer (z-index 1 + solid bg), so the footer stays hidden while
         scrolling. main's bottom margin equals the footer height, opening the
         scroll room that uncovers the footer like a drawer at the end. No JS. */
      main {
        position: relative;
        z-index: 1;
        background: var(--color-bg);
        margin-bottom: 100vh;
      }

      /* The merged Contact CTA + footer, pinned behind the page (z-index -1).
         Orange = the existing brand accent, so the drawer matches the other
         orange sections; light text + an inverted (light) pill read well on it. */
      .footer-reveal {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: -1;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--color-purple);
        color: var(--color-ink-on-purple);
        text-align: center;
      }

      /* Mobile: drop the fixed "drawer" reveal — it scrolls janky on touch.
         The footer just flows normally after the page content. */
      @media (max-width: 768px) {
        main { margin-bottom: 0; }
        .footer-reveal {
          position: static;
          z-index: auto;
          min-height: auto;
        }
        .footer-cta { flex: none; }
      }

      .footer-cta {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        /* Top: this section's half of the About -> footer seam (matches every
           other boundary). Bottom: block-tier breathing above the footer meta. */
        padding-block: calc(var(--space-section) / 2) var(--space-block);
      }
      .footer-cta h2 {
        font-size: var(--fs-hero);
        line-height: 1.02;
        letter-spacing: -0.03em;
        max-width: 22ch;
        margin-inline: auto;
        color: var(--color-ink-on-purple);
      }
      .footer-sub {
        margin: var(--space-3) auto 0;
        max-width: 52ch;
        font-size: 1.125rem;
        line-height: 1.5;
        color: var(--color-muted-on-purple);
      }
      .footer-links {
        display: flex;
        gap: var(--space-3);
        align-items: center;
        justify-content: center;
        margin-top: var(--space-4);
        flex-wrap: wrap;
      }
      .footer-cta-btn {
        background: var(--color-ink-on-purple);
        color: var(--color-purple);
        text-decoration: none;
        padding: 0.8rem 1.6rem;
        border-radius: var(--radius-pill);
        font-weight: 600;
      }
      .footer-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-2) var(--space-3);
        flex-wrap: wrap;
        padding-block: var(--space-4);
        border-top: 1px solid var(--color-line-on-purple);
        font-size: var(--fs-small);
        color: var(--color-muted-on-purple);
      }
      .footer-meta-end {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        flex-wrap: wrap;
      }
      .footer-linkedin {
        color: var(--color-muted-on-purple);
        text-decoration: underline;
        text-underline-position: from-font;
        transition: color 0.2s var(--ease);
      }
      .footer-linkedin:hover { color: var(--color-ink-on-purple); }
    </style>
  </body>
</html>
