---
import '../styles/tokens.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { useTranslations, getLocaleFromUrl } from '../i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const base = import.meta.env.BASE_URL; // includes a trailing slash, e.g. '/flora-website/'
const home = locale === 'en' ? base : `${base}${locale}/`;
const year = new Date().getFullYear(); // SSR fallback; a client script keeps it live
const { title } = Astro.props; // optional per-page <title> override
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <nav class="nav-bar" aria-label="Main">
          <a href={home} class="wordmark" aria-label="Flora Fosset — home">fosset.co</a>

          <div class="nav-collapse" id="site-nav" data-nav-menu>
            <ul class="nav-links">
              <li><a href="#services" data-nav-link>{t.nav.services}</a></li>
              <li><a href="#work" data-nav-link>{t.nav.work}</a></li>
              <li><a href="#about" data-nav-link>{t.nav.about}</a></li>
            </ul>
            <LanguageSwitcher currentLocale={locale} />
          </div>

          <button
            type="button"
            class="menu-toggle"
            aria-expanded="false"
            aria-controls="site-nav"
            aria-label="Open menu"
            data-menu-toggle
          >
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer id="contact" class="site-footer footer-reveal">
      <div class="container footer-cta">
        <h2>{t.contact.sectionTitle}</h2>
        <p class="footer-sub">{t.contact.subhead}</p>
        {t.contact.note && <p class="footer-note">{t.contact.note}</p>}
        <div class="footer-links">
          <a href={`mailto:${t.contact.email}`} class="footer-cta-btn">{t.contact.email}</a>
        </div>
      </div>
      <div class="container footer-meta">
        <span>{t.footer.rights} <span data-year>{year}</span></span>
        <span class="footer-meta-end">
          <a href={t.contact.linkedin} target="_blank" rel="noopener" class="footer-linkedin">
            {t.contact.linkedinLabel}
          </a>
          <span>{t.footer.location}</span>
        </span>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('[data-menu-toggle]');
      const menu = document.querySelector('[data-nav-menu]');
      if (toggle && menu) {
        const setOpen = (open) => {
          toggle.setAttribute('aria-expanded', String(open));
          toggle.classList.toggle('is-open', open);
          menu.classList.toggle('is-open', open);
        };
        toggle.addEventListener('click', () => {
          setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });
        // Close after picking a destination (nav link or language).
        menu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setOpen(false));
        });
      }

      // Hide the nav on scroll down, reveal it on scroll up (swipe in/out).
      const header = document.querySelector('.site-header');
      if (header) {
        let lastY = window.scrollY;
        let ticking = false;
        const update = () => {
          const y = window.scrollY;
          const delta = y - lastY;
          // Ignore tiny jitters and the rubber-band overscroll at the very top.
          if (Math.abs(delta) > 6) {
            // Keep it shown while the mobile menu is open, and near the top.
            const menuOpen = menu && menu.classList.contains('is-open');
            if (delta > 0 && y > 80 && !menuOpen) {
              header.classList.add('is-hidden');
            } else if (delta < 0) {
              header.classList.remove('is-hidden');
            }
            lastY = y;
          }
          ticking = false;
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              window.requestAnimationFrame(update);
              ticking = true;
            }
          },
          { passive: true }
        );
      }

      // Keep the copyright year current without a rebuild.
      const yearEl = document.querySelector('[data-year]');
      if (yearEl) yearEl.textContent = String(new Date().getFullYear());

      // The footer is position:fixed, so a plain #contact anchor doesn't move.
      // Intercept "let's chat" links (nav + hero photo) and scroll to the
      // bottom of the page, which reveals the footer drawer.
      document.addEventListener('click', (e) => {
        const link = e.target instanceof Element ? e.target.closest('a[href="#contact"]') : null;
        if (!link) return;
        e.preventDefault();
        window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
      });

      // Active nav state: highlight the link for the section currently in view.
      const navLinks = Array.from(document.querySelectorAll('.nav-links a[data-nav-link]'));
      if (navLinks.length) {
        const setActive = (hash) => {
          navLinks.forEach((a) => a.classList.toggle('is-active', a.getAttribute('href') === hash));
        };
        const spied = ['services', 'work', 'about']
          .map((id) => document.getElementById(id))
          .filter(Boolean);
        if (spied.length && 'IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((en) => {
                if (en.isIntersecting) setActive('#' + en.target.id);
              });
            },
            // Effective viewport is a thin band at the vertical centre.
            { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
          );
          spied.forEach((s) => io.observe(s));
        }
        // At the bottom, the revealed footer is the active "section".
        window.addEventListener(
          'scroll',
          () => {
            const atBottom =
              window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
            if (atBottom) setActive('#contact');
          },
          { passive: true }
        );
      }
    </script>

    <style>
      /* Fixed, floating just below the top edge. Slides out of view on scroll
         down and swipes back in on scroll up (see the scroll-direction script). */
      .site-header {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 20;
        padding-top: var(--space-2);
        transition: transform 0.35s var(--ease);
        will-change: transform;
      }
      /* Hidden: lift the whole bar (plus its top padding) above the viewport. */
      .site-header.is-hidden {
        transform: translateY(calc(-100% - var(--space-2)));
      }
      @media (prefers-reduced-motion: reduce) {
        .site-header { transition: none; }
      }

      /* The floating translucent bar (matches the Figma frame). */
      .nav-bar {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        padding: 16px 24px;
        font-family: var(--font-display);
        font-size: 1rem;
        background: rgba(255, 255, 255, 0.7);
        -webkit-backdrop-filter: blur(4.5px);
        backdrop-filter: blur(4.5px);
        box-shadow: 0 4px 16px 0 rgba(222, 220, 218, 0.15);
        border-radius: var(--radius-pill);
      }

      /* "fosset.co" wordmark — light weight, primary color. */
      .wordmark {
        flex-shrink: 0;
        text-decoration: none;
        font-weight: 300;
        line-height: 1;
        color: var(--color-primary);
      }

      /* On desktop the collapse is transparent: its children (links + langs)
         become direct flex items of the bar. */
      .nav-collapse { display: contents; }

      .nav-links {
        flex: 1 0 0;
        display: flex;
        justify-content: center;
        gap: 40px;
        list-style: none;
        color: var(--color-muted-soft);
        font-weight: 300;
      }
      .nav-links a {
        position: relative;
        text-decoration: none;
        color: inherit;
        white-space: nowrap;
        transition: color 0.2s var(--ease);
      }
      /* Underline that wipes in from the left on hover / focus / active. */
      .nav-links a::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.3em;
        height: 1.5px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.25s var(--ease);
      }
      .nav-links a:hover,
      .nav-links a:focus-visible,
      .nav-links a.is-active {
        color: var(--color-primary);
      }
      .nav-links a:hover::after,
      .nav-links a:focus-visible::after,
      .nav-links a.is-active::after {
        transform: scaleX(1);
      }
      /* "let's chat" — the heavier CTA (underline now comes from the wipe). */
      .nav-cta { font-weight: 600; }

      @media (prefers-reduced-motion: reduce) {
        .nav-links a::after { transition: none; }
      }

      /* Hamburger — hidden on desktop. */
      .menu-toggle {
        display: none;
        width: 28px;
        height: 24px;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        padding: 0;
        color: var(--color-text);
      }
      .menu-toggle .bar {
        display: block;
        height: 2px;
        width: 100%;
        background: currentColor;
        transition: transform 0.25s var(--ease), opacity 0.2s var(--ease);
        transform-origin: center;
      }
      .menu-toggle.is-open .bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
      .menu-toggle.is-open .bar:nth-child(2) { opacity: 0; }
      .menu-toggle.is-open .bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

      /* --- Mobile: collapse links + langs into a dropdown --- */
      @media (max-width: 767px) {
        .menu-toggle { display: inline-flex; }
        .nav-collapse {
          display: none;
          position: absolute;
          top: calc(100% + 8px);
          left: 0;
          right: 0;
          flex-direction: column;
          align-items: flex-start;
          gap: var(--space-3);
          padding: var(--space-3);
          background: rgba(255, 255, 255, 0.96);
          -webkit-backdrop-filter: blur(4.5px);
          backdrop-filter: blur(4.5px);
          box-shadow: 0 4px 16px 0 rgba(222, 220, 218, 0.25);
          border-radius: 2px;
        }
        .nav-collapse.is-open { display: flex; }
        .nav-links {
          flex: none;
          flex-direction: column;
          align-items: flex-start;
          gap: var(--space-2);
          justify-content: flex-start;
        }
      }

      /* Fixed-footer reveal. The page content rides ABOVE the footer on its own
         opaque layer (z-index 1 + solid bg), so the footer stays hidden while
         scrolling. main's bottom margin equals the footer height, opening the
         scroll room that uncovers the footer like a drawer at the end. No JS. */
      main {
        position: relative;
        z-index: 1;
        background: var(--color-bg);
        margin-bottom: 100vh;
      }

      /* The merged Contact CTA + footer, pinned behind the page (z-index -1).
         Orange = the existing brand accent, so the drawer matches the other
         orange sections; light text + an inverted (light) pill read well on it. */
      .footer-reveal {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: -1;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--color-purple);
        color: var(--color-ink-on-purple);
        text-align: center;
      }

      .footer-cta {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-block: clamp(3rem, 8vw, 6rem) var(--space-5);
      }
      .footer-cta h2 {
        font-size: var(--fs-hero);
        line-height: 1.02;
        letter-spacing: -0.03em;
        max-width: 22ch;
        margin-inline: auto;
        color: var(--color-ink-on-purple);
      }
      .footer-sub {
        margin: var(--space-3) auto 0;
        max-width: 52ch;
        font-size: 1.125rem;
        line-height: 1.5;
        color: var(--color-muted-on-purple);
      }
      .footer-note {
        margin: var(--space-2) auto 0;
        max-width: 52ch;
        font-size: 1rem;
        line-height: 1.5;
        color: var(--color-muted-on-purple);
      }
      .footer-links {
        display: flex;
        gap: var(--space-3);
        align-items: center;
        justify-content: center;
        margin-top: var(--space-4);
        flex-wrap: wrap;
      }
      .footer-cta-btn {
        background: var(--color-ink-on-purple);
        color: var(--color-purple);
        text-decoration: none;
        padding: 0.8rem 1.6rem;
        border-radius: var(--radius-pill);
        font-weight: 600;
      }
      .footer-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-2) var(--space-3);
        flex-wrap: wrap;
        padding-block: var(--space-4);
        border-top: 1px solid var(--color-line-on-purple);
        font-size: var(--fs-small);
        color: var(--color-muted-on-purple);
      }
      .footer-meta-end {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        flex-wrap: wrap;
      }
      .footer-linkedin {
        color: var(--color-muted-on-purple);
        text-decoration: underline;
        text-underline-position: from-font;
        transition: color 0.2s var(--ease);
      }
      .footer-linkedin:hover { color: var(--color-ink-on-purple); }
    </style>
  </body>
</html>
