---
import '../styles/tokens.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { useTranslations, getLocaleFromUrl } from '../i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const base = import.meta.env.BASE_URL; // includes a trailing slash, e.g. '/flora-website/'
const home = locale === 'en' ? base : `${base}${locale}/`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <nav class="nav-bar" aria-label="Main">
          <a href={home} class="wordmark" aria-label="Flora Fosset — home">fosset.co</a>

          <div class="nav-collapse" id="site-nav" data-nav-menu>
            <ul class="nav-links">
              <li><a href="#work" data-nav-link>{t.nav.work}</a></li>
              <li><a href="#about" data-nav-link>{t.nav.about}</a></li>
              <li><a href="#contact" data-nav-link class="nav-cta">{t.nav.contact}</a></li>
            </ul>
            <LanguageSwitcher currentLocale={locale} />
          </div>

          <button
            type="button"
            class="menu-toggle"
            aria-expanded="false"
            aria-controls="site-nav"
            aria-label="Open menu"
            data-menu-toggle
          >
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>{t.footer.rights}</span>
        <span>{t.footer.location}</span>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('[data-menu-toggle]');
      const menu = document.querySelector('[data-nav-menu]');
      if (toggle && menu) {
        const setOpen = (open) => {
          toggle.setAttribute('aria-expanded', String(open));
          toggle.classList.toggle('is-open', open);
          menu.classList.toggle('is-open', open);
        };
        toggle.addEventListener('click', () => {
          setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });
        // Close after picking a destination (nav link or language).
        menu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setOpen(false));
        });
      }
    </script>

    <style>
      /* Fixed, floating just below the top edge. */
      .site-header {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 20;
        padding-top: var(--space-2);
      }

      /* The floating translucent bar (matches the Figma frame). */
      .nav-bar {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        padding: 16px 24px;
        font-family: var(--font-display);
        font-size: 1rem;
        background: rgba(255, 255, 255, 0.8);
        -webkit-backdrop-filter: blur(4.5px);
        backdrop-filter: blur(4.5px);
        box-shadow: 0 4px 16px 0 rgba(222, 220, 218, 0.15);
        border-radius: 2px;
      }

      /* "fosset.co" wordmark — light weight, primary color. */
      .wordmark {
        flex-shrink: 0;
        text-decoration: none;
        font-weight: 300;
        line-height: 1;
        color: var(--color-primary);
      }

      /* On desktop the collapse is transparent: its children (links + langs)
         become direct flex items of the bar. */
      .nav-collapse { display: contents; }

      .nav-links {
        flex: 1 0 0;
        display: flex;
        justify-content: center;
        gap: 40px;
        list-style: none;
        color: var(--color-muted-soft);
        font-weight: 300;
      }
      .nav-links a {
        text-decoration: none;
        color: inherit;
        white-space: nowrap;
        transition: color 0.2s var(--ease);
      }
      .nav-links a:hover { color: var(--color-primary); }
      /* "let's chat" — the underlined, heavier CTA. */
      .nav-cta {
        font-weight: 600;
        text-decoration: underline;
        text-underline-position: from-font;
      }

      /* Hamburger — hidden on desktop. */
      .menu-toggle {
        display: none;
        width: 28px;
        height: 24px;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        padding: 0;
        color: var(--color-text);
      }
      .menu-toggle .bar {
        display: block;
        height: 2px;
        width: 100%;
        background: currentColor;
        transition: transform 0.25s var(--ease), opacity 0.2s var(--ease);
        transform-origin: center;
      }
      .menu-toggle.is-open .bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
      .menu-toggle.is-open .bar:nth-child(2) { opacity: 0; }
      .menu-toggle.is-open .bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

      /* --- Mobile: collapse links + langs into a dropdown --- */
      @media (max-width: 767px) {
        .menu-toggle { display: inline-flex; }
        .nav-collapse {
          display: none;
          position: absolute;
          top: calc(100% + 8px);
          left: 0;
          right: 0;
          flex-direction: column;
          align-items: flex-start;
          gap: var(--space-3);
          padding: var(--space-3);
          background: rgba(255, 255, 255, 0.96);
          -webkit-backdrop-filter: blur(4.5px);
          backdrop-filter: blur(4.5px);
          box-shadow: 0 4px 16px 0 rgba(222, 220, 218, 0.25);
          border-radius: 2px;
        }
        .nav-collapse.is-open { display: flex; }
        .nav-links {
          flex: none;
          flex-direction: column;
          align-items: flex-start;
          gap: var(--space-2);
          justify-content: flex-start;
        }
      }

      .site-footer {
        border-top: 1px solid var(--color-line);
        padding-block: var(--space-4);
      }
      .footer-inner {
        display: flex;
        justify-content: space-between;
        font-size: var(--fs-small);
        color: var(--color-muted);
      }
    </style>
  </body>
</html>
