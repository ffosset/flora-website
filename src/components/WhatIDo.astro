---
const { t } = Astro.props;
---
<section id="what" class="what-statement">
  <div class="container">
    <h2 class="statement">{t.whatIDo.statement}</h2>
    <p class="statement-sub">
      <span class="slash-on-purple">·</span>{t.whatIDo.statementSub}
    </p>
  </div>
</section>

<style>
  .what-statement {
    background: var(--color-purple);
    color: var(--color-ink-on-purple);
    padding-block: clamp(6rem, 14vw, 11rem);
    text-align: center;
  }
  .statement {
    font-size: var(--fs-hero);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.03em;
    max-width: 20ch;
    margin-inline: auto;
    color: var(--color-ink-on-purple);
  }
  .statement-sub {
    margin-top: var(--space-3);
    margin-inline: auto;
    font-size: clamp(1.125rem, 1.5vw, 1.375rem);
    line-height: 1.4;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-muted-on-purple);
    max-width: 44ch;
  }
  .slash-on-purple {
    color: rgba(255, 255, 255, 0.75);
    font-weight: 700;
    margin-right: 0.05em;
  }
</style>
