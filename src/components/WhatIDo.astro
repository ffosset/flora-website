---
const { t } = Astro.props;
---
<section id="what" class="what-statement">
  <div class="container">
    <h2 class="statement">{t.whatIDo.statement}</h2>
    <p class="statement-sub">
      <span class="slash-on-purple">·</span>{t.whatIDo.statementSub}
    </p>
    <div class="problems">
      {t.whatIDo.problems.map((p) => (
        <div class="problem">
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .what-statement {
    background: var(--color-purple);
    color: var(--color-ink-on-purple);
    padding-block: clamp(6rem, 14vw, 11rem);
  }
  .statement {
    font-size: var(--fs-hero);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.03em;
    max-width: 18ch;
    color: var(--color-ink-on-purple);
  }
  .statement-sub {
    margin-top: var(--space-3);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-muted-on-purple);
    max-width: 26ch;
  }
  .slash-on-purple {
    color: rgba(255, 255, 255, 0.75);
    font-weight: 700;
    margin-right: 0.05em;
  }

  /* Three columns sit under the title/subtitle, on the orange ground. */
  .problems {
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 768px) {
    .problems { grid-template-columns: repeat(3, 1fr); }
  }
  .problem h3 {
    font-size: 1.375rem;
    line-height: 1.2;
    margin-bottom: var(--space-2);
    letter-spacing: -0.01em;
    color: var(--color-ink-on-purple);
  }
  .problem p { color: var(--color-muted-on-purple); }
</style>
