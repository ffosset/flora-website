---
const { t } = Astro.props;
const deliverables = t.whatIDo.deliverables || [];
---

<section id="what" class="what-statement" data-deliverables>
  <div class="statement-text">
    <p class="statement-sub">{t.whatIDo.statementSub}</p>
  </div>

  <ul class="deliverables" aria-label="What I deliver">
    {deliverables.map((label) => <li class="del">{label}</li>)}
  </ul>

  <button type="button" class="scroll-btn" data-scroll-next aria-label={t.hero.scroll}>
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 4v15M5 13l7 7 7-7" stroke="currentColor" stroke-width="1.6"
        stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</section>

<script>
  const sect = document.querySelector('[data-deliverables]');
  if (sect) {
    const btn = sect.querySelector('[data-scroll-next]');
    if (btn) {
      btn.addEventListener('click', () => {
        const next = sect.nextElementSibling;
        if (next) {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          next.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        }
      });
    }

    // Glass circles drift horizontally in a loop; the mouse adds a little
    // depth-based parallax. Skipped on mobile / reduced-motion (static list).
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mobile = window.matchMedia('(max-width: 767px)').matches;
    const els = Array.from(sect.querySelectorAll('.del'));
    if (!reduce && !mobile && els.length) {
      // Per-gap factors (×diameter): <1 overlaps the previous, >1 leaves a gap.
      const factors = [1.5, 0.85, 1.5, 1.5, 0.85, 1.5, 1.5];
      const items = els.map((el, i) => ({ el, d: 0, base: 0, y: 0, depth: 0.55 + (i % 3) * 0.3, hf: 0 }));
      const list = sect.querySelector('.deliverables');
      let H = 0, total = 0, offset = 0, drift = 0, raf = 0;
      let tpx = 0, tpy = 0, cpx = 0, cpy = 0;
      let hovered = null; // the single bubble currently under the pointer

      const measure = () => {
        // Band is measured within the bubble region (not the whole section),
        // so the circles stay in their bottom half and never reach the text.
        H = list.getBoundingClientRect().height;
        let x = 0;
        items.forEach((it, i) => {
          it.d = it.el.getBoundingClientRect().width;
          it.base = x;
          x += it.d * factors[i % factors.length];
        });
        total = x;
        offset = items[0].d + 60;
        const bandY = H * 0.5;
        items.forEach((it) => { it.y = bandY - it.d / 2; });
      };
      const step = () => {
        drift -= 0.4;
        cpx += (tpx - cpx) * 0.06;
        cpy += (tpy - cpy) * 0.06;
        items.forEach((it) => {
          const x = (((it.base + drift) % total) + total) % total - offset;
          // Parallax only on the hovered bubble; `hf` eases it in/out so the
          // lift is smooth rather than a jump when the pointer enters/leaves.
          const target = it === hovered ? 1 : 0;
          it.hf += (target - it.hf) * 0.12;
          const px = cpx * it.depth * 44 * it.hf;
          const py = cpy * it.depth * 28 * it.hf;
          it.el.style.transform = `translate(${(x + px).toFixed(1)}px, ${(it.y + py).toFixed(1)}px)`;
        });
        raf = requestAnimationFrame(step);
      };

      const onMove = (e) => {
        const b = sect.getBoundingClientRect();
        tpx = (e.clientX - b.left) / b.width - 0.5;
        tpy = (e.clientY - b.top) / b.height - 0.5;
      };
      const onLeave = () => { tpx = 0; tpy = 0; hovered = null; };

      let begun = false;
      const begin = () => {
        if (begun) return;
        begun = true;
        measure();
        sect.classList.add('is-floating');
        sect.addEventListener('mousemove', onMove);
        sect.addEventListener('mouseleave', onLeave);
        // Track which single bubble the pointer is over.
        items.forEach((it) => {
          it.el.addEventListener('mouseenter', () => { hovered = it; });
          it.el.addEventListener('mouseleave', () => { if (hovered === it) hovered = null; });
        });
        raf = requestAnimationFrame(step);
      };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { begin(); io.disconnect(); } }),
          { threshold: 0.25 }
        );
        io.observe(sect);
      } else {
        begin();
      }
      window.addEventListener('resize', () => { if (begun) measure(); });
    }
  }
</script>

<style>
  .what-statement {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    background: var(--color-purple);
    color: var(--color-ink-on-purple);
    padding: var(--space-5) var(--gutter);
  }

  /* Top half: the statement, centred in its own band so it never collides
     with the bubbles below. */
  .statement-text {
    flex: 0 0 50%;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Bottom half: glass circles drifting across a horizontal band — their own
     region, no longer overlapping the text. */
  .deliverables {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }
  .del {
    position: absolute;
    left: 0;
    top: 0;
    width: clamp(140px, 16vw, 230px);
    height: clamp(140px, 16vw, 230px);
    border-radius: 50%;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 1rem;
    /* subtle glass */
    background: rgba(255, 255, 255, 0.07);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #ffffff;
    font-family: var(--font-display); /* Inter for the labels */
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: clamp(0.8rem, 0.7rem + 0.4vw, 1rem);
    opacity: 0;
    transition: opacity 0.8s ease, background 0.3s ease, border-color 0.3s ease;
    will-change: transform;
  }
  .is-floating .del { opacity: 1; }
  /* Each bubble is individually hoverable so only it gets the parallax lift. */
  .is-floating .del { pointer-events: auto; cursor: default; }
  .is-floating .del:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .statement-sub {
    position: relative;
    z-index: 1;
    max-width: 42ch; /* wider text block */
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.25rem);
    line-height: 1.3;
    font-weight: 500;
    color: var(--color-ink-on-purple);
  }

  /* White scroll arrow — bottom-right, matching the hero. */
  .scroll-btn {
    position: absolute;
    right: var(--gutter);
    bottom: var(--space-5);
    z-index: 3;
    padding: 0;
    border: 0;
    background: transparent;
    color: #ffffff;
    display: grid;
    place-items: center;
    transition: transform 0.25s var(--ease);
  }
  .scroll-btn svg {
    width: 28px;
    height: 28px;
    display: block;
    animation: scroll-nudge 1.8s var(--ease) infinite;
  }
  .scroll-btn:hover,
  .scroll-btn:focus-visible { transform: translateY(3px); }
  @keyframes scroll-nudge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-btn svg { animation: none; }
  }

  /* Mobile or reduced-motion: no drift — show the labels as a static list. */
  @media (max-width: 767px), (prefers-reduced-motion: reduce) {
    .what-statement { justify-content: center; }
    /* Drop the wrapper from layout so the text flows normally above the list. */
    .statement-text { display: contents; }
    .deliverables {
      position: static;
      top: auto;
      inset: auto;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.6rem;
      margin-top: var(--space-4);
    }
    .del {
      position: static;
      transform: none;
      opacity: 1;
      width: auto;
      height: auto;
      padding: 0.55rem 1.15rem;
      border-radius: var(--radius-pill);
      display: inline-flex;
    }
  }
</style>
