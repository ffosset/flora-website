---
const { t } = Astro.props;

const deliverables = t.whatIDo.deliverables || [];
const N = deliverables.length || 1;

// Place the deliverables evenly on an ellipse around the statement, starting
// at the top and going clockwise — a calm, intentional ring rather than a
// random scatter. They light up in this same order.
const cxp = 50;
const cyp = 47;
const rx = 37;
const ry = 31;
const items = deliverables.map((label, i) => {
  const a = (-90 + (i * 360) / N) * (Math.PI / 180);
  return {
    label,
    left: (cxp + rx * Math.cos(a)).toFixed(1) + '%',
    top: (cyp + ry * Math.sin(a)).toFixed(1) + '%',
    delay: (i * 0.5).toFixed(2) + 's',
  };
});
---

<section id="what" class="what-statement" data-deliverables>
  <ul class="deliverables" aria-label="What I deliver">
    {items.map((it) => (
      <li class="del" style={`--top:${it.top}; --left:${it.left}; --d:${it.delay}`}>{it.label}</li>
    ))}
  </ul>

  <p class="statement-sub">{t.whatIDo.statementSub}</p>

  <button type="button" class="scroll-btn" data-scroll-next aria-label={t.hero.scroll}>
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 4v15M5 13l7 7 7-7" stroke="currentColor" stroke-width="1.6"
        stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</section>

<script>
  const sect = document.querySelector('[data-deliverables]');
  if (sect) {
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { sect.classList.add('is-drawing'); io.disconnect(); }
          });
        },
        { threshold: 0.35 }
      );
      io.observe(sect);
    } else {
      sect.classList.add('is-drawing');
    }

    const btn = sect.querySelector('[data-scroll-next]');
    if (btn) {
      btn.addEventListener('click', () => {
        const next = sect.nextElementSibling;
        if (next) {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          next.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        }
      });
    }
  }
</script>

<style>
  .what-statement {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: var(--color-purple);
    color: var(--color-ink-on-purple);
    padding: var(--space-5) var(--gutter);
  }

  .deliverables {
    position: absolute;
    inset: 0;
    z-index: 1;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }
  .del {
    position: absolute;
    top: var(--top);
    left: var(--left);
    translate: -50% -50%; /* centring kept off `transform` so the bloom can use scale */
    font-family: var(--font-display); /* Inter */
    font-weight: 400; /* regular */
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: clamp(0.85rem, 0.7rem + 0.55vw, 1.2rem); /* smaller than the subtitle */
    white-space: nowrap;
    color: #ffffff;
    opacity: 0;
  }
  /* Each lights up in turn: blur-in, a glow that flares then settles to a soft aura. */
  .is-drawing .del {
    animation: del-bloom 1s var(--ease) var(--d) both;
  }
  @keyframes del-bloom {
    0% {
      opacity: 0;
      scale: 0.9;
      filter: blur(5px);
      text-shadow: 0 0 0 rgba(255, 255, 255, 0);
    }
    55% {
      opacity: 1;
      text-shadow: 0 0 34px rgba(255, 255, 255, 0.7), 0 0 8px rgba(255, 255, 255, 0.5);
    }
    100% {
      opacity: 1;
      scale: 1;
      filter: blur(0);
      text-shadow: 0 0 22px rgba(255, 255, 255, 0.3), 0 0 60px rgba(255, 255, 255, 0.14);
    }
  }

  .statement-sub {
    position: relative;
    z-index: 2;
    max-width: 22ch;
    font-size: clamp(1.375rem, 1rem + 1.5vw, 2rem);
    line-height: 1.3;
    font-weight: 500;
    color: var(--color-ink-on-purple);
  }

  /* White scroll arrow — bottom-right, matching the hero. */
  .scroll-btn {
    position: absolute;
    right: var(--gutter);
    bottom: var(--space-5);
    z-index: 3;
    padding: 0;
    border: 0;
    background: transparent;
    color: #ffffff;
    display: grid;
    place-items: center;
    transition: transform 0.25s var(--ease);
  }
  .scroll-btn svg {
    width: 28px;
    height: 28px;
    display: block;
    animation: scroll-nudge 1.8s var(--ease) infinite;
  }
  .scroll-btn:hover,
  .scroll-btn:focus-visible { transform: translateY(3px); }
  @keyframes scroll-nudge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-drawing .del {
      animation: none;
      opacity: 1;
      filter: none;
      text-shadow: 0 0 22px rgba(255, 255, 255, 0.3);
    }
    .scroll-btn svg { animation: none; }
  }

  /* Mobile: a tidy wrapped list under the subtitle; still lights up in turn. */
  @media (max-width: 767px) {
    .deliverables {
      position: static;
      inset: auto;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem 1.25rem;
      margin-top: var(--space-4);
      z-index: 2;
    }
    .del {
      position: static;
      translate: none;
    }
  }
</style>
