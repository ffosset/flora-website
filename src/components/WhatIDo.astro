---
const { t } = Astro.props;
---
<section id="what" class="what-statement" data-header-tint="purple">
  <div class="container">
    <h2 class="statement">{t.whatIDo.statement}</h2>
    <p class="statement-sub">
      <span class="slash-on-purple">/</span>{t.whatIDo.statementSub}
    </p>
  </div>
</section>

<section id="how" class="what-problems">
  <div class="container">
    <div class="problems">
      {t.whatIDo.problems.map((p) => (
        <div class="problem">
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </div>
      ))}
    </div>
    <div class="how">
      <h3><span class="slash">/</span>{t.whatIDo.howIWorkTitle.toLowerCase()}.</h3>
      <p>{t.whatIDo.howIWorkBody}</p>
    </div>
  </div>
</section>

<style>
  .what-statement {
    background: var(--color-purple);
    color: var(--color-ink-on-purple);
    padding-block: clamp(6rem, 14vw, 11rem);
  }
  .statement {
    font-size: var(--fs-hero);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.03em;
    max-width: 18ch;
    color: var(--color-ink-on-purple);
  }
  .statement-sub {
    margin-top: var(--space-3);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-muted-on-purple);
    max-width: 26ch;
  }
  .slash-on-purple {
    color: rgba(255, 255, 255, 0.75);
    font-weight: 700;
    margin-right: 0.05em;
  }

  .what-problems { background: var(--color-bg); padding-block: var(--space-6); }
  .problems { display: grid; gap: var(--space-3); }
  @media (min-width: 768px) {
    .problems { grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  }
  .problem h3 {
    font-size: 1.375rem;
    line-height: 1.2;
    margin-bottom: var(--space-2);
    letter-spacing: -0.01em;
  }
  .problem p { color: var(--color-muted); }
  .how {
    margin-top: var(--space-5);
    max-width: 70ch;
    border-top: 1px solid var(--color-line);
    padding-top: var(--space-4);
  }
  .how h3 { font-size: 1.5rem; letter-spacing: -0.01em; }
  .how p { color: var(--color-muted); margin-top: var(--space-2); }
</style>
