---
const { t } = Astro.props;

// Scatter positions around the central statement (desktop). The i-th
// deliverable lights up at i * 0.5s, in array order.
const positions = [
  { top: '16%', left: '30%' },
  { top: '14%', left: '68%' },
  { top: '36%', left: '14%' },
  { top: '34%', left: '86%' },
  { top: '64%', left: '22%' },
  { top: '62%', left: '78%' },
  { top: '78%', left: '48%' },
];
const deliverables = (t.whatIDo.deliverables || []).slice(0, positions.length);
---

<section id="what" class="what-statement" data-deliverables>
  <ul class="deliverables" aria-label="What I deliver">
    {deliverables.map((label, i) => (
      <li
        class="del"
        style={`--top:${positions[i].top}; --left:${positions[i].left}; --d:${(i * 0.5).toFixed(1)}s`}
      >
        {label}
      </li>
    ))}
  </ul>

  <p class="statement-sub">{t.whatIDo.statementSub}</p>

  <button type="button" class="scroll-btn" data-scroll-next aria-label={t.hero.scroll}>
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 4v15M5 13l7 7 7-7" stroke="currentColor" stroke-width="1.6"
        stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</section>

<script>
  // Begin the sequence once the section scrolls into view (once).
  const sect = document.querySelector('[data-deliverables]');
  if (sect) {
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { sect.classList.add('is-drawing'); io.disconnect(); }
          });
        },
        { threshold: 0.35 }
      );
      io.observe(sect);
    } else {
      sect.classList.add('is-drawing');
    }

    // White scroll arrow → next section (Projects).
    const btn = sect.querySelector('[data-scroll-next]');
    if (btn) {
      btn.addEventListener('click', () => {
        const next = sect.nextElementSibling;
        if (next) {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          next.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        }
      });
    }
  }
</script>

<style>
  .what-statement {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: var(--color-purple);
    color: var(--color-ink-on-purple);
    padding: var(--space-5) var(--gutter);
  }

  /* Deliverables scattered around the statement. */
  .deliverables {
    position: absolute;
    inset: 0;
    z-index: 1;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }
  .del {
    position: absolute;
    top: var(--top);
    left: var(--left);
    transform: translate(-50%, -50%) scale(0.96);
    font-family: var(--font-display); /* Inter */
    font-weight: 400; /* regular */
    text-transform: uppercase;
    letter-spacing: 0.08em;
    /* a little smaller than the subtitle */
    font-size: clamp(0.9rem, 0.7rem + 0.6vw, 1.25rem);
    white-space: nowrap;
    color: #ffffff;
    /* soft white aura, lots of transparency */
    text-shadow: 0 0 22px rgba(255, 255, 255, 0.4), 0 0 60px rgba(255, 255, 255, 0.18);
    opacity: 0;
    transition: opacity 0.6s ease var(--d), transform 0.6s var(--ease) var(--d);
  }
  /* Light up one after another (delay carried per element via --d). */
  .is-drawing .del {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .statement-sub {
    position: relative;
    z-index: 2;
    max-width: 22ch;
    font-size: clamp(1.375rem, 1rem + 1.5vw, 2rem);
    line-height: 1.3;
    font-weight: 500;
    color: var(--color-ink-on-purple);
  }

  /* White scroll arrow (hero style), centred at the bottom. */
  .scroll-btn {
    position: absolute;
    left: 50%;
    bottom: var(--space-5);
    transform: translateX(-50%);
    z-index: 3;
    padding: 0;
    border: 0;
    background: transparent;
    color: #ffffff;
    display: grid;
    place-items: center;
    transition: transform 0.25s var(--ease);
  }
  .scroll-btn svg {
    width: 28px;
    height: 28px;
    display: block;
    animation: scroll-nudge 1.8s var(--ease) infinite;
  }
  .scroll-btn:hover,
  .scroll-btn:focus-visible { transform: translateX(-50%) translateY(3px); }
  @keyframes scroll-nudge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .del { opacity: 1; transform: translate(-50%, -50%); transition: none; }
    .scroll-btn svg { animation: none; }
  }

  /* Mobile: stack the deliverables in a tidy wrapped list under the subtitle;
     they still light up in sequence. */
  @media (max-width: 767px) {
    .deliverables {
      position: static;
      inset: auto;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem 1rem;
      margin-top: var(--space-4);
      z-index: 2;
    }
    .del {
      position: static;
      transform: scale(0.96);
    }
    .is-drawing .del { transform: scale(1); }
    @media (prefers-reduced-motion: reduce) {
      .del { transform: none; }
    }
  }
</style>
