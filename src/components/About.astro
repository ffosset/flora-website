---
import { Image } from 'astro:assets';
import portrait from '../assets/flora-about.png';
const { t } = Astro.props;
const facts = t.about.facts || [];
const path = t.about.path || [];
---

<section id="about" class="about">
  <div class="container">
    <header class="about-head">
      <p class="about-eyebrow"><span class="slash">·</span>{t.about.sectionTitle}</p>
      <h2 class="about-title">{t.about.headline}</h2>
    </header>

    <div class="about-grid">
      <div class="about-media">
        <Image
          class="about-portrait"
          src={portrait}
          alt="Flora Fosset"
          width={640}
          format="webp"
          loading="lazy"
        />
      </div>

      <div class="about-right">
        <ul class="about-facts">
          {facts.map((f) => (
            <li><span class="slash" aria-hidden="true">·</span>{f}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="about-path" data-path>
      <h2 class="about-subhead"><span class="slash">·</span>{t.about.pathTitle}</h2>
      <ol class="path">
        {path.map((p, i) => (
          <li class:list={['path-step', { 'is-current': p.current }]} style={`--i:${i}`}>
            <span class="path-dot" aria-hidden="true"></span>
            <span class="path-label">{p.label}</span>
            <span class="path-year">{p.year}</span>
            {p.sub && <p class="path-sub">{p.sub}</p>}
          </li>
        ))}
      </ol>
    </div>

    <div class="about-blocks">
      <div class="about-block">
        <h3><span class="slash">·</span>{t.about.howIWorkTitle}</h3>
        <p>{t.about.howIWorkBody}</p>
      </div>
      <div class="about-block">
        <h3><span class="slash">·</span>{t.about.valuesTitle}</h3>
        <p>{t.about.values}</p>
      </div>
    </div>
  </div>
</section>

<script>
  // Reveal the timeline (line draws + steps appear one after another) the first
  // time it scrolls into view.
  const path = document.querySelector('[data-path]');
  if (path) {
    const reveal = () => path.classList.add('is-revealed');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) { reveal(); io.disconnect(); } }),
        { threshold: 0.4 }
      );
      io.observe(path);
    } else {
      reveal();
    }
  }
</script>

<style>
  .about { background: var(--color-section-bg); }

  /* Centred header: small orange eyebrow over a large bold statement
     (same pattern as the services and projects sections). */
  .about-head {
    text-align: center;
    max-width: 56rem;
    margin: 0 auto var(--space-5);
  }
  .about-eyebrow {
    font-family: var(--font-body);
    font-size: var(--fs-small);
    letter-spacing: 0.04em;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }
  .about-eyebrow .slash { color: var(--color-primary); margin-right: 0.4em; }
  .about-title {
    font-size: var(--fs-section);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  /* Sub-heading used by the timeline ("· my path") — keeps the older
     left-aligned heading style. */
  .about-subhead {
    font-size: var(--fs-section);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .about-grid {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 900px) {
    /* align-items: center vertically centres the headline + facts against the
       (taller) portrait. */
    .about-grid { grid-template-columns: 1fr 1.6fr; gap: var(--space-5); align-items: center; }
  }

  .about-portrait {
    display: block;
    width: 100%;
    max-width: 26rem;
    height: auto;
  }
  /* Mobile: centre the portrait above the text. */
  @media (max-width: 899px) {
    .about-media { display: flex; justify-content: center; }
    .about-portrait { max-width: 20rem; }
  }

  /* Quick facts: a small orange dot before each line. */
  .about-facts {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .about-facts li {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.3rem);
    line-height: 1.3;
    color: var(--color-text);
  }
  .about-facts .slash { color: var(--color-primary); margin-right: 0.5em; font-weight: 700; }

  /* "how I work" / "value driven" — two cards below the timeline. */
  .about-blocks {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  @media (min-width: 760px) {
    .about-blocks { grid-template-columns: 1fr 1fr; }
  }
  .about-block {
    background: #faf0ea;
    border-radius: 18px;
    padding: var(--space-4) var(--space-5);
    text-align: center;
  }
  .about-block h3 {
    font-size: 1.375rem;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-2);
  }
  .about-block p { color: var(--color-muted); }

  /* --- Timeline --- */
  .about-path { margin-top: var(--space-6); }
  .path {
    list-style: none;
    position: relative;
    margin-top: var(--space-5);
  }

  .path-step {
    /* hidden until revealed */
    opacity: 0;
    transform: translateY(10px);
  }
  .about-path.is-revealed .path-step {
    animation: step-in 0.5s var(--ease) forwards;
    animation-delay: calc(0.3s + var(--i) * 0.18s);
  }
  @keyframes step-in { to { opacity: 1; transform: translateY(0); } }

  .path-dot {
    position: relative;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-primary);
    flex: none;
  }
  .path-step.is-current .path-dot {
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-primary) 22%, transparent);
  }
  /* The latest step pulses with an expanding ring. */
  .path-step.is-current .path-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-primary);
    z-index: -1;
    animation: dot-pulse 2s ease-out infinite;
  }
  @keyframes dot-pulse {
    0% { transform: scale(1); opacity: 0.55; }
    100% { transform: scale(2.8); opacity: 0; }
  }
  .path-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.95rem, 0.85rem + 0.35vw, 1.15rem);
    line-height: 1.2;
    color: var(--color-text);
  }
  .path-year {
    font-size: clamp(0.72rem, 0.66rem + 0.2vw, 0.8125rem);
    color: var(--color-primary);
    letter-spacing: 0.02em;
  }
  .path-sub {
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--color-muted);
  }

  /* Mobile (default): vertical stack with a connecting line down the left. */
  .path { display: flex; flex-direction: column; gap: var(--space-4); }
  .path::before {
    content: '';
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 5px;
    width: 1.5px;
    background: var(--color-line);
    transform: scaleY(0);
    transform-origin: top;
  }
  .about-path.is-revealed .path::before {
    animation: line-grow-y 1s var(--ease) forwards;
  }
  @keyframes line-grow-y { to { transform: scaleY(1); } }
  .path-step {
    display: grid;
    grid-template-columns: 12px 1fr;
    column-gap: var(--space-3);
    align-items: baseline;
  }
  .path-step .path-dot { grid-row: 1; align-self: center; }
  .path-step .path-label { grid-column: 2; }
  .path-step .path-year { grid-column: 2; }
  .path-step .path-sub { grid-column: 2; margin-top: 0.35rem; }

  /* Desktop: horizontal timeline, four columns, line drawn left-to-right. */
  @media (min-width: 760px) {
    .path {
      flex-direction: row;
      align-items: flex-start;
      gap: 0;
      padding-top: 0.75rem;
    }
    .path::before {
      top: calc(0.75rem + 6px);
      bottom: auto;
      left: 0;
      right: 0;
      width: auto;
      height: 1.5px;
      transform: scaleX(0);
      transform-origin: left;
    }
    .about-path.is-revealed .path::before {
      animation: line-grow-x 1s var(--ease) forwards;
    }
    .path-step {
      flex: 1 1 0;
      min-width: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.4rem;
      padding: 0 var(--space-2);
    }
    .path-step .path-sub { margin-top: 0.25rem; }
  }
  @keyframes line-grow-x { to { transform: scaleX(1); } }

  @media (prefers-reduced-motion: reduce) {
    .path::before { transform: none; animation: none; }
    .path-step { opacity: 1; transform: none; animation: none; }
    .path-step.is-current .path-dot::after { animation: none; opacity: 0; }
  }
</style>

<noscript>
  <style>
    .path::before { transform: none !important; }
    .path-step { opacity: 1 !important; transform: none !important; }
  </style>
</noscript>
