---
import { Image } from 'astro:assets';
import portrait from '../assets/flora-house.png';
const { t } = Astro.props;
const blocks = t.about.blocks || [];
const path = t.about.path || [];
const tags = t.about.tags || {};

// Answer markers for the "find the 3 cats" game. A ring pops in over each cat
// 5s after the photo scrolls into view (see the <script>). Coordinates are
// percentages of the displayed photo box, centered *on* each cat. Verified
// against the full-resolution photo.
const CAT_MARKERS = [
  { key: 'cat1', x: 53, y: 54 }, // cat on the spiral staircase
  { key: 'cat2', x: 56, y: 15 }, // white cat, left of the window
  { key: 'cat3', x: 73, y: 15 }, // tabby cat, right of the window
];

// Desktop "vertical wave" geometry (px, in a 660×760 box). Each milestone sits
// at a wave extreme, alternating right/left; the SVG path snakes between them.
// Mobile ignores this and falls back to a straight vertical rail (see styles).
const WAVE = {
  w: 700,
  h: 1140,
  nodes: [
    { x: 420, y: 140, side: 'right' },
    { x: 280, y: 340, side: 'left' },
    { x: 420, y: 540, side: 'right' },
    { x: 280, y: 740, side: 'left' },
    { x: 420, y: 940, side: 'right' },
  ],
  d: 'M350,12 C350,72 420,80 420,140 C420,240 280,240 280,340 C280,440 420,440 420,540 C420,640 280,640 280,740 C280,840 420,840 420,940',
};
---

<section id="about" class="about">
  <div class="container">
    <header class="about-head">
      <p class="about-eyebrow"><span class="slash">·</span>{t.about.sectionTitle}</p>
      <h2 class="about-title" set:html={t.about.headline}></h2>
    </header>

    <div class="about-grid">
      <figure class="about-media">
        <div class="about-photo" data-tags>
          <Image
            class="about-portrait"
            src={portrait}
            alt="Flora seated in the garden of her brick townhouse"
            width={640}
            format="webp"
            loading="lazy"
          />

          {/* Answer markers: a ring pops in over each cat 5s after the photo
              scrolls into view (the reveal is driven by the <script> below). */}
          {CAT_MARKERS.map((cat, i) => (
            <span
              class="cat-marker"
              aria-hidden="true"
              style={`left:${cat.x}%; top:${cat.y}%; --d:${(i * 0.18).toFixed(2)}s`}
            ></span>
          ))}
        </div>

        {/* "find the 3 cats" prompt, shown under the photo on every viewport. */}
        <p class="tag-cast">{tags.cast}</p>
        {/* Always present for screen readers; visually hidden. */}
        <figcaption class="tag-caption">{t.about.photoCaption}</figcaption>
      </figure>

      <div class="about-right">
        {blocks.map((b) => (
          <div class="about-block">
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="about-path" data-path>
    <div class="container">
      <p class="about-subhead"><span class="slash">·</span>{t.about.pathTitle}</p>
      <h2 class="about-subhead-title">{t.about.pathHeadline}</h2>
      <div class="path-track">
        <svg class="path-wave" width={WAVE.w} height={WAVE.h} viewBox={`0 0 ${WAVE.w} ${WAVE.h}`} aria-hidden="true">
          <path d={WAVE.d} />
          <circle class="path-runner" r="7" cx="350" cy="12" />
        </svg>
        <ol class="path">
          {path.map((p, i) => {
            const n = WAVE.nodes[i] || {};
            return (
              <li
                class:list={['path-step', `is-${n.side ?? 'right'}`, { 'is-current': p.current }]}
                style={`--i:${i}; --wx:${n.x ?? 0}px; --wy:${n.y ?? 0}px`}
                data-wx={n.x}
                data-wy={n.y}
              >
                <span class="path-dot" aria-hidden="true"></span>
                <div class="path-content">
                  <span class="path-year">{p.year}</span>
                  <span class="path-label">{p.label}</span>
                  {p.sub && <p class="path-sub" set:html={p.sub} />}
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  // Reveal the timeline the first time it scrolls into view.
  //  - Mobile (<760px): a straight vertical rail grows and the steps fade in
  //    one after another, driven entirely by CSS (the `is-revealed` class).
  //  - Desktop (≥760px): the SVG "wave" path is drawn top-to-bottom and each
  //    milestone fades in exactly as the line reaches it. We find the arc-length
  //    position of every node so the reveals stay locked to the line at any size.
  const root = document.querySelector('[data-path]');
  if (root) {
    const desktop = window.matchMedia('(min-width: 760px)');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const steps = Array.from(root.querySelectorAll('.path-step'));
    const wave = root.querySelector('.path-wave path');

    const runner = root.querySelector('.path-runner');

    const showAll = () => {
      root.classList.add('is-revealed');
      steps.forEach((s) => s.classList.add('is-shown'));
      if (wave) wave.style.strokeDashoffset = '0';
    };

    // A single orange dot travels down the wave at a constant speed, drawing
    // the line behind it and never stopping. As it passes each milestone the
    // text fades in and a permanent dot is dropped beside the date; those stay
    // put while the runner carries on to the end.
    const animateWave = () => {
      if (!wave || !runner) { root.classList.add('is-revealed'); return; }
      const len = wave.getTotalLength();

      // Arc-length position of every milestone, ordered top-to-bottom.
      const stops = steps.map((s) => {
        const nx = Number(s.dataset.wx);
        const ny = Number(s.dataset.wy);
        let best = 0, bd = Infinity;
        for (let l = 0; l <= len; l += 2) {
          const pt = wave.getPointAtLength(l);
          const d = (pt.x - nx) ** 2 + (pt.y - ny) ** 2;
          if (d < bd) { bd = d; best = l; }
        }
        return { step: s, at: best };
      }).sort((a, b) => a.at - b.at);

      const SPEED = 312;   // px / second the dot travels

      // The line reveals only as far as the dot has reached.
      wave.style.transition = 'none';
      wave.style.strokeDasharray = String(len);
      wave.style.strokeDashoffset = String(len);
      runner.style.opacity = '1';

      const place = (l) => {
        const pt = wave.getPointAtLength(l);
        runner.setAttribute('cx', pt.x);
        runner.setAttribute('cy', pt.y);
        wave.style.strokeDashoffset = String(len - l);
      };

      let startTs = null;
      let idx = 0; // next milestone still waiting to be revealed

      const tick = (ts) => {
        if (startTs === null) startTs = ts;
        const l = Math.min(((ts - startTs) / 1000) * SPEED, len);
        place(l);

        // Reveal each milestone the moment the dot reaches its position; the
        // dropped dot + text then stay fixed as the runner moves on.
        while (idx < stops.length && l >= stops[idx].at) {
          stops[idx].step.classList.add('is-shown');
          idx += 1;
        }

        if (l < len) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const reveal = () => {
      if (reduce.matches) { showAll(); return; }
      if (desktop.matches) animateWave();
      else root.classList.add('is-revealed');
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) { reveal(); io.disconnect(); } }),
        { threshold: 0 }
      );
      io.observe(root);
    } else {
      showAll();
    }
  }
</script>

<script>
  // "Find the 3 cats": once the photo scrolls into view, give the reader 5s to
  // spot the cats, then reveal a marker over each one. The stagger between the
  // three markers is pure CSS (per-marker `--d` delays); we only toggle the
  // `is-revealed` class after the delay.
  const photo = document.querySelector('[data-tags]');
  if (photo) {
    const reveal = () => setTimeout(() => photo.classList.add('is-revealed'), 5000);
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { reveal(); io.disconnect(); }
        }),
        { threshold: 0.35 }
      );
      io.observe(photo);
    } else {
      reveal();
    }
  }
</script>

<style>
  .about { background: var(--color-section-bg); }

  /* Centred header: small orange eyebrow over a large bold statement
     (same pattern as the services and projects sections). */
  .about-head {
    text-align: center;
    max-width: 56rem;
    margin: 0 auto var(--space-block);
  }
  .about-eyebrow {
    font-family: var(--font-body);
    font-size: var(--fs-h4);
    letter-spacing: 0.04em;
    color: var(--color-primary);
    margin-bottom: var(--space-element);
  }
  .about-eyebrow .slash { color: var(--color-primary); margin-right: 0.4em; }
  .about-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  /* Forced line break before the "technology" clause — desktop/tablet only;
     on phones the title wraps naturally so we suppress the break. */
  @media (max-width: 767.98px) {
    .about-title .ttl-br { display: none; }
  }

  /* Timeline heading ("· my path") — centred small orange eyebrow, matching
     the section labels (· about, · services, · projects). */
  .about-subhead {
    text-align: center;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--fs-h4);
    letter-spacing: 0.04em;
    color: var(--color-primary);
  }
  .about-subhead .slash { color: var(--color-primary); margin-right: 0.4em; }

  /* Headline under the "· journey" eyebrow — same large bold statement as the
     section header. */
  .about-subhead-title {
    text-align: center;
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-top: var(--space-element); /* path eyebrow -> path title (label -> title) */
  }

  .about-grid {
    display: grid;
    gap: var(--space-block); /* photo <-> bio column when stacked (vertical) */
  }
  @media (min-width: 900px) {
    /* align-items: center vertically centres the headline + facts against the
       (taller) portrait. */
    .about-grid {
      grid-template-columns: auto auto;
      justify-content: center;
      gap: 40px;
      align-items: center;
    }
  }

  /* The photo + its annotation overlay share one positioned box so the tags
     (positioned by %) always line up with the image, whatever its rendered
     size. Motion token for the chip's slight-overshoot pop lives here too. */
  .about-media {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
  }
  .about-photo {
    position: relative;
    width: 100%;
    max-width: 20.8rem;
    --ease-overshoot: cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .about-portrait {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
    /* Hard shadow: a solid primary-orange block offset up/left (no blur),
       matching the hero portrait's treatment. */
    box-shadow: -12px -12px 0 0 var(--color-primary);
  }
  /* Mobile: centre the portrait above the text. */
  @media (max-width: 899px) {
    .about-photo { max-width: 16rem; }
  }

  /* --- "Find the 3 cats" markers -----------------------------------------
     A terracotta ring sits *beside* each cat, hidden until the reveal. 3s after
     the photo scrolls into view the JS adds `is-revealed`; the rings then pop in
     one after another (per-marker `--d`) and give a gentle pulse to draw the eye.
     Shown on every viewport — the prompt below the photo stands in for a caption. */
  .cat-marker {
    position: absolute;
    z-index: 2;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 2.5px solid var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 16%, transparent);
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.4);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease-overshoot);
    transition-delay: var(--d);
    pointer-events: none;
  }
  /* Expanding halo, echoed once each marker lands. */
  .cat-marker::after {
    content: '';
    position: absolute;
    inset: -2.5px;
    border-radius: 50%;
    border: 2px solid var(--color-primary);
    opacity: 0;
  }

  .about-photo.is-revealed .cat-marker {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  .about-photo.is-revealed .cat-marker::after {
    animation: marker-pulse 1.6s var(--ease) 2;
    animation-delay: calc(var(--d) + 0.35s);
  }
  @keyframes marker-pulse {
    0% { transform: scale(1); opacity: 0.7; }
    100% { transform: scale(2.2); opacity: 0; }
  }

  .tag-cast {
    /* Terracotta pill under the photo, cream text. Sized and shaped to match the
       project card pills (0.82rem, 2px corners). Cream-on-terracotta ≈ 5:1 → AA. */
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.82rem;
    line-height: 1.3;
    color: var(--color-bg);
    background: var(--color-primary);
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.18);
    white-space: nowrap;
  }

  /* Descriptive caption for screen readers — the annotation makes sense
     without the visuals. Visually hidden on every viewport. */
  .tag-caption {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Three stacked text blocks beside the photo: a burnt-orange heading (with a
     trailing ·) over an Inter body paragraph. Left-aligned, no card. */
  .about-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-block); /* between the three bio sub-blocks */
    max-width: 34rem;
  }
  .about-block h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-primary);
    margin-bottom: var(--space-line); /* heading -> its body paragraph */
  }
  .about-block h3::after { content: ' ·'; }
  .about-block p {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--color-text);
    max-width: 42ch;
  }

  /* --- Timeline ---
     Mobile (<760px): a straight vertical rail with the dots down the left and
     left-aligned content; the rail grows and the steps fade in on reveal.
     Desktop (≥760px): a centred "vertical wave" — the SVG path is the line and
     each milestone is positioned at its wave extreme, revealed as the line is
     drawn (see the <script> and the min-width block below). */
  /* Journey: a full-width tinted band (spans the section; content is re-centred
     by its own inner .container). Gaps above/below come from the margin + the
     section's own bottom padding. */
  .about-path {
    /* A distinct full-bleed band inside About: its seam behaves like a section
       boundary. The pre-band margin + the band's own top padding sum to one
       --space-section between the bio and the journey content. The negative
       bottom margin absorbs the section's own bottom seam so the tint runs flush
       into the footer; the band's bottom padding + the footer's top padding then
       make up the journey -> footer --space-section. */
    margin-top: calc(var(--space-section) / 2);
    margin-bottom: calc(var(--space-section) / -2);
    padding-block: calc(var(--space-section) / 2);
    background: var(--color-section-bg-alt);
  }
  .path-track { position: relative; }
  .path-wave { display: none; } /* mobile uses the straight CSS rail instead */
  /* The dot that travels down the wave (desktop only, shown via JS). */
  .path-runner {
    fill: var(--color-primary);
    opacity: 0;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--color-primary) 55%, transparent));
  }
  .path {
    list-style: none;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-block); /* between timeline steps (mobile rail) */
    max-width: 46rem;
    margin: var(--space-block) auto 0; /* path title -> timeline */
    padding-left: 0.25rem;
  }

  .path-step {
    display: grid;
    grid-template-columns: 12px 1fr;
    column-gap: var(--space-4);
    align-items: start;
    /* hidden until revealed */
    opacity: 0;
    transform: translateY(10px);
  }
  @keyframes step-in { to { opacity: 1; transform: translateY(0); } }
  @keyframes line-grow { to { transform: scaleY(1); } }

  /* Mobile rail + sequential fade-in (driven by the `is-revealed` class). */
  @media (max-width: 759.98px) {
    .path::before {
      content: '';
      position: absolute;
      top: 8px;
      bottom: 8px;
      left: 5px;
      width: 1.5px;
      background: var(--color-line);
      transform: scaleY(0);
      transform-origin: top;
    }
    .about-path.is-revealed .path::before {
      animation: line-grow 0.75s var(--ease) forwards;
    }
    .about-path.is-revealed .path-step {
      animation: step-in 0.375s var(--ease) forwards;
      animation-delay: calc(0.225s + var(--i) * 0.135s);
    }
  }

  .path-dot {
    position: relative;
    width: 12px;
    height: 12px;
    margin-top: 0.2rem; /* nudge onto the year line */
    border-radius: 50%;
    background: var(--color-primary);
  }
  .path-step.is-current .path-dot {
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-primary) 22%, transparent);
  }
  /* The latest step pulses with an expanding ring. */
  .path-step.is-current .path-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-primary);
    z-index: -1;
    animation: dot-pulse 2s ease-out infinite;
  }
  @keyframes dot-pulse {
    0% { transform: scale(1); opacity: 0.55; }
    100% { transform: scale(2.8); opacity: 0; }
  }

  .path-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .path-year {
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .path-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .path-sub {
    margin-top: 0.25rem;
    max-width: 52ch;
    /* Same text style as the service-box body (.service-desc). */
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--color-text);
  }
  .path-sub :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
    transition: opacity 0.15s var(--ease);
  }
  .path-sub :global(a:hover) { opacity: 0.7; }

  /* Desktop: the vertical wave. The SVG path is the connecting line; each step
     is absolutely placed at its wave extreme (--wx/--wy) and revealed (JS adds
     `is-shown`) as the line is drawn past it. */
  @media (min-width: 760px) {
    .path-track {
      width: 700px;
      height: 1140px;
      margin: var(--space-3) auto 0;
    }
    .path-wave {
      display: block;
      position: absolute;
      inset: 0;
      overflow: visible;
    }
    .path-wave path {
      fill: none;
      stroke: var(--color-line);
      stroke-width: 2;
      stroke-linecap: round;
      /* Hidden by default; JS recomputes the exact length and draws it. The
         dasharray comfortably exceeds the real path length (~1360px). */
      stroke-dasharray: 1600;
      stroke-dashoffset: 1600;
    }
    .path {
      position: absolute;
      inset: 0;
      display: block;
      max-width: none;
      margin: 0;
      padding: 0;
    }
    .path-step {
      --dot: 12px;
      --card-w: 288px;
      --gap: 16px;
      position: absolute;
      top: calc(var(--wy) - 8px);
      column-gap: var(--gap);
      transition: opacity 0.5s var(--ease), transform 0.5s var(--ease);
    }
    .path-step.is-right {
      grid-template-columns: var(--dot) var(--card-w);
      left: calc(var(--wx) - var(--dot) / 2);
    }
    .path-step.is-left {
      grid-template-columns: var(--card-w) var(--dot);
      left: calc(var(--wx) - var(--dot) / 2 - var(--card-w) - var(--gap));
    }
    .path-step.is-left .path-dot { order: 2; }
    .path-step.is-left .path-content { order: 1; text-align: right; }
    .path-step.is-left .path-sub { margin-left: auto; }
    .path-step.is-shown { opacity: 1; transform: none; }
    .path-sub { max-width: none; } /* the fixed card column already constrains it */
  }

  @media (prefers-reduced-motion: reduce) {
    .path::before { transform: none; animation: none; }
    .path-wave path { stroke-dashoffset: 0 !important; transition: none !important; }
    .path-runner { opacity: 0 !important; }
    .path-step { opacity: 1; transform: none; animation: none; transition: none; }
    .path-step.is-current .path-dot::after { animation: none; opacity: 0; }

    /* Cat markers: still gated behind the 3s reveal, but pop in without
       motion — no scale/pulse, just a fade handled by the base transition. */
    .cat-marker { transform: translate(-50%, -50%); transition: opacity 0.3s var(--ease); }
    .about-photo.is-revealed .cat-marker { transform: translate(-50%, -50%); }
    .about-photo.is-revealed .cat-marker::after { animation: none; }
  }
</style>

<noscript>
  <style>
    .path::before { transform: none !important; }
    .path-wave path { stroke-dashoffset: 0 !important; }
    .path-step { opacity: 1 !important; transform: none !important; }
    /* No JS to run the 3s timer, so reveal the markers immediately. */
    .cat-marker { opacity: 1 !important; transform: translate(-50%, -50%) !important; }
  </style>
</noscript>
