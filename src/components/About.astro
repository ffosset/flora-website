---
import { Image } from 'astro:assets';
import portrait from '../assets/flora-about.png';
const { t } = Astro.props;
const facts = t.about.facts || [];
const path = t.about.path || [];
---

<section id="about" class="about">
  <div class="container">
    <h2 class="about-title"><span class="slash">·</span>{t.about.sectionTitle}</h2>

    <div class="about-grid">
      <div class="about-media">
        <Image
          class="about-portrait"
          src={portrait}
          alt="Flora Fosset"
          width={640}
          format="webp"
          loading="lazy"
        />
      </div>

      <div class="about-right">
        <p class="about-headline">{t.about.headline}</p>

        <ul class="about-facts">
          {facts.map((f) => (
            <li>
              <span class="slash" aria-hidden="true">·</span>
              <strong>{f.strong}</strong> <span class="fact-rest">{f.rest}</span>
            </li>
          ))}
        </ul>

        <div class="about-block">
          <h3><span class="slash">·</span>{t.about.howIWorkTitle}</h3>
          <p>{t.about.howIWorkBody}</p>
        </div>
        <div class="about-block">
          <h3><span class="slash">·</span>{t.about.valuesTitle}</h3>
          <p>{t.about.values}</p>
        </div>
      </div>
    </div>

    <div class="about-path" data-path>
      <h2 class="about-title"><span class="slash">·</span>{t.about.pathTitle}</h2>
      <ol class="path">
        {path.map((p, i) => (
          <li class:list={['path-step', { 'is-current': p.current }]} style={`--i:${i}`}>
            <span class="path-dot" aria-hidden="true"></span>
            <span class="path-label">{p.label}</span>
            <span class="path-year">{p.year}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  // Reveal the timeline (line draws + steps appear one after another) the first
  // time it scrolls into view.
  const path = document.querySelector('[data-path]');
  if (path) {
    const reveal = () => path.classList.add('is-revealed');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) { reveal(); io.disconnect(); } }),
        { threshold: 0.4 }
      );
      io.observe(path);
    } else {
      reveal();
    }
  }
</script>

<style>
  .about { background: var(--color-section-bg); }

  .about-title {
    font-size: var(--fs-section);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .about-grid {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  @media (min-width: 900px) {
    .about-grid { grid-template-columns: 1fr 1.6fr; gap: var(--space-5); align-items: start; }
  }

  .about-portrait {
    display: block;
    width: 100%;
    max-width: 26rem;
    height: auto;
  }

  .about-headline {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 1.05rem + 1.6vw, 2.1rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-text);
    max-width: 26ch;
  }

  /* Quick facts: orange dot, bold lead-in, primary-coloured remainder. */
  .about-facts {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .about-facts li {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.3rem);
    line-height: 1.3;
  }
  .about-facts .slash { color: var(--color-primary); margin-right: 0.4em; font-weight: 700; }
  .about-facts strong { font-weight: 700; color: var(--color-text); }
  .about-facts .fact-rest { color: var(--color-primary); }

  .about-block { margin-top: var(--space-5); max-width: 60ch; }
  .about-block h3 {
    font-size: 1.375rem;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-2);
  }
  .about-block p { color: var(--color-muted); }

  /* --- Timeline --- */
  .about-path { margin-top: var(--space-6); }
  .path {
    list-style: none;
    position: relative;
    display: flex;
    align-items: flex-start;
    margin-top: var(--space-5);
    padding-top: 0.75rem;
  }
  /* The connecting line, drawn left-to-right on reveal. */
  .path::before {
    content: '';
    position: absolute;
    top: calc(0.75rem + 6px);
    left: 0;
    right: 0;
    height: 1.5px;
    background: var(--color-line);
    transform: scaleX(0);
    transform-origin: left;
  }
  .about-path.is-revealed .path::before {
    animation: line-grow 1s var(--ease) forwards;
  }
  @keyframes line-grow { to { transform: scaleX(1); } }

  .path-step {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    /* hidden until revealed */
    opacity: 0;
    transform: translateY(10px);
  }
  .about-path.is-revealed .path-step {
    animation: step-in 0.5s var(--ease) forwards;
    animation-delay: calc(0.3s + var(--i) * 0.18s);
  }
  @keyframes step-in { to { opacity: 1; transform: translateY(0); } }

  .path-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-primary);
  }
  .path-step.is-current .path-dot {
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-primary) 22%, transparent);
  }
  .path-label {
    width: 100%;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(0.8rem, 0.7rem + 0.35vw, 1rem);
    color: var(--color-text);
  }
  .path-year {
    width: 100%;
    text-align: center;
    font-size: clamp(0.72rem, 0.66rem + 0.2vw, 0.8125rem);
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .path::before { transform: scaleX(1); animation: none; }
    .path-step { opacity: 1; transform: none; animation: none; }
  }
</style>

<noscript>
  <style>
    .path::before { transform: scaleX(1) !important; }
    .path-step { opacity: 1 !important; transform: none !important; }
  </style>
</noscript>
