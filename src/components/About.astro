---
const { t } = Astro.props;
---

<section id="about" class="about">
  <div class="container about-grid">
    <div class="about-left">
      <h2><span class="slash">·</span>{t.about.sectionTitle}</h2>
    </div>
    <div class="about-right">
      <p class="bio">{t.about.bio}</p>

      <div class="how">
        <h3><span class="slash">·</span>{t.whatIDo.howIWorkTitle.toLowerCase()}</h3>
        <p>{t.whatIDo.howIWorkBody}</p>
      </div>

      <div class="values">
        <h3><span class="slash">·</span>{t.about.valuesTitle}</h3>
        <p>{t.about.values}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 900px) {
    .about-grid { grid-template-columns: 1fr 2fr; gap: var(--space-5); }
  }
  .about-left h2 {
    font-size: var(--fs-section);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .bio { max-width: 60ch; color: var(--color-ink); font-size: 1.125rem; }

  .how { margin-top: var(--space-5); max-width: 60ch; }
  .values { margin-top: var(--space-5); max-width: 60ch; }
  .how h3,
  .values h3 {
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-2);
  }
  .how p,
  .values p { color: var(--color-muted); }
</style>
