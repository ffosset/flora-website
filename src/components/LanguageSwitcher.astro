---
import { defaultLang } from '../i18n';

const { currentLocale } = Astro.props;

// Order shown in the design: en · es · fr.
const order = ['en', 'es', 'fr'];
// BASE_URL has no trailing slash (config base is '/flora-website'); strip
// defensively so the join below is correct either way.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function localePath(loc) {
  return loc === defaultLang ? `${base}/` : `${base}/${loc}/`;
}
---

<div class="lang-switch">
  {
    order.map((code, i) => (
      <>
        {i > 0 && <span class="sep" aria-hidden="true">·</span>}
        <a
          href={localePath(code)}
          class={code === currentLocale ? 'active' : ''}
          hreflang={code}
          aria-current={code === currentLocale ? 'true' : undefined}
        >
          {code}
        </a>
      </>
    ))
  }
</div>

<style>
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 1rem;
  }
  .lang-switch a {
    text-decoration: none;
    color: var(--color-muted-soft);
    font-weight: 300;
    transition: color 0.2s var(--ease);
  }
  .lang-switch a.active { color: var(--color-primary); font-weight: 700; }
  .lang-switch a:hover { color: var(--color-primary); }
  .lang-switch .sep { color: var(--color-muted-soft); font-weight: 300; }
</style>
