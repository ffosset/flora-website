---
import { defaultLang, languages } from '../i18n';

const { currentLocale, variant = 'header' } = Astro.props;

// Order shown in the design: en · es · fr.
const order = ['en', 'es', 'fr'];
// Config base is '/', so BASE_URL is '/'; strip the trailing slash
// defensively so the join below is correct either way.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function localePath(loc) {
  return loc === defaultLang ? `${base}/` : `${base}/${loc}/`;
}

const activeLabel = languages[currentLocale] ?? languages[defaultLang];
---

<details class={`lang-switch lang-switch--${variant}`} data-lang-switch>
  <summary class="lang-toggle btn-outline" aria-label="Select language">
    <span class="lang-current">{activeLabel}</span>
    <svg class="caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
      <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </summary>
  <ul class="lang-menu">
    {
      order.map((code) => (
        <li>
          <a
            href={localePath(code)}
            class={code === currentLocale ? 'active' : ''}
            hreflang={code}
            aria-current={code === currentLocale ? 'true' : undefined}
          >
            {languages[code]}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang-switch {
    position: relative;
    font-size: 1rem;
  }

  /* Toggle button (the <summary>). Shares the unified `.btn-outline` recipe
     (Inter Thin, colored pill border, hover fill) — only layout + colour live
     here. `color` drives the border via currentColor, so the same control
     serves both the orange header and the cream-on-footer variant. */
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    color: var(--color-primary);
    list-style: none;
    user-select: none;
  }
  .lang-toggle::-webkit-details-marker { display: none; }
  .lang-current { text-transform: lowercase; }

  .caret {
    flex: none;
    transition: transform 0.2s var(--ease);
  }
  .lang-switch[open] .caret { transform: rotate(180deg); }

  /* Dropdown */
  .lang-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    margin: 0;
    padding: 6px;
    list-style: none;
    min-width: 100%;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    z-index: 20;
  }
  .lang-menu li { margin: 0; }
  .lang-menu a {
    display: block;
    padding: 6px 12px;
    border-radius: 5px;
    text-decoration: none;
    color: var(--color-muted-soft);
    font-weight: 300;
    text-transform: lowercase;
    white-space: nowrap;
    transition: color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .lang-menu a:hover { color: var(--color-primary); background: var(--color-surface); }
  .lang-menu a.active { color: var(--color-primary); font-weight: 700; }

  /* Footer variant: sits on the purple drawer, so it wears the on-purple text
     colors, and its menu opens upward (it lives at the very bottom edge). */
  .lang-switch--footer { font-size: inherit; }
  .lang-switch--footer .lang-toggle { color: var(--color-muted-on-purple); }
  .lang-switch--footer .lang-toggle:hover { color: var(--color-ink-on-purple); }
  .lang-switch--footer .lang-menu {
    top: auto;
    bottom: calc(100% + 8px);
  }
</style>

<script>
  // Close the dropdown on outside click or Escape.
  document.querySelectorAll('[data-lang-switch]').forEach((el) => {
    document.addEventListener('click', (e) => {
      if (el.open && !el.contains(e.target as Node)) el.open = false;
    });
    el.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') el.open = false;
    });
  });
</script>
