---
const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Layout + colour variety are derived from the index (no per-project metadata),
// so reordering the data array just reshuffles the rhythm. Category info stays
// on each card as data-cats metadata even though filtering is gone.
const LAYOUTS = ['top', 'none', 'bottom'];
const COLORS = ['cream', 'orange', 'peach', 'ink', 'clay', 'olive'];

const cards = (t.work.projects || []).map((p, i) => ({
  ...p,
  layout: LAYOUTS[i % LAYOUTS.length],
  color: COLORS[i % COLORS.length],
}));

// Two rows: group consecutive cards into columns of two.
const columns = [];
for (let i = 0; i < cards.length; i += 2) columns.push(cards.slice(i, i + 2));
---

<section id="work" class="work">
  <div class="container work-head">
    <div class="work-title">
      <h2><span class="slash">·</span>{t.work.sectionTitle}</h2>
      <p class="intro">{t.work.intro}</p>
    </div>
  </div>

  <div
    class="work-scroller"
    tabindex="0"
    role="region"
    aria-label="Selected projects — scroll sideways to browse"
  >
    <div class="work-grid">
      {columns.map((col) => (
        <div class="work-col">
          {col.map((c) => {
            const hasUrl = Boolean(c.url);
            const isExternal = hasUrl && c.url.startsWith('http');
            const href = hasUrl ? (isExternal ? c.url : base + c.url) : undefined;
            const Tag = hasUrl ? 'a' : 'div';
            const showMedia = c.layout !== 'none';
            const Visual = (
              <div class="card-visual">
                <span class="card-ph" aria-hidden="true">{c.subtitle || c.slug}</span>
                <img src={base + c.image} alt={c.subtitle} loading="lazy" onerror="this.style.display='none'" />
              </div>
            );
            return (
              <Tag
                class:list={['card', `card--${c.color}`, `card--${c.layout}`, { 'is-link': hasUrl }]}
                href={href}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
                data-cats={(c.category || []).join(' ')}
              >
                {showMedia && c.layout === 'top' && Visual}
                <div class="card-body">
                  {c.tag && <span class="card-tag">{c.tag}</span>}
                  {c.subtitle && <p class="card-client">{c.subtitle}</p>}
                  <h3 class="card-title">{c.title}</h3>
                  {c.result && <p class="card-result">{c.result}</p>}
                </div>
                {showMedia && c.layout === 'bottom' && Visual}
              </Tag>
            );
          })}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .work { padding-block: var(--space-6) var(--space-5); }

  .work-head { margin-bottom: var(--space-4); }
  .work-title h2 {
    font-size: var(--fs-hero);
    line-height: 1;
    letter-spacing: -0.03em;
    max-width: 14ch;
  }
  .intro {
    color: var(--color-muted);
    max-width: 50ch;
    margin-top: var(--space-2);
  }

  /* Full-bleed horizontal scroller. overflow-y is hidden so the wheel keeps
     scrolling the page vertically; sideways scroll is trackpad / shift-wheel /
     drag / the thin scrollbar / arrow keys when focused. */
  .work-scroller {
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: var(--space-3) var(--space-4);
    scrollbar-width: thin;
    scrollbar-color: var(--color-line) transparent;
  }
  .work-scroller:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 4px; }
  .work-scroller::-webkit-scrollbar { height: 6px; }
  .work-scroller::-webkit-scrollbar-thumb { background: var(--color-line); border-radius: 999px; }

  .work-grid {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    width: max-content;
    padding-inline: var(--gutter);
  }
  .work-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 0 0 clamp(15rem, 24vw, 20rem);
  }
  /* Editorial stagger: each column sits at a different vertical level. */
  .work-col:nth-child(4n + 2) { margin-top: var(--space-5); }
  .work-col:nth-child(4n + 3) { margin-top: var(--space-3); }
  .work-col:nth-child(4n + 4) { margin-top: calc(var(--space-5) + var(--space-3)); }

  /* --- Card --- */
  .card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-card);
    overflow: hidden;
    text-decoration: none;
    background: var(--card-bg);
    color: var(--card-fg);
    box-shadow: 0 6px 20px rgba(33, 15, 3, 0.07);
    transition: transform 0.25s var(--ease);
  }
  .card.is-link:hover { transform: translateY(-5px); }

  /* Background palette (text colour auto-set per card). */
  .card--cream  { --card-bg: #ffffff;                --card-fg: var(--color-text); }
  .card--peach  { --card-bg: var(--color-secondary); --card-fg: var(--color-text); }
  .card--clay   { --card-bg: #e7a981;                --card-fg: #2a1505; }
  .card--orange { --card-bg: var(--color-primary);   --card-fg: #ffffff; }
  .card--ink    { --card-bg: var(--color-text);      --card-fg: #ffffff; }
  .card--olive  { --card-bg: #75784e;                --card-fg: #ffffff; }

  .card-visual {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: color-mix(in srgb, var(--card-fg) 8%, transparent);
  }
  .card-visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Placeholder label — fallback inside the same container as the image. */
  .card-ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    text-align: center;
    font-size: 14px;
    letter-spacing: 0.04em;
    color: var(--card-fg);
    opacity: 0.4;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: var(--space-3);
  }
  .card-tag {
    align-self: flex-start;
    font-size: var(--fs-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--card-fg) 12%, transparent);
    color: var(--card-fg);
  }
  .card-client {
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
    color: color-mix(in srgb, var(--card-fg) 60%, transparent);
  }
  .card-title {
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .card-result {
    font-size: 0.9375rem;
    line-height: 1.4;
    color: color-mix(in srgb, var(--card-fg) 82%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .card { transition: none; }
  }

  /* Mobile: still a horizontal scroller, wider cards, no stagger. */
  @media (max-width: 767px) {
    .work-col { flex: 0 0 78vw; }
    .work-col[class] { margin-top: 0; }
  }
</style>
