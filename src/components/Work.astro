---
import ProjectCard from './ProjectCard.astro';
const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = t.work.projects || [];

// Per-card CTA label (a key into t.work.ctas, translated per locale). Every
// card now shares one identical visual structure, so the CTA wording is the
// only per-project treatment left.
const DESIGN = {
  'cercle-histoire-forest': { cta: 'website' },
  'minnow-collective':      { cta: 'website' },
  'soy-de-temporada':       { cta: 'platform' },
  'rosa-ebilling':          { cta: 'website' },
  'investment-simulator':   { cta: 'website' },
  'free-the-fish':          { cta: 'code' },
  'couleur-du-peche':       { cta: 'read' },
  'oyas-belgique':          { cta: 'website' },
  'rosen':                  { cta: 'read' },
};

// Labels ProjectCard needs (it doesn't receive the whole dictionary).
const cardLabels = { readMore: t.work.readMore, readLess: t.work.readLess, newTab: t.a11y.newTab };

// Display order for the projects grid. The first row shows by default; the
// rest reveal via the "Load more" button. Edit this list to change which
// projects show and in what order.
const ORDER = [
  'cercle-histoire-forest', // 1
  'oyas-belgique',          // 2
  'minnow-collective',      // 3
  'soy-de-temporada',       // 4
  'rosa-ebilling',          // 5
  'investment-simulator',   // 6
  'free-the-fish',          // 7
  'couleur-du-peche',       // 8 (métis investigation)
];
// How many show before "Load more" is a per-breakpoint rule handled in CSS:
// 3 on desktop, 2 on tablet and mobile. "Load more" reveals the rest.

const ordered = ORDER
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p) => p && DESIGN[p.slug]);
---

<section id="work" class="work">
  <div class="container">
    <header class="work-head">
      <p class="work-eyebrow"><span class="slash">·</span>{t.work.sectionTitle}</p>
      <h2 class="work-title">{t.work.sectionSubtitle}</h2>
    </header>

    <div class="work-grid">
      {ordered.map((p) => (
        <ProjectCard
          c={p}
          d={{ ...DESIGN[p.slug], cta: t.work.ctas[DESIGN[p.slug].cta] }}
          base={base}
          labels={cardLabels}
          service={t.work.filters[p.category]}
        />
      ))}
    </div>

    {ordered.length > 2 && (
      <button
        type="button"
        class="work-more"
        data-work-more
        aria-expanded="false"
        data-more-label={t.work.seeMore}
        data-less-label={t.work.seeLess}
      >
        {t.work.seeMore}
      </button>
    )}
  </div>

  <noscript set:html={'<style>.work-grid > .card{display:flex !important}.work-more{display:none !important}</style>'} />
</section>

<script>
  // Desktop: the detail reveals on hover/focus (CSS).
  // Mobile: a "read more" button expands it inline below the card body.
  document.querySelectorAll('.work .card').forEach((card) => {
    const moreBtn = card.querySelector('[data-more]');
    if (!moreBtn) return;
    const moreLabel = moreBtn.getAttribute('data-more-label') || 'Read more';
    const lessLabel = moreBtn.getAttribute('data-less-label') || 'Read less';
    moreBtn.addEventListener('click', () => {
      const open = !card.classList.contains('is-open');
      card.classList.toggle('is-open', open);
      moreBtn.setAttribute('aria-expanded', String(open));
      moreBtn.textContent = open ? lessLabel : moreLabel;
    });
  });
</script>

<script>
  // "Load more": reveal one more row per click — 3 cards on desktop, 2 on
  // tablet / mobile. Which cards are hidden by default is a CSS rule per
  // breakpoint; JS reveals the next batch by setting an inline display, and
  // once every card is shown the button flips to "Load less" (collapse).
  const moreBtn = document.querySelector('[data-work-more]');
  if (moreBtn) {
    const grid = document.querySelector('.work-grid');
    const cards = Array.from(grid.querySelectorAll('.card'));
    const moreLabel = moreBtn.getAttribute('data-more-label') || 'Load more';
    const lessLabel = moreBtn.getAttribute('data-less-label') || 'Load less';

    // One row's worth of cards per click.
    const rowStep = () => (window.matchMedia('(min-width: 1024px)').matches ? 3 : 2);
    const hidden = () => cards.filter((c) => getComputedStyle(c).display === 'none');

    const syncLabel = () => {
      const allShown = hidden().length === 0;
      moreBtn.textContent = allShown ? lessLabel : moreLabel;
      moreBtn.setAttribute('aria-expanded', String(allShown));
    };

    moreBtn.addEventListener('click', () => {
      if (hidden().length === 0) {
        // Collapse back to the default row, then scroll up to the section top.
        cards.forEach((c) => { c.style.display = ''; });
        document.getElementById('work').scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        // Reveal the next row; inline display overrides the CSS default-hide.
        hidden().slice(0, rowStep()).forEach((c) => { c.style.display = 'flex'; });
      }
      syncLabel();
    });

    syncLabel();
  }
</script>

<style>
  .work {
    background: var(--color-section-bg);
    padding-block: var(--space-6) var(--space-5);
    scroll-margin-top: 5rem; /* clear the fixed nav when scrolling to #work */
  }

  /* Centred header: small orange eyebrow over a large bold statement
     (same pattern as the services section). */
  .work-head {
    text-align: center;
    max-width: 56rem;
    margin: 0 auto var(--space-5);
  }
  .work-eyebrow {
    font-family: var(--font-body);
    font-size: var(--fs-h4);
    letter-spacing: 0.04em;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }
  .work-eyebrow .slash { color: var(--color-primary); margin-right: 0.4em; }
  .work-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  /* Projects grid. Phones: a single centred column. */
  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 34rem;
    margin-inline: auto;
  }
  /* Default view shows one row per breakpoint; "Load more" reveals the next row
     (JS sets inline display on the next batch of cards). Base = 2 cards (mobile
     + tablet); desktop lifts to 3. .card is rendered by the ProjectCard child,
     so it needs :global() to escape this component's style scope. */
  .work-grid > :global(.card:nth-child(n + 3)) { display: none; }

  /* "Load more" — reveals the remaining cards. */
  .work-more {
    display: block;
    margin: var(--space-5) auto 0;
    padding: 0.7rem 1.7rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: color 0.25s var(--ease), background 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .work-more:hover {
    border-color: var(--color-muted);
    background: color-mix(in srgb, var(--color-text) 5%, transparent);
  }
  .work-more:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }

  /* Tablet: two equal columns (still 2 cards by default = one row). minmax(0,
     1fr) forces them equal regardless of the image inside. */
  @media (min-width: 721px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
      max-width: none;
    }
    .work-grid > :global(.card) { min-width: 0; }
  }

  /* Desktop: three equal columns, showing 3 cards by default (one row). */
  @media (min-width: 1024px) {
    .work-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .work-grid > :global(.card:nth-child(3)) { display: flex; }
  }
</style>
