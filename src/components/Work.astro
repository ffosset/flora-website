---
import ProjectCard from './ProjectCard.astro';
const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = t.work.projects || [];

// Per-card visual treatment (colours / layout / blend), keyed by slug.
const DESIGN = {
  'cercle-histoire-forest': { bg: '#efe9e3', fg: '#210f03', layout: 'media-top', hover: '#c7a98a', pill: '#d7c5b3', cta: 'Visit website' },
  'minnow-collective':      { bg: '#124b4b', fg: '#ffffff', layout: 'text-top', media: 'full', round: true, hover: '#4e9d9d', pill: '#349494', cta: 'Visit website' },
  'soy-de-temporada':       { bg: '#fcf4be', fg: '#210f03', layout: 'text-top', media: 'sm', blend: 'darken', center: true, hover: '#f6e35c', pill: '#f6e35c', cta: 'Visit platform' },
  'rosa-ebilling':          { bg: '#916cb1', fg: '#ffffff', layout: 'text-top', media: 'md', blend: 'lighten', center: true, hover: '#bf8aed', pill: '#bf8aed', cta: 'Visit website' },
  'neighborhood-map':       { bg: '#d1d5ef', fg: '#210f03', layout: 'media-top', hover: '#7a88ed', pill: '#7a88ed', cta: 'Visit website' },
  'couleur-du-peche':       { bg: '#fce4be', fg: '#210f03', layout: 'media-pad', round: true, hover: '#f1c173', pill: '#f1c173', cta: 'Read' },
  'oyas-belgique':          { bg: '#dfe7d8', fg: '#210f03', layout: 'media-top', hover: '#a8c08f', pill: '#a8c08f', cta: 'Visit website' },
  'rosen':                  { bg: '#ece6e1', fg: '#210f03', layout: 'media-top', hover: '#cdbfb1', pill: '#cdbfb1', cta: 'Read' },
};

// Category order (also the filter order; Landing is the default view). Each
// category shows its projects as equal-width columns; the LEAD slug is just
// rendered first. We expect at most three projects per category.
const CATS = ['landing', 'product', 'storytelling'];
const LEAD = {
  landing: 'cercle-histoire-forest',
  product: 'minnow-collective',
  storytelling: 'couleur-du-peche',
};

const byCat = CATS.map((cat) => {
  const list = projects.filter((p) => p.category === cat && DESIGN[p.slug]);
  // Lead slug first, then the rest — all equal size.
  const lead = list.find((p) => p.slug === LEAD[cat]);
  const items = lead ? [lead, ...list.filter((p) => p !== lead)] : list;
  return { cat, items };
});
---

<section id="work" class="work">
  <div class="container work-head">
    <h2 class="work-h2"><span class="slash">·</span>{t.work.sectionTitle}</h2>
    <div class="work-filters" role="group" aria-label="Filter projects">
      {CATS.map((k, i) => (
        <button type="button" class="filter" data-filter={k} aria-pressed={i === 0 ? 'true' : 'false'}>
          {t.work.filters[k]}
        </button>
      ))}
    </div>
  </div>

  <div class="container">
    {byCat.map(({ cat, items }, i) => (
      <div class:list={['work-cat', { 'is-shown': i === 0 }]} data-cat={cat}>
        {items.map((p) => <ProjectCard c={p} d={DESIGN[p.slug]} base={base} />)}
      </div>
    ))}
  </div>
</section>

<script>
  // Desktop: the overlay reveals on hover/focus (CSS). Mobile (and no-url
  // button cards): a click/Enter/Space opens it at the bottom of the card.
  const mq = window.matchMedia('(max-width: 720px)');
  document.querySelectorAll('.work .card').forEach((card) => {
    const isButton = card.getAttribute('role') === 'button';
    const setOpen = (open) => {
      card.classList.toggle('is-open', open);
      if (isButton) card.setAttribute('aria-expanded', String(open));
    };
    card.addEventListener('click', (e) => {
      if (e.target.closest('.hover-cta')) return; // let the CTA link navigate
      if (isButton) return setOpen(!card.classList.contains('is-open'));
      if (mq.matches) setOpen(!card.classList.contains('is-open'));
    });
    if (isButton) {
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          setOpen(!card.classList.contains('is-open'));
        }
      });
    }
  });
</script>

<script>
  // Category filtering. One category is shown at a time (Landing by default).
  // Driven by the filter buttons and by the Services cards (which dispatch a
  // 'work:filter' event before scrolling to #work).
  const fbtns = Array.from(document.querySelectorAll('.work-filters .filter'));
  const cats = Array.from(document.querySelectorAll('.work-cat'));
  if (fbtns.length && cats.length) {
    const apply = (cat) => {
      if (!cats.some((c) => c.dataset.cat === cat)) return;
      fbtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === cat)));
      cats.forEach((c) => c.classList.toggle('is-shown', c.dataset.cat === cat));
    };
    fbtns.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter)));
    document.addEventListener('work:filter', (e) => apply(e.detail));
  }
</script>

<style>
  /* White ground (the About section below keeps the light-grey page bg). */
  .work {
    background: var(--color-card);
    padding-block: var(--space-6) var(--space-5);
  }

  /* Title with the filters sitting right beside it. */
  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-bottom: var(--space-4);
  }
  .work-h2 {
    font-size: var(--fs-section);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  /* Filter pills. */
  .work-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .filter {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition: color 0.25s var(--ease), background 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .filter:hover { color: var(--color-text); border-color: var(--color-muted); }
  .filter:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .filter[aria-pressed='true'] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-ink-on-primary);
  }

  /* One category shown at a time. Phones: a single centred column. */
  .work-cat { display: none; }
  .work-cat.is-shown {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  @media (max-width: 720px) {
    .work-cat { max-width: 34rem; margin-inline: auto; }
  }

  /* Desktop: equal-width columns. Hovering one card expands it; the others
     narrow and fade back. */
  @media (min-width: 721px) {
    .work-cat.is-shown {
      flex-direction: row;
      align-items: stretch;
    }
    .work-cat > .card {
      flex: 1 1 0;
      min-width: 0;
      transition: flex-grow 0.45s var(--ease), opacity 0.45s var(--ease);
    }
    .work-cat:hover > .card { opacity: 0.5; }
    .work-cat > .card:hover {
      flex-grow: 2.2;
      opacity: 1;
    }
  }
</style>
