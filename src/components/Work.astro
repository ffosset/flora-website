---
import ProjectCard from './ProjectCard.astro';
const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = t.work.projects || [];

// Per-card CTA label (a key into t.work.ctas, translated per locale). Every
// card now shares one identical visual structure, so the CTA wording is the
// only per-project treatment left.
const DESIGN = {
  'cercle-histoire-forest': { cta: 'website' },
  'minnow-collective':      { cta: 'website' },
  'soy-de-temporada':       { cta: 'platform' },
  'rosa-ebilling':          { cta: 'website' },
  'neighborhood-map':       { cta: 'website' },
  'couleur-du-peche':       { cta: 'read' },
  'oyas-belgique':          { cta: 'website' },
  'rosen':                  { cta: 'read' },
};

// Labels ProjectCard needs (it doesn't receive the whole dictionary).
const cardLabels = { readMore: t.work.readMore, newTab: t.a11y.newTab };

// Display order for the projects grid. The first VISIBLE show by default; the
// rest reveal STEP at a time via the "see more" button. Edit this list to
// change which projects show and in what order.
const ORDER = [
  'cercle-histoire-forest', // 1
  'oyas-belgique',          // 2
  'minnow-collective',      // 3
  'soy-de-temporada',       // 4
  'rosa-ebilling',          // 5
  'couleur-du-peche',       // 6 (métis investigation)
];
const VISIBLE = 4; // shown before any "see more" click
const STEP = 2;    // revealed per click

const ordered = ORDER
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p) => p && DESIGN[p.slug]);
---

<section id="work" class="work">
  <div class="container">
    <header class="work-head">
      <p class="work-eyebrow"><span class="slash">·</span>{t.work.sectionTitle}</p>
      <h2 class="work-title">{t.work.sectionSubtitle}</h2>
    </header>

    <div class="work-grid">
      {ordered.map((p, i) => (
        <ProjectCard
          c={p}
          d={{ ...DESIGN[p.slug], cta: t.work.ctas[DESIGN[p.slug].cta] }}
          base={base}
          labels={cardLabels}
          service={t.work.filters[p.category]}
          extra={i >= VISIBLE}
        />
      ))}
    </div>

    {ordered.length > VISIBLE && (
      <button
        type="button"
        class="work-more"
        data-work-more
        data-step={STEP}
        data-visible={VISIBLE}
        data-more-label={t.work.seeMore}
        data-less-label={t.work.seeLess}
      >
        {t.work.seeMore}
      </button>
    )}
  </div>

  <noscript set:html={'<style>.card.is-extra{display:flex !important}.work-more{display:none !important}</style>'} />
</section>

<script>
  // Desktop: the detail reveals on hover/focus (CSS).
  // Mobile: a "read more" button expands it inline below the card body.
  document.querySelectorAll('.work .card').forEach((card) => {
    const moreBtn = card.querySelector('[data-more]');
    if (!moreBtn) return;
    moreBtn.addEventListener('click', () => {
      const open = !card.classList.contains('is-open');
      card.classList.toggle('is-open', open);
      moreBtn.setAttribute('aria-expanded', String(open));
      moreBtn.textContent = open ? 'Read less' : 'Read more';
    });
  });
</script>

<script>
  // "See more": reveal the next batch of hidden cards (STEP at a time). Once
  // every card is visible, the button flips to "See less", which re-hides all
  // cards beyond the default visible count.
  const moreBtn = document.querySelector('[data-work-more]');
  if (moreBtn) {
    const step = Number(moreBtn.getAttribute('data-step')) || 2;
    const visible = Number(moreBtn.getAttribute('data-visible')) || 4;
    const moreLabel = moreBtn.getAttribute('data-more-label') || 'See more';
    const lessLabel = moreBtn.getAttribute('data-less-label') || 'See less';
    const cards = Array.from(document.querySelectorAll('.work .card'));

    moreBtn.addEventListener('click', () => {
      const allVisible = !document.querySelector('.work .card.is-extra');
      if (allVisible) {
        // Collapse back to the default set.
        cards.forEach((card, i) => card.classList.toggle('is-extra', i >= visible));
        moreBtn.textContent = moreLabel;
        moreBtn.scrollIntoView({ block: 'nearest' });
      } else {
        // Reveal the next batch; if that exposes the last card, switch to "See less".
        document.querySelectorAll('.work .card.is-extra').forEach((card, i) => {
          if (i < step) card.classList.remove('is-extra');
        });
        if (!document.querySelector('.work .card.is-extra')) moreBtn.textContent = lessLabel;
      }
    });
  }
</script>

<style>
  .work {
    background: var(--color-section-bg);
    padding-block: var(--space-6) var(--space-5);
    scroll-margin-top: 5rem; /* clear the fixed nav when scrolling to #work */
  }

  /* Centred header: small orange eyebrow over a large bold statement
     (same pattern as the services section). */
  .work-head {
    text-align: center;
    max-width: 56rem;
    margin: 0 auto var(--space-5);
  }
  .work-eyebrow {
    font-family: var(--font-body);
    font-size: var(--fs-h3);
    letter-spacing: 0.04em;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }
  .work-eyebrow .slash { color: var(--color-primary); margin-right: 0.4em; }
  .work-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  /* Projects grid. Phones: a single centred column. */
  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 34rem;
    margin-inline: auto;
  }

  /* "See more" — reveals the next batch of cards. */
  .work-more {
    display: block;
    margin: var(--space-5) auto 0;
    padding: 0.7rem 1.7rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: color 0.25s var(--ease), background 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .work-more:hover {
    border-color: var(--color-muted);
    background: color-mix(in srgb, var(--color-text) 5%, transparent);
  }
  .work-more:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }

  /* Desktop: two equal columns. minmax(0, 1fr) forces them equal regardless of
     the image inside. Hovering one card fades the others back so the eye goes
     to the hovered card; its detail overlay reveals separately (ProjectCard). */
  @media (min-width: 721px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
      max-width: none;
    }
    .work-grid > .card { min-width: 0; transition: opacity 0.45s var(--ease); }
    .work-grid:hover > .card { opacity: 0.35; }
    .work-grid > .card:hover { opacity: 1; }
  }
</style>
