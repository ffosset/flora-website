---
import ProjectCard from './ProjectCard.astro';
const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = t.work.projects || [];

// Per-card visual treatment (colours / layout / blend), keyed by slug.
const DESIGN = {
  'cercle-histoire-forest': { bg: '#efe9e3', fg: '#210f03', layout: 'media-top', hover: '#c7a98a', pill: '#d7c5b3', cta: 'Visit website' },
  'minnow-collective':      { bg: '#124b4b', fg: '#ffffff', layout: 'text-top', centered: true, hover: '#4e9d9d', pill: '#349494', cta: 'Visit website' },
  'soy-de-temporada':       { bg: '#fcf4be', fg: '#210f03', layout: 'text-top', media: 'sm', blend: 'darken', center: true, hover: '#f6e35c', pill: '#f6e35c', cta: 'Visit platform' },
  'rosa-ebilling':          { bg: '#916cb1', fg: '#ffffff', layout: 'text-top', centered: true, hover: '#bf8aed', pill: '#bf8aed', cta: 'Visit website' },
  'neighborhood-map':       { bg: '#d1d5ef', fg: '#210f03', layout: 'media-top', hover: '#7a88ed', pill: '#7a88ed', cta: 'Visit website' },
  'couleur-du-peche':       { bg: '#fce4be', fg: '#210f03', layout: 'media-pad', padded: true, hover: '#f1c173', pill: '#f1c173', cta: 'Read' },
  'oyas-belgique':          { bg: '#dfe7d8', fg: '#210f03', layout: 'media-top', padded: true, hover: '#a8c08f', pill: '#a8c08f', cta: 'Visit website' },
  'rosen':                  { bg: '#ece6e1', fg: '#210f03', layout: 'media-top', hover: '#cdbfb1', pill: '#cdbfb1', cta: 'Read' },
};

// Category order (also the filter order; Landing is the default view). Each
// category shows equal-width columns. SHOW lists exactly which projects to
// display per category, in order (two each for now).
const CATS = ['landing', 'product', 'storytelling'];
const SHOW = {
  landing: ['cercle-histoire-forest', 'soy-de-temporada'],
  product: ['minnow-collective', 'rosa-ebilling'],
  storytelling: ['oyas-belgique', 'couleur-du-peche'],
};

const byCat = CATS.map((cat) => {
  const items = (SHOW[cat] || [])
    .map((slug) => projects.find((p) => p.slug === slug))
    .filter((p) => p && DESIGN[p.slug]);
  return { cat, items };
});
---

<section id="work" class="work">
  <div class="container work-head">
    <h2 class="work-h2"><span class="slash">·</span>{t.work.sectionTitle}</h2>
    <div class="work-filters" role="group" aria-label="Filter projects">
      {CATS.map((k, i) => (
        <button type="button" class="filter" data-filter={k} aria-pressed={i === 0 ? 'true' : 'false'}>
          {t.work.filters[k]}
        </button>
      ))}
    </div>
  </div>

  <div class="container">
    {byCat.map(({ cat, items }, i) => (
      <div class:list={['work-cat', { 'is-shown': i === 0 }]} data-cat={cat}>
        {items.map((p) => <ProjectCard c={p} d={DESIGN[p.slug]} base={base} />)}
      </div>
    ))}

    <button type="button" class="work-back" data-work-back>
      <span aria-hidden="true">↑</span> Other categories
    </button>
  </div>
</section>

<script>
  // Desktop: the detail reveals on hover/focus (CSS).
  // Mobile: a "read more" button expands it inline below the card body.
  document.querySelectorAll('.work .card').forEach((card) => {
    const moreBtn = card.querySelector('[data-more]');
    if (!moreBtn) return;
    moreBtn.addEventListener('click', () => {
      const open = !card.classList.contains('is-open');
      card.classList.toggle('is-open', open);
      moreBtn.setAttribute('aria-expanded', String(open));
      moreBtn.textContent = open ? 'Read less' : 'Read more';
    });
  });
</script>

<script>
  // Category filtering. One category is shown at a time (Landing by default).
  // Driven by the filter buttons and by the Services cards (which dispatch a
  // 'work:filter' event before scrolling to #work).
  const fbtns = Array.from(document.querySelectorAll('.work-filters .filter'));
  const cats = Array.from(document.querySelectorAll('.work-cat'));
  if (fbtns.length && cats.length) {
    const apply = (cat) => {
      if (!cats.some((c) => c.dataset.cat === cat)) return;
      fbtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === cat)));
      cats.forEach((c) => c.classList.toggle('is-shown', c.dataset.cat === cat));
    };
    fbtns.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter)));
    document.addEventListener('work:filter', (e) => apply(e.detail));
  }

  // Mobile: scroll back up to the filters to pick another category.
  const backBtn = document.querySelector('[data-work-back]');
  const work = document.getElementById('work');
  if (backBtn && work) {
    backBtn.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      work.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    });
  }
</script>

<style>
  .work {
    background: var(--color-section-bg);
    padding-block: var(--space-6) var(--space-5);
    scroll-margin-top: 5rem; /* clear the fixed nav when scrolling back up */
  }

  /* "Other categories" — discreet jump back to the filters (mobile only). */
  .work-back { display: none; }

  /* Title with the filters sitting right beside it. */
  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-bottom: var(--space-4);
  }
  .work-h2 {
    font-size: var(--fs-section);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  /* Filter pills. */
  .work-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .filter {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition: color 0.25s var(--ease), background 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .filter:hover { color: var(--color-text); border-color: var(--color-muted); }
  .filter:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  /* Selected chip fills with its category colour. */
  .filter[data-filter='landing'][aria-pressed='true'] {
    background: var(--cat-landing);
    border-color: var(--cat-landing);
    color: var(--color-text);
  }
  .filter[data-filter='product'][aria-pressed='true'] {
    background: var(--cat-product);
    border-color: var(--cat-product);
    color: var(--color-text);
  }
  .filter[data-filter='storytelling'][aria-pressed='true'] {
    background: var(--cat-storytelling);
    border-color: var(--cat-storytelling);
    color: var(--color-text);
  }

  /* One category shown at a time. Phones: a single centred column. */
  .work-cat { display: none; }
  .work-cat.is-shown {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (max-width: 720px) {
    .work-cat { max-width: 34rem; margin-inline: auto; }

    /* Filters: one line, horizontally scrollable, a little bigger for tapping. */
    .work-head { gap: var(--space-3); }
    .work-filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      width: 100%;
    }
    .work-filters::-webkit-scrollbar { display: none; }
    .filter {
      flex: 0 0 auto;
      font-size: 1.05rem;
      padding: 0.65rem 1.3rem;
    }

    /* Discreet jump back to the filters. */
    .work-back {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      width: fit-content;
      margin: var(--space-5) auto 0;
      padding: 0.55rem 1.2rem;
      font-family: var(--font-body);
      font-size: 0.9rem;
      color: var(--color-muted);
      background: transparent;
      border: 1px solid var(--color-line);
      border-radius: var(--radius-pill);
      cursor: pointer;
    }
  }

  /* Desktop: two equal columns. minmax(0, 1fr) forces them equal regardless of
     the image inside. Hovering a card widens it (grid transition) and dims the
     other. */
  @media (min-width: 721px) {
    .work-cat.is-shown {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
    }
    /* Equal-width cards (no size change on hover). Hovering one fades the
       other back so the eye goes to the hovered card; its detail overlay
       reveals separately (see ProjectCard). */
    .work-cat > .card { min-width: 0; transition: opacity 0.45s var(--ease); }
    .work-cat:hover > .card { opacity: 0.35; }
    .work-cat > .card:hover { opacity: 1; }
  }
</style>
