---
const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const bySlug = Object.fromEntries((t.work.projects || []).map((p) => [p.slug, p]));

// Per-card visual treatment (colours/layout/blend), keyed by slug to match the
// Figma. Only the slugs listed in `columns` are rendered.
const DESIGN = {
  'cercle-histoire-forest': { bg: '#efe9e3', fg: '#210f03', layout: 'media-top' },
  'minnow-collective':      { bg: '#124b4b', fg: '#ffffff', layout: 'text-top', media: 'full', round: true },
  'soy-de-temporada':       { bg: '#fcf4be', fg: '#210f03', layout: 'text-top', media: 'sm', blend: 'darken', center: true },
  'rosa-ebilling':          { bg: '#916cb1', fg: '#ffffff', layout: 'text-top', media: 'md', blend: 'lighten', center: true },
  'neighborhood-map':       { bg: '#d1d5ef', fg: '#210f03', layout: 'media-top' },
  'couleur-du-peche':       { bg: '#fce4be', fg: '#210f03', layout: 'media-pad', round: true },
};
const columns = [
  ['cercle-histoire-forest', 'minnow-collective'],
  ['soy-de-temporada', 'rosa-ebilling'],
  ['neighborhood-map', 'couleur-du-peche'],
];
---

<section id="work" class="work">
  <div class="container work-head">
    <h2 class="work-h2"><span class="slash">·</span>{t.work.sectionTitle}</h2>
    <p class="intro">{t.work.intro}</p>
  </div>

  <div class="container">
    <div class="work-grid">
      {columns.map((colSlugs) => (
        <div class="work-col">
          {colSlugs.map((slug) => {
            const c = bySlug[slug];
            if (!c) return null;
            const d = DESIGN[slug];
            const hasUrl = Boolean(c.url);
            const isExternal = hasUrl && c.url.startsWith('http');
            const href = hasUrl ? (isExternal ? c.url : base + c.url) : undefined;
            const Tag = hasUrl ? 'a' : 'article';
            const textTop = d.layout === 'text-top';
            const Media = (
              <div class="card-media">
                <img src={base + c.image} alt={c.subtitle} loading="lazy" />
              </div>
            );
            const Text = (
              <div class="card-body">
                {textTop && <span class="card-tag">{c.tag}</span>}
                <div class="card-text">
                  <h3 class="card-title">{c.title}</h3>
                  <p class="card-client">{c.subtitle}</p>
                </div>
                {!textTop && <span class="card-tag">{c.tag}</span>}
              </div>
            );
            return (
              <Tag
                class:list={[
                  'card',
                  `card--${d.layout}`,
                  d.blend && `card--blend-${d.blend}`,
                  d.media && `card--media-${d.media}`,
                  { 'card--center': d.center, 'card--round': d.round, 'is-link': hasUrl },
                ]}
                style={`--bg:${d.bg}; --fg:${d.fg}`}
                href={href}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
                data-cats={(c.category || []).join(' ')}
              >
                {textTop ? <>{Text}{Media}</> : <>{Media}{Text}</>}
              </Tag>
            );
          })}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .work { padding-block: var(--space-6) var(--space-5); }

  .work-head { margin-bottom: var(--space-5); }
  .work-h2 {
    font-size: var(--fs-hero);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .intro {
    color: var(--color-muted);
    max-width: 50ch;
    margin-top: var(--space-2);
  }

  /* Three-column masonry; the middle column rides a little higher. */
  .work-grid {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
  }
  .work-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-width: 0;
  }
  .work-col:nth-child(1),
  .work-col:nth-child(3) { margin-top: 4.5rem; }

  /* --- Card --- */
  .card {
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg);
    color: var(--fg);
    text-decoration: none;
    box-shadow: 0 4px 10px rgba(196, 196, 196, 0.12);
    transition: box-shadow 0.25s var(--ease);
  }
  .card.is-link:hover { box-shadow: 0 10px 26px rgba(33, 15, 3, 0.16); }

  .card-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .card-text { display: flex; flex-direction: column; gap: 0.75rem; }
  .card-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 1.1rem + 1.1vw, 2rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--fg); /* override the global h3 colour so dark cards read white */
  }
  .card-client {
    font-family: var(--font-body); /* Fira Code, like the design */
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: clamp(0.95rem, 0.85rem + 0.35vw, 1.25rem);
  }
  .card-tag {
    align-self: flex-start;
    background: color-mix(in srgb, var(--fg) 13%, transparent);
    color: var(--fg);
    padding: 0.35rem 0.8rem;
    border-radius: 50px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
  }

  /* media-top: full-bleed image, padded text below. */
  .card--media-top { gap: 2.5rem; }
  .card--media-top .card-body { padding: 0 2.5rem 2rem; }

  /* media-pad: padded, rounded image then text. */
  .card--media-pad { gap: 2.5rem; padding: 2rem 2.5rem; }

  /* text-top: padded text then image below. */
  .card--text-top { gap: 2.5rem; padding: 2rem 2.5rem; }

  .card--round .card-media { border-radius: 11px; overflow: hidden; }
  .card--center .card-body { align-items: center; text-align: center; }
  .card--center .card-tag { align-self: center; }

  /* image sizing for text-top cards */
  .card--media-sm .card-media { width: 60%; margin-inline: auto; }
  .card--media-md .card-media { width: 86%; margin-inline: auto; }
  .card--blend-darken .card-media img { mix-blend-mode: darken; }
  .card--blend-lighten .card-media img { mix-blend-mode: lighten; }

  /* Collapse to a single column below desktop. */
  @media (max-width: 980px) {
    .work-grid { flex-direction: column; }
    .work-col { margin-top: 0; }
    .work-col:nth-child(1),
    .work-col:nth-child(3) { margin-top: 0; }
    .card { max-width: 34rem; }
  }
</style>
