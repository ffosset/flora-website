---
const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const bySlug = Object.fromEntries((t.work.projects || []).map((p) => [p.slug, p]));

// Per-card visual treatment (colours/layout/blend), keyed by slug to match the
// Figma. Only the slugs listed in `columns` are rendered.
const DESIGN = {
  'cercle-histoire-forest': { bg: '#efe9e3', fg: '#210f03', layout: 'media-top', hover: '#c7a98a', pill: '#d7c5b3', cta: 'Visit website' },
  'minnow-collective':      { bg: '#124b4b', fg: '#ffffff', layout: 'text-top', media: 'full', round: true, hover: '#4e9d9d', pill: '#349494', cta: 'Visit website' },
  'soy-de-temporada':       { bg: '#fcf4be', fg: '#210f03', layout: 'text-top', media: 'sm', blend: 'darken', center: true, hover: '#f6e35c', pill: '#f6e35c', cta: 'Visit platform' },
  'rosa-ebilling':          { bg: '#916cb1', fg: '#ffffff', layout: 'text-top', media: 'md', blend: 'lighten', center: true, hover: '#bf8aed', pill: '#bf8aed', cta: 'Visit website' },
  'neighborhood-map':       { bg: '#d1d5ef', fg: '#210f03', layout: 'media-top', hover: '#7a88ed', pill: '#7a88ed', cta: 'Visit website' },
  'couleur-du-peche':       { bg: '#fce4be', fg: '#210f03', layout: 'media-pad', round: true, hover: '#f1c173', pill: '#f1c173', cta: 'Read' },
};
// Column-major order so the multi-column masonry fills as in the design.
const order = [
  'cercle-histoire-forest', 'minnow-collective',
  'soy-de-temporada', 'rosa-ebilling',
  'neighborhood-map', 'couleur-du-peche',
];
---

<section id="work" class="work">
  <div class="container work-head">
    <h2 class="work-h2"><span class="slash">·</span>{t.work.sectionTitle}</h2>
  </div>

  <div class="container">
    <div class="work-grid">
      {order.map((slug) => {
            const c = bySlug[slug];
            if (!c) return null;
            const d = DESIGN[slug];
            const hasUrl = Boolean(c.url);
            const isExternal = hasUrl && c.url.startsWith('http');
            const href = hasUrl ? (isExternal ? c.url : base + c.url) : undefined;
            const textTop = d.layout === 'text-top';
            const Media = (
              <div class="card-media">
                <img src={base + c.image} alt={c.subtitle} loading="lazy" />
              </div>
            );
            const Text = (
              <div class="card-body">
                {textTop && <span class="card-tag">{c.tag}</span>}
                <div class="card-text">
                  <h3 class="card-title">{c.title}</h3>
                  <p class="card-client">{c.subtitle}</p>
                </div>
                {!textTop && <span class="card-tag">{c.tag}</span>}
              </div>
            );
            return (
              <article
                class:list={[
                  'card',
                  `card--${d.layout}`,
                  d.blend && `card--blend-${d.blend}`,
                  d.media && `card--media-${d.media}`,
                  { 'card--center': d.center, 'card--round': d.round },
                ]}
                style={`--bg:${d.bg}; --fg:${d.fg}; --hover:${d.hover}; --pill:${d.pill}`}
                data-cats={(c.category || []).join(' ')}
                role={!hasUrl ? 'button' : undefined}
                tabindex={!hasUrl ? '0' : undefined}
                aria-expanded={!hasUrl ? 'false' : undefined}
                aria-controls={!hasUrl ? `hover-${slug}` : undefined}
              >
                {textTop ? <>{Text}{Media}</> : <>{Media}{Text}</>}

                <div class="card-hover" id={`hover-${slug}`}>
                  <div class="hover-main">
                    {c.year && <p class="hover-year">{c.year}</p>}
                    {c.did && (
                      <div class="hover-block">
                        <p class="hover-label">My role</p>
                        <p class="hover-role">{c.did}</p>
                      </div>
                    )}
                    {c.result && (
                      <div class="hover-block">
                        <p class="hover-label">Result</p>
                        <p class="hover-result">{c.result}</p>
                      </div>
                    )}
                  </div>
                  {hasUrl && (
                    <a
                      class="hover-cta"
                      href={href}
                      target={isExternal ? '_blank' : undefined}
                      rel={isExternal ? 'noopener noreferrer' : undefined}
                    >
                      {d.cta}
                      {isExternal && <span class="sr-only"> (opens in new tab)</span>}
                    </a>
                  )}
                </div>
              </article>
            );
          })}
    </div>
  </div>
</section>

<script>
  // Desktop: the overlay reveals on hover/focus (CSS). Mobile (and no-url
  // button cards): a click/Enter/Space opens it at the bottom of the card.
  const mq = window.matchMedia('(max-width: 720px)');
  document.querySelectorAll('.work .card').forEach((card) => {
    const isButton = card.getAttribute('role') === 'button';
    const setOpen = (open) => {
      card.classList.toggle('is-open', open);
      if (isButton) card.setAttribute('aria-expanded', String(open));
    };
    card.addEventListener('click', (e) => {
      if (e.target.closest('.hover-cta')) return; // let the CTA link navigate
      if (isButton) return setOpen(!card.classList.contains('is-open'));
      if (mq.matches) setOpen(!card.classList.contains('is-open'));
    });
    if (isButton) {
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          setOpen(!card.classList.contains('is-open'));
        }
      });
    }
  });
</script>

<style>
  .work { padding-block: var(--space-6) var(--space-5); }

  .work-head { margin-bottom: var(--space-4); }
  .work-h2 {
    font-size: var(--fs-hero);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  /* Masonry via CSS multi-column: 3 → 2 → 1 as the screen narrows. */
  .work-grid {
    column-count: 3;
    column-gap: 2rem;
  }
  .work-grid > .card {
    break-inside: avoid;
    margin-bottom: 2rem;
  }

  /* --- Card --- */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg);
    color: var(--fg);
    text-decoration: none;
    box-shadow: 0 4px 10px rgba(196, 196, 196, 0.12);
  }
  .card[role='button'] { cursor: pointer; }
  .card[role='button']:focus-visible,
  .hover-cta:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Hover / expanded detail. */
  .card-hover {
    font-family: var(--font-display);
    background: var(--hover);
    color: #210f03;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem 2.5rem;
  }
  .hover-main { display: flex; flex-direction: column; gap: 2rem; }
  .hover-year {
    text-align: right;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 1rem;
  }
  .hover-block { display: flex; flex-direction: column; gap: 0.5rem; }
  .hover-label { text-transform: uppercase; letter-spacing: 0.06em; font-size: 1rem; }
  .hover-role { font-size: 1.25rem; line-height: 1.4; }
  .hover-result { font-size: 1.25rem; line-height: 1.4; font-weight: 700; }
  .hover-cta {
    align-self: flex-start;
    background: #210f03;
    color: var(--pill);
    padding: 0.6rem 1rem;
    border-radius: 50px;
    font-weight: 500;
    font-size: 1rem;
    text-decoration: none;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .card-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .card-text { display: flex; flex-direction: column; gap: 0.75rem; }
  .card-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 1.1rem + 1.1vw, 2rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--fg); /* override the global h3 colour so dark cards read white */
  }
  .card-client {
    font-family: var(--font-body); /* Fira Code, like the design */
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: clamp(0.95rem, 0.85rem + 0.35vw, 1.25rem);
  }
  .card-tag {
    align-self: flex-start;
    background: color-mix(in srgb, var(--fg) 13%, transparent);
    color: var(--fg);
    padding: 0.35rem 0.8rem;
    border-radius: 50px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
  }

  /* media-top: full-bleed image, padded text below. */
  .card--media-top { gap: 2.5rem; }
  .card--media-top .card-body { padding: 0 2.5rem 2rem; }

  /* media-pad: padded, rounded image then text. */
  .card--media-pad { gap: 2.5rem; padding: 2rem 2.5rem; }

  /* text-top: padded text then image below. */
  .card--text-top { gap: 2.5rem; padding: 2rem 2.5rem; }

  .card--round .card-media { border-radius: 11px; overflow: hidden; }
  .card--center .card-body { align-items: center; text-align: center; }
  .card--center .card-tag { align-self: center; }

  /* image sizing for text-top cards */
  .card--media-sm .card-media { width: 60%; margin-inline: auto; }
  .card--media-md .card-media { width: 86%; margin-inline: auto; }
  .card--blend-darken .card-media img { mix-blend-mode: darken; }
  .card--blend-lighten .card-media img { mix-blend-mode: lighten; }

  /* Two columns on mid widths. */
  @media (max-width: 1100px) {
    .work-grid { column-count: 2; }
  }

  /* Pointer screens: the detail is an overlay that slides DOWN over the card
     on hover / focus (or when a no-url button card is toggled open). */
  @media (min-width: 721px) {
    .card-hover {
      position: absolute;
      inset: 0;
      z-index: 2;
      overflow: auto;
      justify-content: space-between;
      transform: translateY(-100%);
      transition: transform 0.4s var(--ease);
    }
    .card:hover .card-hover,
    .card:focus-within .card-hover,
    .card.is-open .card-hover { transform: translateY(0); }
  }

  /* Phones: one column; tapping a card opens the detail at the bottom. */
  @media (max-width: 720px) {
    .work-grid { column-count: 1; }
    .work-grid > .card { max-width: 34rem; margin-inline: auto; }

    .card-hover {
      max-height: 0;
      padding-block: 0;
      overflow: hidden;
      transition: max-height 0.4s var(--ease), padding 0.4s var(--ease);
    }
    .card.is-open .card-hover,
    .card:focus-within .card-hover {
      max-height: 60rem;
      padding-block: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-hover { transition: none; }
  }
</style>
