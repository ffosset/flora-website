---
const { t } = Astro.props;
const items = t.services.items || [];
// Category colour per card, in card order (drives name colour + hard shadow).
const CATS = ['landing', 'product', 'storytelling'];
---

<section id="services" class="services">
  <div class="container">
    <header class="services-head">
      <p class="services-eyebrow"><span class="slash">·</span>{t.services.sectionTitle}</p>
      <h2 class="services-title">{t.services.sectionSubtitle}</h2>
    </header>

    <div class="services-list">
      {items.map((s, i) => (
        <div class="service" data-cat={CATS[i]} style={`--cat: var(--cat-${CATS[i]})`}>
          <h3 class="service-name">{s.name}</h3>
          <p class="service-desc">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--color-section-bg);
    color: var(--color-text);
  }

  /* Centred header: small orange eyebrow over a large bold statement. */
  .services-head {
    text-align: center;
    max-width: 56rem;
    margin: 0 auto var(--space-block);
  }
  .services-eyebrow {
    font-family: var(--font-body);
    font-size: var(--fs-h4);
    letter-spacing: 0.04em;
    color: var(--color-primary);
    margin-bottom: var(--space-element);
  }
  .services-eyebrow .slash { color: var(--color-primary); margin-right: 0.4em; }
  .services-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  /* Mobile-first, mirroring the projects grid's breakpoints (721 / 1024) so the
     two sections reflow in step: one centred column → two → three. */
  .services-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-block) var(--space-3); /* row = sub-block; col unchanged (horizontal) */
    max-width: 38rem;
    margin-inline: auto;
  }

  /* Static card: soft tint of the category colour (matching the project cards
     at rest) with an always-on hard offset shadow in the category colour. Not
     interactive — no hover, no cursor change. */
  .service {
    display: flex;
    flex-direction: column;
    gap: var(--space-line); /* name -> desc, within the card text block */
    min-width: 0;
    padding: 2rem; /* match the project cards' text inset */
    border-radius: 4px;
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--cat) 13%, #ffffff),
      color-mix(in srgb, var(--cat) 30%, #ffffff)
    );
    text-align: left;
    box-shadow: 8px 8px 0 0 var(--cat);
  }

  /* Name in the dark text colour, lowercase, with a trailing bullet in the
     category colour. */
  .service-name {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: lowercase;
    font-size: var(--fs-h3);
    line-height: 1.2;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
    color: var(--color-text);
  }
  .service-name::after { content: ' ·'; color: var(--cat); }

  .service-desc {
    font-family: var(--font-display);
    color: var(--color-text);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  /* Phones: tighter inset, matching the project cards. */
  @media (max-width: 720px) {
    .service { padding: 1.25rem; }
  }

  /* Tablet: two columns (minmax(0,…) lets them shrink below content width so the
     row never overflows). */
  @media (min-width: 721px) {
    .services-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: none;
    }
  }
  /* Desktop: all three side by side. */
  @media (min-width: 1024px) {
    .services-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
