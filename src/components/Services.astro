---
const { t } = Astro.props;
const items = t.services.items || [];
// Category colour per card, in card order (drives name colour + hard shadow).
const CATS = ['landing', 'product', 'storytelling'];
---

<section id="services" class="services">
  <div class="container">
    <header class="services-head">
      <p class="services-eyebrow"><span class="slash">·</span>{t.services.sectionTitle}</p>
      <h2 class="services-title">{t.services.sectionSubtitle}</h2>
    </header>

    <div class="services-list">
      {items.map((s, i) => (
        <div class="service" data-cat={CATS[i]} style={`--cat: var(--cat-${CATS[i]})`}>
          <h3 class="service-name">{s.name}</h3>
          <p class="service-desc">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--color-section-bg);
    color: var(--color-text);
  }

  /* Centred header: small orange eyebrow over a large bold statement. */
  .services-head {
    text-align: center;
    max-width: 56rem;
    margin: 0 auto var(--space-5);
  }
  .services-eyebrow {
    font-family: var(--font-body);
    font-size: var(--fs-h4);
    letter-spacing: 0.04em;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }
  .services-eyebrow .slash { color: var(--color-primary); margin-right: 0.4em; }
  .services-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .services-list {
    list-style: none;
    display: grid;
    /* minmax(0,…) lets the columns shrink below the cards' content so the row
       never overflows the viewport at mid widths. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  /* Static card: peach panel with an always-on hard offset shadow in the
     category colour. Not interactive — no hover, no cursor change. */
  .service {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-4);
    border-radius: 4px;
    background: #faf0ea; /* soft peach */
    text-align: left;
    box-shadow: 8px 8px 0 0 var(--cat);
  }

  /* Name in the category colour, lowercase, with a trailing bullet. */
  .service-name {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: lowercase;
    font-size: var(--fs-h3);
    line-height: 1.1;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
    color: var(--cat);
  }
  .service-name::after { content: ' ·'; }
  /* Landing's bright yellow is illegible as text, so use a deeper amber for
     the name + bullet (the shadow stays bright yellow). */
  .service[data-cat='landing'] .service-name { color: #c2890c; }

  .service-desc {
    font-family: var(--font-display);
    color: var(--color-text);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  /* Below ~1150px the three cards no longer fit side by side — stack them
     into one centred column. */
  @media (max-width: 1150px) {
    .services-list {
      grid-template-columns: 1fr;
      max-width: 38rem;
      margin-inline: auto;
    }
  }
</style>
