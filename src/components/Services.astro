---
const { t } = Astro.props;
const items = t.services.items || [];
---

<section id="services" class="services">
  <div class="container">
    <h2 class="services-title"><span class="slash">·</span>{t.services.sectionTitle}</h2>

    <ul class="services-list">
      {items.map((s, i) => (
        <li class="service">
          <span class="service-num">{String(i + 1).padStart(2, '0')}</span>
          <div class="service-body">
            <h3 class="service-name">{s.name}</h3>
            <p class="service-desc">{s.desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* A bold primary block that punctuates the light hero / work sections. */
  .services {
    background: var(--color-primary);
    color: var(--color-ink-on-primary);
  }

  .services-title {
    font-size: var(--fs-hero);
    line-height: 1;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: var(--space-5);
  }
  /* The slash is orange-on-light elsewhere; on this orange ground it needs a
     light accent to stay visible. */
  .services-title .slash { color: var(--color-secondary); }

  .services-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  /* Glass card: number pinned to the top, name + copy anchored to the bottom. */
  .service {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 17rem;
    padding: var(--space-4);
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.22);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    transition: transform 0.35s var(--ease), background 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }
  .service:hover {
    transform: translateY(-6px);
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .service-num {
    font-family: var(--font-body); /* Fira Code, like the rest of the labels */
    font-size: var(--fs-small);
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.6);
  }
  .service-body { display: flex; flex-direction: column; gap: var(--space-2); }
  .service-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: #ffffff;
  }
  .service-desc {
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  /* Stack on narrow screens. */
  @media (max-width: 860px) {
    .services-list { grid-template-columns: 1fr; gap: var(--space-3); }
    .service { min-height: 0; gap: var(--space-4); }
  }

  @media (prefers-reduced-motion: reduce) {
    .service { transition: none; }
    .service:hover { transform: none; }
  }
</style>
