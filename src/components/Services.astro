---
const { t } = Astro.props;
const items = t.services.items || [];
// Each service maps to a projects-grid filter, in card order.
const FILTERS = ['landing', 'product', 'storytelling'];
---

<section id="services" class="services">
  <div class="container">
    <h2 class="services-title"><span class="slash">·</span>{t.services.sectionTitle}</h2>

    <div class="services-list">
      {items.map((s, i) => (
        <div
          class="service"
          role="button"
          tabindex="0"
          data-filter={FILTERS[i]}
          aria-label={`Show ${s.name} projects`}
        >
          {i === 0 && (
            <svg class="service-icon" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
              <rect class="s-draw" pathLength="1" x="14" y="24" width="92" height="72" />
              <line class="s-draw" pathLength="1" x1="14" y1="42" x2="106" y2="42" />
              <g fill="currentColor" stroke="none">
                <circle class="s-pop" cx="22" cy="33" r="2.5" />
                <circle class="s-pop" cx="30" cy="33" r="2.5" />
                <circle class="s-pop" cx="38" cy="33" r="2.5" />
              </g>
              <rect class="s-draw" pathLength="1" x="24" y="50" width="72" height="22" />
              <line class="s-draw" pathLength="1" x1="24" y1="80" x2="84" y2="80" />
              <rect class="s-draw" pathLength="1" x="24" y="86" width="28" height="9" />
            </svg>
          )}
          {i === 1 && (
            <svg class="service-icon" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
              <defs>
                <marker id="flow-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                  <path d="M2 1 L8 5 L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </marker>
              </defs>
              <g>
                <rect class="s-draw" pathLength="1" x="8" y="28" width="26" height="24" />
                <line class="s-draw" pathLength="1" x1="12" y1="35" x2="30" y2="35" />
                <line class="s-draw" pathLength="1" x1="12" y1="41" x2="24" y2="41" />
              </g>
              <g>
                <rect class="s-draw" pathLength="1" x="46" y="28" width="26" height="24" />
                <line class="s-draw" pathLength="1" x1="50" y1="35" x2="68" y2="35" />
                <line class="s-draw" pathLength="1" x1="50" y1="41" x2="62" y2="41" />
              </g>
              <g>
                <rect class="s-draw" pathLength="1" x="84" y="28" width="26" height="24" />
                <line class="s-draw" pathLength="1" x1="88" y1="35" x2="106" y2="35" />
                <line class="s-draw" pathLength="1" x1="88" y1="41" x2="100" y2="41" />
              </g>
              <g>
                <rect class="s-draw" pathLength="1" x="46" y="74" width="26" height="24" />
                <line class="s-draw" pathLength="1" x1="50" y1="81" x2="68" y2="81" />
                <line class="s-draw" pathLength="1" x1="50" y1="87" x2="60" y2="87" />
              </g>
              <line class="s-pop" x1="34" y1="40" x2="44" y2="40" marker-end="url(#flow-arrow)" />
              <line class="s-pop" x1="72" y1="40" x2="82" y2="40" marker-end="url(#flow-arrow)" />
              <line class="s-pop" x1="59" y1="52" x2="59" y2="72" marker-end="url(#flow-arrow)" />
            </svg>
          )}
          {i === 2 && (
            <svg class="service-icon" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
              <g>
                <path class="s-draw" pathLength="1" d="M40 26 L24 26 L24 40" />
                <path class="s-draw" pathLength="1" d="M80 26 L96 26 L96 40" />
                <path class="s-draw" pathLength="1" d="M24 80 L24 94 L40 94" />
                <path class="s-draw" pathLength="1" d="M96 80 L96 94 L80 94" />
              </g>
              <path class="s-draw" pathLength="1" d="M40 52 L60 42 L80 52 L60 62 Z" />
              <circle class="s-pop" cx="60" cy="52" r="4" fill="currentColor" stroke="none" />
              <line class="s-draw" pathLength="1" x1="38" y1="74" x2="82" y2="74" />
              <line class="s-draw" pathLength="1" x1="38" y1="82" x2="64" y2="82" />
            </svg>
          )}
          <div class="service-body">
            <h3 class="service-name">{s.name}</h3>
            <p class="service-desc">{s.desc}</p>
            <span class="service-go" aria-hidden="true">View projects →</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Clicking a service filters the projects grid and scrolls to it.
  document.querySelectorAll('.services .service[data-filter]').forEach((card) => {
    const go = () => {
      document.dispatchEvent(
        new CustomEvent('work:filter', { detail: card.dataset.filter })
      );
      const work = document.getElementById('work');
      if (work) {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        work.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      }
    };
    card.addEventListener('click', go);
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        go();
      }
    });
  });

  // Build the three icons (stroke-draw) the first time the section is in view.
  // All three animate together; each draws itself.
  const section = document.querySelector('.services');
  if (section) {
    const reveal = () => section.classList.add('is-drawn');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) { reveal(); io.disconnect(); } }),
        { threshold: 0.3 }
      );
      io.observe(section);
    } else {
      reveal();
    }
  }
</script>

<style>
  /* A bold primary block that punctuates the light hero / work sections. */
  .services {
    background: var(--color-primary);
    color: var(--color-ink-on-primary);
  }

  .services-title {
    font-size: var(--fs-section);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-bottom: var(--space-5);
  }
  /* The slash is orange-on-light elsewhere; on this orange ground it needs a
     light accent to stay visible. */
  .services-title .slash { color: var(--color-secondary); }

  .services-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  /* Glass card (acts as a filter button): number pinned to the top,
     name + copy anchored to the bottom. */
  .service {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 17rem;
    padding: var(--space-4);
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.22);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    cursor: pointer;
    text-align: left;
    transition: transform 0.35s var(--ease), background 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }
  .service:hover,
  .service:focus-visible {
    transform: translateY(-6px);
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.4);
  }
  .service:focus-visible { outline: 2px solid #ffffff; outline-offset: 3px; }

  /* "View projects →" hint — appears/strengthens on hover. */
  .service-go {
    margin-top: var(--space-1);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.7);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease), color 0.3s var(--ease);
  }
  .service:hover .service-go,
  .service:focus-visible .service-go {
    opacity: 1;
    transform: translateX(0);
    color: #ffffff;
  }
  @media (prefers-reduced-motion: reduce) {
    .service-go { opacity: 1; transform: none; }
  }

  /* Line-art icon, pinned where the number used to be. */
  .service-icon {
    width: 64px;
    height: 64px;
    display: block;
    color: var(--color-secondary); /* cream, matches the source art */
    overflow: visible;
  }
  /* Self-building animation: strokes draw on, filled bits (dots, arrows) pop in.
     pathLength="1" normalises every shape so they all draw at the same rate. */
  .service-icon .s-draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .service-icon .s-pop {
    opacity: 0;
    transform: scale(0.3);
    transform-box: fill-box;
    transform-origin: center;
  }
  .services.is-drawn .service-icon .s-draw {
    animation: icon-draw 1.2s var(--ease) forwards;
  }
  .services.is-drawn .service-icon .s-pop {
    animation: icon-pop 0.4s var(--ease) 0.9s forwards;
  }
  @keyframes icon-draw { to { stroke-dashoffset: 0; } }
  @keyframes icon-pop { to { opacity: 1; transform: scale(1); } }

  .service-body { display: flex; flex-direction: column; gap: var(--space-2); }
  .service-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: #ffffff;
  }
  .service-desc {
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  /* Stack on narrow screens. */
  @media (max-width: 860px) {
    .services-list { grid-template-columns: 1fr; gap: var(--space-3); }
    .service { min-height: 0; gap: var(--space-4); }
  }

  @media (prefers-reduced-motion: reduce) {
    .service { transition: none; }
    .service:hover { transform: none; }
    /* No build animation — show the icons fully drawn. */
    .service-icon .s-draw { stroke-dashoffset: 0; animation: none; }
    .service-icon .s-pop { opacity: 1; transform: none; animation: none; }
  }
</style>

<!-- Without JS the reveal class is never added; show the icons drawn. -->
<noscript>
  <style>
    .service-icon .s-draw { stroke-dashoffset: 0 !important; }
    .service-icon .s-pop { opacity: 1 !important; transform: none !important; }
  </style>
</noscript>
