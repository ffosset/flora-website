---
// A single project card: image on top with the hover detail laid over it,
// and the title + company name + sector tag always visible below.
const { c, d, base } = Astro.props;
const hasUrl = Boolean(c.url);
const isExternal = hasUrl && c.url.startsWith('http');
const href = hasUrl ? (isExternal ? c.url : base + c.url) : undefined;
---

<article
  class:list={[
    'card',
    d.blend && `card--blend-${d.blend}`,
    d.media && `card--media-${d.media}`,
  ]}
  style={`--cat: var(--cat-${c.category})`}
  data-cat={c.category}
  role={!hasUrl ? 'button' : undefined}
  tabindex={!hasUrl ? '0' : undefined}
  aria-expanded={!hasUrl ? 'false' : undefined}
  aria-controls={!hasUrl ? `hover-${c.slug}` : undefined}
>
  <div class="card-media">
    <img src={base + c.image} alt={c.subtitle} loading="lazy" />
  </div>

  <div class="card-body">
    <h3 class="card-title">{c.title}</h3>
    <p class="card-meta">
      <span class="card-client">{c.subtitle}</span>
      {c.tag && <span class="card-tag">{c.tag}</span>}
    </p>
    <button
      type="button"
      class="card-more"
      data-more
      aria-expanded="false"
      aria-controls={`hover-${c.slug}`}
    >
      Read more
    </button>
  </div>

  <div class="card-hover" id={`hover-${c.slug}`}>
    <div class="hover-col">
      <p class="hover-label">My role</p>
      <p class="hover-role">{c.did}</p>
    </div>
    <div class="hover-col">
      <p class="hover-label">Result</p>
      <p class="hover-result">{c.result}</p>
      {hasUrl && (
        <a
          class="hover-cta"
          href={href}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
        >
          {d.cta}
          {isExternal && <span class="sr-only"> (opens in new tab)</span>}
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 27rem; /* every card the same height */
    border-radius: 0;
    overflow: hidden;
    /* Soft tint of the category colour. */
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--cat) 13%, #ffffff),
      color-mix(in srgb, var(--cat) 30%, #ffffff)
    );
    color: var(--color-text);
    text-decoration: none;
    box-shadow: 0 4px 10px rgba(196, 196, 196, 0.12);
  }
  .card[role='button'] { cursor: pointer; }
  .card[role='button']:focus-visible,
  .hover-cta:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* --- Media (top): fills the space above the body; hover detail overlays it. */
  .card-media {
    position: relative;
    flex: 0 0 16rem; /* fixed image area, same on every card */
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .card-media img { display: block; }
  /* Photos cover the media area; blended illustrations stay contained. */
  .card:not(.card--blend-darken):not(.card--blend-lighten) .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card--blend-darken .card-media img,
  .card--blend-lighten .card-media img {
    max-width: 86%;
    max-height: 80%;
    width: auto;
    height: auto;
  }
  .card--media-sm .card-media img { max-width: 64%; }
  .card--blend-darken .card-media img { mix-blend-mode: darken; }
  .card--blend-lighten .card-media img { mix-blend-mode: lighten; }

  /* --- Body: title + company name + sector tag, always visible. */
  .card-body {
    flex: 1 1 auto; /* fills the remaining height — same text area on every card */
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.5rem 2rem 2rem;
  }
  .card-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.3rem, 1.05rem + 0.9vw, 1.85rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  /* Company name + tag sit together (one sector per client). */
  .card-meta { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .card-client {
    font-family: var(--font-body); /* Fira Code */
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: clamp(0.8rem, 0.72rem + 0.3vw, 1rem);
    color: var(--color-text);
  }
  /* "Read more" — only on touch / narrow screens (see media query). */
  .card-more {
    display: none;
    align-self: flex-start;
    margin-top: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text);
    background: none;
    border: 1px solid color-mix(in srgb, var(--color-text) 25%, transparent);
    border-radius: 3px;
    padding: 0.35rem 0.8rem;
    cursor: pointer;
  }

  /* Tag: distinct from the filter chips — squared-off, monospace. */
  .card-tag {
    font-family: var(--font-body);
    font-size: 0.8rem;
    line-height: 1.3;
    padding: 0.25rem 0.55rem;
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-text) 8%, transparent);
    color: var(--color-muted);
    white-space: nowrap;
  }

  /* --- Hover detail, over the media only. */
  .card-hover {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 16rem; /* covers the image area on pointer devices */
    z-index: 2;
    display: flex;
    gap: var(--space-4);
    padding: var(--space-4) 2rem;
    overflow: auto;
    background: color-mix(in srgb, var(--cat) 93%, transparent);
    color: #210f03;
    font-family: var(--font-display);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s var(--ease);
  }
  .card:hover .card-hover,
  .card:focus-within .card-hover,
  .card.is-open .card-hover { opacity: 1; pointer-events: auto; }

  .hover-col { flex: 1 1 0; min-width: 0; }
  .hover-col + .hover-col {
    border-left: 1.5px solid color-mix(in srgb, #210f03 28%, transparent);
    padding-left: var(--space-4);
  }
  .hover-label {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.9rem;
    margin-bottom: 0.6rem;
  }
  .hover-role { font-size: 1.05rem; line-height: 1.4; }
  .hover-result { font-size: 1.05rem; line-height: 1.4; font-weight: 700; margin-bottom: 1.1rem; }
  .hover-cta {
    font-weight: 700;
    color: #210f03;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Phones: the detail is no longer an overlay — a "read more" button expands
     it inline below the title / company name. */
  @media (max-width: 720px) {
    .card { height: auto; }
    .card-more { display: inline-flex; }

    .card-hover {
      position: static;
      height: auto;
      max-height: 0;
      padding-top: 0;
      padding-bottom: 0;
      overflow: hidden;
      opacity: 1;
      pointer-events: auto;
      flex-direction: column;
      gap: var(--space-3);
      transition: max-height 0.4s var(--ease), padding 0.4s var(--ease);
    }
    .card.is-open .card-hover {
      max-height: 45rem;
      padding-top: var(--space-4);
      padding-bottom: var(--space-4);
    }
    .hover-col + .hover-col {
      border-left: 0;
      border-top: 1.5px solid color-mix(in srgb, #210f03 28%, transparent);
      padding-left: 0;
      padding-top: var(--space-3);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card-hover { transition: none; }
  }
</style>
