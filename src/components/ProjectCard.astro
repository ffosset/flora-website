---
// A single project card. Idle: image on top, then type + year pills, the
// title, and the client name. Hover fills the whole card with the category
// colour and reveals the result, keywords, a CTA and the client name.
// `labels` carries the translated UI strings (with English fallbacks).
const { c, d, base, labels = {}, service } = Astro.props;
const readMore = labels.readMore ?? 'Read more';
const readLess = labels.readLess ?? 'Read less';
const newTab = labels.newTab ?? 'opens in new tab';
const hasUrl = Boolean(c.url);
const isExternal = hasUrl && c.url.startsWith('http');
const href = hasUrl ? (isExternal ? c.url : base + c.url) : undefined;
---

<article
  class="card"
  style={`--cat: var(--cat-${c.category})`}
  data-cat={c.category}
  role={!hasUrl ? 'button' : undefined}
  tabindex={!hasUrl ? '0' : undefined}
  aria-expanded={!hasUrl ? 'false' : undefined}
  aria-controls={!hasUrl ? `hover-${c.slug}` : undefined}
>
  <div class="card-media">
    <img src={base + c.image} alt={c.subtitle} loading="lazy" />
  </div>

  <div class="card-body">
    <p class="card-pills">
      {service && <span class="card-type">{service}</span>}
      {c.year && <span class="card-year">{c.year}</span>}
      {c.awards && c.awards.length > 0 && (
        <span class="card-award" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 4h10v5a5 5 0 0 1-10 0V4z" />
            <path d="M7 5H4v2a3 3 0 0 0 3 3" />
            <path d="M17 5h3v2a3 3 0 0 1-3 3" />
            <path d="M12 14v3M9 21h6M10 17h4" />
          </svg>
        </span>
      )}
    </p>
    <h3 class="card-title">{c.title}</h3>
    {c.subtitle && <p class="card-client">{c.subtitle}</p>}
    <button
      type="button"
      class="card-more"
      data-more
      data-more-label={readMore}
      data-less-label={readLess}
      aria-expanded="false"
      aria-controls={`hover-${c.slug}`}
    >
      {readMore}
    </button>
  </div>

  <div class="card-hover" id={`hover-${c.slug}`}>
    {/* Keywords as tags on top, then the result metric below. Both optional —
        hide the slot entirely when absent so the reveal lays out cleanly. */}
    {c.keywords && c.keywords.length > 0 && (
      <p class="hover-keywords">
        {c.keywords.map((k) => <span class="hover-tag">{k}</span>)}
      </p>
    )}
    {c.result && <p class="hover-result">{c.result}</p>}
    {c.awards && c.awards.length > 0 && (
      <p class="hover-awards">
        {c.awards.map((a) => (
          <span class="hover-award">
            {a.url ? (
              <a href={a.url} target="_blank" rel="noopener noreferrer">
                {a.label}<span class="sr-only"> ({newTab})</span>
              </a>
            ) : (
              a.label
            )}{'. '}
          </span>
        ))}
      </p>
    )}
    <div class="hover-foot">
      {hasUrl && (
        <a
          class="hover-cta"
          href={href}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
        >
          {d.cta}
          {isExternal && <span class="hover-cta-arrow" aria-hidden="true">↗</span>}
          {isExternal && <span class="sr-only"> ({newTab})</span>}
        </a>
      )}
      {c.subtitle && <p class="hover-client">{c.subtitle}</p>}
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 27rem; /* every card the same height */
    border-radius: 4px;
    overflow: hidden;
    /* Soft tint of the category colour. */
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--cat) 13%, #ffffff),
      color-mix(in srgb, var(--cat) 30%, #ffffff)
    );
    color: var(--color-text);
    text-decoration: none;
    box-shadow: 0 4px 10px rgba(196, 196, 196, 0.12);
  }
  .card[role='button'] { cursor: pointer; }
  .card[role='button']:focus-visible,
  .hover-cta:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* --- Media (top): fills the space above the body; hover detail overlays it. */
  .card-media {
    position: relative;
    flex: 0 0 40%; /* ~40% image / 60% content; card has a fixed height */
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  /* Every image fills the media area the same way (full-bleed cover). */
  .card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- Body: title + company name + sector tag, always visible. */
  .card-body {
    flex: 1 1 auto; /* fills the remaining height — same text area on every card */
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.5rem 2rem 2rem;
  }
  .card-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.3rem, 1.05rem + 0.9vw, 1.85rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  /* Type + year pills, above the title. */
  .card-pills { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .card-client {
    font-family: var(--font-body); /* Fira Code */
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: clamp(0.8rem, 0.72rem + 0.3vw, 1rem);
    color: var(--color-text);
  }
  /* "Read more" — only on touch / narrow screens (see media query). */
  .card-more {
    display: none;
    align-self: flex-start;
    margin-top: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text);
    background: none;
    border: 1px solid color-mix(in srgb, var(--color-text) 25%, transparent);
    border-radius: 3px;
    padding: 0.35rem 0.8rem;
    cursor: pointer;
  }

  /* Pills: the category type (filled with its colour), then the year in muted
     grey. Both squared and monospace, matching the card's hard corners. */
  .card-type,
  .card-year {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.3;
    padding: 0.3rem 0.7rem;
    white-space: nowrap;
  }
  .card-type { background: var(--cat); color: #210f03; }
  /* Teal and raspberry are too dark for dark text — flip to white. */
  .card[data-cat='product'] .card-type,
  .card[data-cat='storytelling'] .card-type { color: #ffffff; }
  .card-year {
    background: color-mix(in srgb, var(--color-text) 10%, transparent);
    color: var(--color-muted);
  }
  /* Award icon — shown in the pills row when the project has awards. */
  .card-award { display: inline-flex; align-items: center; color: var(--color-muted); }
  .card-award svg { width: 1.15rem; height: 1.15rem; }

  /* --- Hover detail: fills the whole card in the category colour. Result big
     at the top, keyword recap under it, then the CTA + client pinned bottom. */
  .card-hover {
    position: absolute;
    inset: 0; /* covers the entire card on pointer devices */
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 2rem;
    overflow: auto;
    background: var(--cat);
    color: #210f03;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s var(--ease);
  }
  /* Teal and raspberry are too dark for dark text — flip the reveal to white. */
  .card[data-cat='product'] .card-hover,
  .card[data-cat='storytelling'] .card-hover { color: #ffffff; }
  .card:hover .card-hover,
  .card:focus-within .card-hover,
  .card.is-open .card-hover { opacity: 1; pointer-events: auto; }

  .hover-result {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.35rem, 1.05rem + 1.1vw, 1.9rem);
    line-height: 1.18;
    letter-spacing: -0.01em;
  }
  /* Keywords as tags, styled like the idle card's date pill (.card-year). */
  .hover-keywords { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .hover-tag {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.3;
    padding: 0.3rem 0.7rem;
    white-space: nowrap;
    background: color-mix(in srgb, var(--color-text) 10%, transparent);
    color: var(--color-muted);
  }
  /* On teal / raspberry the muted grey is hard to read — flip tags to white. */
  .card[data-cat='product'] .hover-tag,
  .card[data-cat='storytelling'] .hover-tag { color: #ffffff; }

  /* Awards line, just under the result. Inherits the reveal's text colour. */
  .hover-awards {
    font-family: var(--font-body);
    font-size: clamp(0.78rem, 0.72rem + 0.25vw, 0.95rem);
    line-height: 1.5;
    color: color-mix(in srgb, currentColor 78%, transparent);
  }
  .hover-awards a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* CTA + client name, pinned to the bottom of the reveal. */
  .hover-foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .hover-cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .hover-cta-arrow { text-decoration: none; }
  .hover-client {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: clamp(0.78rem, 0.72rem + 0.25vw, 0.95rem);
    color: color-mix(in srgb, currentColor 78%, transparent);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Phones: the detail is no longer an overlay — a "read more" button expands
     it inline below the title / company name. */
  @media (max-width: 720px) {
    .card { height: auto; }
    /* Card height is auto here, so a % basis has nothing to resolve against. */
    .card-media { flex-basis: 12rem; }
    .card-more { display: inline-flex; }

    .card-hover {
      position: static;
      height: auto;
      max-height: 0;
      padding-top: 0;
      padding-bottom: 0;
      overflow: hidden;
      opacity: 1;
      pointer-events: auto;
      flex-direction: column;
      gap: var(--space-3);
      transition: max-height 0.4s var(--ease), padding 0.4s var(--ease);
    }
    .card.is-open .card-hover {
      max-height: 45rem;
      padding-top: var(--space-4);
      padding-bottom: var(--space-4);
    }
    .hover-foot { margin-top: var(--space-3); }
  }
  @media (prefers-reduced-motion: reduce) {
    .card-hover { transition: none; }
  }
</style>
