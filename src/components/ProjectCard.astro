---
// A single project card. At rest the card shows the problem (title) AND the
// result together — both always visible. Hover is purely additive: it fades in
// a bottom strip with the role tags and the link. Nothing swaps or moves, so
// the reveal can't disorient, and because the essentials never depend on hover
// the card works the same on touch (the strip is simply always shown there).
// `labels` carries the translated UI strings (with English fallbacks).
const { c, d, base, labels = {}, service } = Astro.props;
const newTab = labels.newTab ?? 'opens in new tab';
const hasUrl = Boolean(c.url);
const isExternal = hasUrl && c.url.startsWith('http');
const href = hasUrl ? (isExternal ? c.url : base + c.url) : undefined;
---

<article class="card" style={`--cat: var(--cat-${c.category})`} data-cat={c.category}>
  <div class="card-media">
    <img src={base + c.image} alt={c.subtitle} loading="lazy" />
  </div>

  <div class="card-body">
    <p class="card-pills">
      {service && <span class="card-type">{service}</span>}
      {c.year && <span class="card-year">{c.year}</span>}
      {c.awards && c.awards.length > 0 && (
        <span class="card-award" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 4h10v5a5 5 0 0 1-10 0V4z" />
            <path d="M7 5H4v2a3 3 0 0 0 3 3" />
            <path d="M17 5h3v2a3 3 0 0 1-3 3" />
            <path d="M12 14v3M9 21h6M10 17h4" />
          </svg>
        </span>
      )}
    </p>

    {/* Problem + result: both always visible, at rest. */}
    <h3 class="card-title">{c.title}</h3>
    {c.result && <p class="card-result">{c.result}</p>}
    {c.subtitle && <p class="card-client">{c.subtitle}</p>}

    {/* Bottom strip — role tags, awards and the link. Space is always reserved
        (only opacity/transform animate), so revealing it never shifts anything
        above. On touch it's shown permanently (see the media query). */}
    <div class="card-reveal">
      {c.keywords && c.keywords.length > 0 && (
        <p class="card-tags">
          {c.keywords.map((k) => <span class="card-tag">{k}</span>)}
        </p>
      )}
      {c.awards && c.awards.length > 0 && (
        <p class="card-awards">
          {c.awards.map((a) => (
            <span class="card-award-item">
              {a.url ? (
                <a href={a.url} target="_blank" rel="noopener noreferrer">
                  {a.label}<span class="sr-only"> ({newTab})</span>
                </a>
              ) : (
                a.label
              )}{'. '}
            </span>
          ))}
        </p>
      )}
      {hasUrl && (
        <a
          class="card-cta"
          href={href}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
        >
          {d.cta}
          {isExternal && <span class="card-cta-arrow" aria-hidden="true">↗</span>}
          {isExternal && <span class="sr-only"> ({newTab})</span>}
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 31rem; /* every card the same height */
    border-radius: 4px;
    overflow: hidden;
    /* Soft tint of the category colour — kept the same at rest and on hover. */
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--cat) 13%, #ffffff),
      color-mix(in srgb, var(--cat) 30%, #ffffff)
    );
    color: var(--color-text);
    text-decoration: none;
    box-shadow: 0 4px 10px rgba(196, 196, 196, 0.12);
    transition: box-shadow 0.35s var(--ease), transform 0.35s var(--ease);
  }
  /* Hover / keyboard focus lifts the card a touch — the only whole-card change. */
  .card:hover,
  .card:focus-within {
    transform: translateY(-3px);
    box-shadow: 0 12px 26px rgba(120, 120, 120, 0.18);
  }
  .card-cta:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* --- Media (top): fills the space above the body. */
  .card-media {
    position: relative;
    flex: 0 0 32%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  /* Every image fills the media area the same way (full-bleed cover). */
  .card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- Body: everything below the image lives in one continuous flow. */
  .card-body {
    flex: 1 1 auto;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 2rem;
  }
  /* Type + year pills, above the title. */
  .card-pills { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .card-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.2rem, 1rem + 0.7vw, 1.5rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--color-text);
    /* Bound the longest titles so the bottom strip can never be clipped. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Result: the payoff, sitting right under the problem — medium display weight
     so it reads as a distinct beat without competing with the title. */
  .card-result {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.95rem, 0.88rem + 0.3vw, 1.1rem);
    line-height: 1.3;
    color: color-mix(in srgb, var(--color-text) 85%, transparent);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-client {
    font-family: var(--font-body); /* Fira Code */
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: clamp(0.8rem, 0.72rem + 0.3vw, 0.95rem);
    color: var(--color-text);
  }

  /* Pills: the category type (filled with its colour), then the year in muted
     grey. Both squared and monospace, matching the card's hard corners. */
  .card-type,
  .card-year {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.3;
    padding: 0.3rem 0.7rem;
    white-space: nowrap;
  }
  .card-type { background: var(--cat); color: #210f03; }
  /* Teal and raspberry are too dark for dark text — flip to white. */
  .card[data-cat='product'] .card-type,
  .card[data-cat='storytelling'] .card-type { color: #ffffff; }
  .card-year {
    background: color-mix(in srgb, var(--color-text) 10%, transparent);
    color: var(--color-muted);
  }
  /* Award icon — shown in the pills row when the project has awards. */
  .card-award { display: inline-flex; align-items: center; color: var(--color-muted); }
  .card-award svg { width: 1.15rem; height: 1.15rem; }

  /* --- Bottom strip: role tags, awards and the link. Pinned to the bottom of
     the body; hidden at rest (opacity/transform only — its height is always
     reserved), faded in on hover / focus. A hairline top rule reads as a strip
     and appears with the rest of the content. */
  .card-reveal {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding-top: 0.9rem;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none; /* invisible at rest — don't let a stray click hit the link */
    transition: opacity 0.35s var(--ease), transform 0.35s var(--ease);
  }
  .card:hover .card-reveal,
  .card:focus-within .card-reveal {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  /* Role tags, styled like the idle card's year pill. */
  .card-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .card-tag {
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.3;
    padding: 0.3rem 0.7rem;
    white-space: nowrap;
    background: color-mix(in srgb, var(--color-text) 10%, transparent);
    color: var(--color-muted);
  }

  /* Awards line, under the tags. */
  .card-awards {
    font-family: var(--font-body);
    font-size: clamp(0.78rem, 0.72rem + 0.25vw, 0.9rem);
    line-height: 1.5;
    color: var(--color-muted);
  }
  .card-awards a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* The link. */
  .card-cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .card-cta-arrow { text-decoration: none; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Phones: no hover, so the strip is shown permanently and the card grows to
     fit. Nothing here depends on a pointer. */
  @media (max-width: 720px) {
    .card { height: auto; }
    /* Card height is auto here, so a % basis has nothing to resolve against. */
    .card-media { flex-basis: 12rem; }
    .card-reveal {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .card-reveal { transition: opacity 0.35s var(--ease); }
    .card:hover,
    .card:focus-within { transform: none; }
  }
</style>
