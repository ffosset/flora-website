---
// A single project card. At rest the image carries the category pill, and the
// body below shows the problem (title) and the result — both always visible.
// On hover the image fills with the category colour and reveals the year +
// role tags and the link, overlaying only the image; the title/result never
// move, so the reveal can't disorient. On touch (no hover) that same colour
// strip is shown permanently under the image.
// `labels` carries the translated UI strings (with English fallbacks).
const { c, d, base, labels = {}, service } = Astro.props;
const newTab = labels.newTab ?? 'opens in new tab';
const hasUrl = Boolean(c.url);
const isExternal = hasUrl && c.url.startsWith('http');
const href = hasUrl ? (isExternal ? c.url : base + c.url) : undefined;
---

<article class="card" style={`--cat: var(--cat-${c.category})`} data-cat={c.category}>
  <div class="card-media">
    <img src={base + c.image} alt={c.subtitle} loading="lazy" />
    {/* Category pill (+ award), over the image. The year moved down to the
        tags row so it sits with the role tags. */}
    <p class="card-pills">
      {service && <span class="card-type">{service}</span>}
      {c.awards && c.awards.length > 0 && (
        <span class="card-award" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 4h10v5a5 5 0 0 1-10 0V4z" />
            <path d="M7 5H4v2a3 3 0 0 0 3 3" />
            <path d="M17 5h3v2a3 3 0 0 1-3 3" />
            <path d="M12 14v3M9 21h6M10 17h4" />
          </svg>
        </span>
      )}
    </p>
  </div>

  <div class="card-body">
    {/* Problem + result: both always visible, at rest. */}
    <h3 class="card-title">{c.title}</h3>
    {c.result && <p class="card-result">{c.result}</p>}
    {c.subtitle && <p class="card-client">{c.subtitle}</p>}
  </div>

  {/* Reveal — role tags, awards and the link. Desktop: absolutely positioned
      over the image, category colour, faded in on hover / focus. Touch: falls
      into normal flow as a colour strip under the image (see the media query).
      Placed last in the DOM so that on touch it reads after the body. */}
  <div class="card-overlay">
    {(c.year || (c.keywords && c.keywords.length > 0)) && (
      <p class="card-tags">
        {c.year && <span class="card-tag card-tag-year">{c.year}</span>}
        {c.keywords && c.keywords.map((k) => <span class="card-tag">{k}</span>)}
      </p>
    )}
    {c.awards && c.awards.length > 0 && (
      <p class="card-awards">
        {c.awards.map((a) => (
          <span class="card-award-item">
            {a.url ? (
              <a href={a.url} target="_blank" rel="noopener noreferrer">
                {a.label}<span class="sr-only"> ({newTab})</span>
              </a>
            ) : (
              a.label
            )}{'. '}
          </span>
        ))}
      </p>
    )}
    {hasUrl && (
      <a
        class="card-cta"
        href={href}
        target={isExternal ? '_blank' : undefined}
        rel={isExternal ? 'noopener noreferrer' : undefined}
      >
        {d.cta}
        {isExternal && <span class="card-cta-arrow" aria-hidden="true">↗</span>}
        {isExternal && <span class="sr-only"> ({newTab})</span>}
      </a>
    )}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 28rem; /* every card the same height */
    border-radius: 4px;
    overflow: hidden;
    /* Soft tint of the category colour — kept the same at rest and on hover. */
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--cat) 13%, #ffffff),
      color-mix(in srgb, var(--cat) 30%, #ffffff)
    );
    color: var(--color-text);
    text-decoration: none;
    box-shadow: 0 4px 10px rgba(196, 196, 196, 0.12);
    transition: box-shadow 0.35s var(--ease), transform 0.35s var(--ease);
  }
  /* Hover / keyboard focus lifts the card a touch. */
  .card:hover,
  .card:focus-within {
    transform: translateY(-3px);
    box-shadow: 0 12px 26px rgba(120, 120, 120, 0.18);
  }
  .card-cta:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* --- Media (top): the image, with the pills overlaid and the colour reveal
     covering it on hover. Its height (42%) is mirrored by .card-overlay. */
  .card-media {
    position: relative;
    flex: 0 0 42%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  /* Every image fills the media area the same way (full-bleed cover). */
  .card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Pills, over the image: the category type (filled with its colour), then the
     year on a frosted chip so it stays legible over any photo. */
  .card-pills {
    position: absolute;
    top: 1.5rem;
    left: 2rem; /* aligns with the title + hover tags below */
    right: 2rem;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .card-type {
    font-family: var(--font-body);
    font-size: 0.82rem;
    line-height: 1.3;
    text-transform: lowercase;
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
    white-space: nowrap;
    background: var(--cat);
    color: var(--color-text);
  }
  /* The category fills are all too dark for dark text — flip to white. */
  .card[data-cat='landing'] .card-type,
  .card[data-cat='product'] .card-type,
  .card[data-cat='storytelling'] .card-type { color: #ffffff; }
  /* Award icon — a frosted chip in the pills row when the project has awards. */
  .card-award {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem;
    border-radius: 50%;
    background: color-mix(in srgb, #ffffff 82%, transparent);
    backdrop-filter: blur(3px);
    color: var(--color-muted);
  }
  .card-award svg { width: 1.15rem; height: 1.15rem; }

  /* --- Body: problem, result, client. Title/result pinned to the top; the
     client name sits at the bottom. */
  .card-body {
    flex: 1 1 auto;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 2rem;
  }
  .card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-text);
    /* Bound the longest titles so the body can't overflow its fixed height. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Result: the payoff, sitting right under the problem — medium display weight
     so it reads as a distinct beat without competing with the title. */
  .card-result {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-client {
    margin-top: auto;
    font-family: var(--font-body); /* Fira Code */
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: clamp(0.8rem, 0.72rem + 0.3vw, 0.95rem);
    color: var(--color-text);
  }

  /* --- Reveal: covers the image on hover, filled with the category colour. */
  .card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 42%; /* mirrors .card-media's flex-basis so it covers just the image */
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between; /* tags at top, link at bottom */
    gap: 0.75rem;
    padding: 1.5rem 2rem; /* aligns with the pills + body text */
    overflow: hidden;
    background: var(--cat);
    color: var(--color-text);
    opacity: 0;
    pointer-events: none; /* invisible at rest — don't let a stray click hit the link */
    transition: opacity 0.35s var(--ease);
  }
  /* The category fills are all too dark for dark text — flip the reveal to white. */
  .card[data-cat='landing'] .card-overlay,
  .card[data-cat='product'] .card-overlay,
  .card[data-cat='storytelling'] .card-overlay { color: #ffffff; }
  .card:hover .card-overlay,
  .card:focus-within .card-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  /* Role tags — light frosted chips with dark text, matching the idle year
     chip, so they read the same on every category fill. */
  .card-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .card-tag {
    font-family: var(--font-body);
    font-size: 0.82rem;
    line-height: 1.3;
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
    white-space: nowrap;
    background: color-mix(in srgb, #ffffff 85%, transparent);
    color: var(--color-text);
  }
  /* The year: same chip, but a more transparent fill so it reads as a quieter,
     slightly category-tinted pill next to the role tags. */
  .card-tag-year {
    background: color-mix(in srgb, #ffffff 45%, transparent);
  }

  /* Awards line, under the tags. */
  .card-awards {
    font-family: var(--font-body);
    font-size: clamp(0.75rem, 0.7rem + 0.2vw, 0.85rem);
    line-height: 1.45;
    color: color-mix(in srgb, currentColor 82%, transparent);
  }
  .card-awards a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* The link. */
  .card-cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.25rem);
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .card-cta-arrow { text-decoration: none; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Phones: no hover. The reveal leaves its absolute overlay and joins the body
     as one continuous block — no coloured fill (the card tint shows through),
     dark text, and padding aligned with the body — so the tags and link read as
     part of the card's main content. */
  @media (max-width: 720px) {
    .card { height: auto; }
    /* Card height is auto here, so a % basis has nothing to resolve against. */
    .card-media { flex-basis: 12rem; }
    /* Tighter inner padding on phones; the pills and the tags/link block share
       the same inset so the category tag lines up with the body text. */
    .card-body { padding: 1.25rem 1.25rem 1.75rem; }
    .card-pills { top: 1.25rem; left: 1.25rem; right: 1.25rem; }
    .card-overlay {
      position: static;
      height: auto;
      opacity: 1;
      pointer-events: auto;
      background: transparent;
      margin: 0 1.25rem;
      padding: 1.75rem 0;
      /* Tinted hairline that adapts to the card's category colour. */
      border-top: 1px solid color-mix(in srgb, var(--cat) 35%, transparent);
    }
    /* Keep the text dark on the light tint for every category (overrides the
       white-flip used over the coloured fill on desktop). */
    .card-overlay,
    .card[data-cat='landing'] .card-overlay,
    .card[data-cat='product'] .card-overlay,
    .card[data-cat='storytelling'] .card-overlay { color: var(--color-text); }
  }
  @media (prefers-reduced-motion: reduce) {
    .card { transition: opacity 0.35s var(--ease); }
    .card:hover,
    .card:focus-within { transform: none; }
  }
</style>
