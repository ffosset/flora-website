---
// A single project card. `highlight` makes it the large, image-filled card
// used on the left of each category; otherwise it's a compact stacked card
// that keeps its per-image treatment (blend / contained / etc.).
const { c, d, base, highlight = false } = Astro.props;
const hasUrl = Boolean(c.url);
const isExternal = hasUrl && c.url.startsWith('http');
const href = hasUrl ? (isExternal ? c.url : base + c.url) : undefined;
const textTop = d.layout === 'text-top';
// Highlight cards always lead with the image; tag sits under the text.
const mediaFirst = highlight || !textTop;
const tagTop = textTop && !highlight;

const Media = (
  <div class="card-media">
    <img src={base + c.image} alt={c.subtitle} loading="lazy" />
  </div>
);
const Text = (
  <div class="card-body">
    {tagTop && <span class="card-tag">{c.tag}</span>}
    <div class="card-text">
      <h3 class="card-title">{c.title}</h3>
      <p class="card-client">{c.subtitle}</p>
    </div>
    {!tagTop && <span class="card-tag">{c.tag}</span>}
  </div>
);
---

<article
  class:list={[
    'card',
    `card--${d.layout}`,
    d.blend && `card--blend-${d.blend}`,
    d.media && `card--media-${d.media}`,
    { 'card--center': d.center, 'card--round': d.round, 'card--highlight': highlight, 'card--compact': !highlight },
  ]}
  style={`--bg:${d.bg}; --fg:${d.fg}; --hover:${d.hover}; --pill:${d.pill}`}
  data-cat={c.category}
  role={!hasUrl ? 'button' : undefined}
  tabindex={!hasUrl ? '0' : undefined}
  aria-expanded={!hasUrl ? 'false' : undefined}
  aria-controls={!hasUrl ? `hover-${c.slug}` : undefined}
>
  {mediaFirst ? <>{Media}{Text}</> : <>{Text}{Media}</>}

  <div class="card-hover" id={`hover-${c.slug}`}>
    <div class="hover-main">
      {c.year && <p class="hover-year">{c.year}</p>}
      {c.did && (
        <div class="hover-block">
          <p class="hover-label">My role</p>
          <p class="hover-role">{c.did}</p>
        </div>
      )}
      {c.result && (
        <div class="hover-block">
          <p class="hover-label">Result</p>
          <p class="hover-result">{c.result}</p>
        </div>
      )}
    </div>
    {hasUrl && (
      <a
        class="hover-cta"
        href={href}
        target={isExternal ? '_blank' : undefined}
        rel={isExternal ? 'noopener noreferrer' : undefined}
      >
        {d.cta}
        {isExternal && <span class="sr-only"> (opens in new tab)</span>}
      </a>
    )}
  </div>
</article>

<style>
  /* --- Card --- */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg);
    color: var(--fg);
    text-decoration: none;
    box-shadow: 0 4px 10px rgba(196, 196, 196, 0.12);
  }
  .card[role='button'] { cursor: pointer; }
  .card[role='button']:focus-visible,
  .hover-cta:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Hover / expanded detail. */
  .card-hover {
    font-family: var(--font-display);
    background: var(--hover);
    color: #210f03;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem 2.5rem;
  }
  .hover-main { display: flex; flex-direction: column; gap: 2rem; }
  .hover-year {
    text-align: right;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 1rem;
  }
  .hover-block { display: flex; flex-direction: column; gap: 0.5rem; }
  .hover-label { text-transform: uppercase; letter-spacing: 0.06em; font-size: 1rem; }
  .hover-role { font-size: 1.25rem; line-height: 1.4; }
  .hover-result { font-size: 1.25rem; line-height: 1.4; font-weight: 700; }
  .hover-cta {
    align-self: flex-start;
    background: #210f03;
    color: var(--pill);
    padding: 0.6rem 1rem;
    border-radius: 50px;
    font-weight: 500;
    font-size: 1rem;
    text-decoration: none;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .card-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .card-text { display: flex; flex-direction: column; gap: 0.75rem; }
  .card-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 1.1rem + 1.1vw, 2rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--fg); /* override the global h3 colour so dark cards read white */
  }
  .card-client {
    font-family: var(--font-body); /* Fira Code, like the design */
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: clamp(0.95rem, 0.85rem + 0.35vw, 1.25rem);
  }
  .card-tag {
    align-self: flex-start;
    background: color-mix(in srgb, var(--fg) 13%, transparent);
    color: var(--fg);
    padding: 0.35rem 0.8rem;
    border-radius: 50px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
  }

  /* media-top: full-bleed image, padded text below. */
  .card--media-top { gap: 2.5rem; }
  .card--media-top .card-body { padding: 0 2.5rem 2rem; }

  /* media-pad: padded, rounded image then text. */
  .card--media-pad { gap: 2.5rem; padding: 2rem 2.5rem; }

  /* text-top: padded text then image below. */
  .card--text-top { gap: 2.5rem; padding: 2rem 2.5rem; }

  .card--round .card-media { border-radius: 11px; overflow: hidden; }
  .card--center .card-body { align-items: center; text-align: center; }
  .card--center .card-tag { align-self: center; }

  /* image sizing for text-top cards */
  .card--media-sm .card-media { width: 60%; margin-inline: auto; }
  .card--media-md .card-media { width: 86%; margin-inline: auto; }
  .card--blend-darken .card-media img { mix-blend-mode: darken; }
  .card--blend-lighten .card-media img { mix-blend-mode: lighten; }

  /* Compact (stacked, right column): slightly smaller title. */
  .card--compact .card-title { font-size: clamp(1.2rem, 1rem + 0.6vw, 1.55rem); }

  /* Highlight (large, left column): the image fills the card; text sits below.
     Overrides the per-layout padding/sizing so it reads as one big image card. */
  .card--highlight { gap: 0; padding: 0; }
  .card--highlight .card-media {
    flex: 1 1 auto;
    min-height: 240px;
    width: 100%;
    margin: 0;
    border-radius: 0;
    overflow: hidden;
  }
  .card--highlight .card-media img { width: 100%; height: 100%; object-fit: cover; }
  .card--highlight .card-body {
    padding: 1.75rem 2rem;
    gap: 1rem;
    align-items: flex-start;
    text-align: left;
  }
  .card--highlight .card-tag { align-self: flex-start; }
  .card--highlight .card-title { font-size: clamp(1.6rem, 1.2rem + 1.1vw, 2.2rem); }

  /* Pointer screens: the detail is an overlay that slides DOWN over the card
     on hover / focus (or when a no-url button card is toggled open). */
  @media (min-width: 721px) {
    .card-hover {
      position: absolute;
      inset: 0;
      z-index: 2;
      overflow: auto;
      justify-content: space-between;
      transform: translateY(-100%);
      transition: transform 0.4s var(--ease);
    }
    .card:hover .card-hover,
    .card:focus-within .card-hover,
    .card.is-open .card-hover { transform: translateY(0); }
  }

  /* Phones: tapping a card opens the detail at the bottom. */
  @media (max-width: 720px) {
    .card-hover {
      max-height: 0;
      padding-block: 0;
      overflow: hidden;
      transition: max-height 0.4s var(--ease), padding 0.4s var(--ease);
    }
    .card.is-open .card-hover,
    .card:focus-within .card-hover {
      max-height: 60rem;
      padding-block: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-hover { transition: none; }
  }
</style>
