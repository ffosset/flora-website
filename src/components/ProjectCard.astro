---
// A single project card. The category tag sits above the title - in the body,
// not over the image - so it stays visible at rest AND on hover. The body then
// shows the problem (title) and the result - both always visible.
// On hover the image fills with the category colour and reveals the year +
// role tags and the link, overlaying only the image; the title/result never
// move, so the reveal can't disorient. On touch (no hover) that same colour
// strip is shown permanently under the image.
// `labels` carries the translated UI strings (with English fallbacks).
const { c, d, base, labels = {}, service } = Astro.props;
const newTab = labels.newTab ?? 'opens in new tab';
const hasUrl = Boolean(c.url);
const isExternal = hasUrl && c.url.startsWith('http');
const href = hasUrl ? (isExternal ? c.url : base + c.url) : undefined;
---

<article class="card" style={`--cat: var(--cat-${c.category})`} data-cat={c.category}>
  <div class="card-media">
    <img src={base + c.image} alt={c.alt ?? c.subtitle} loading="lazy" />
  </div>

  <div class="card-body">
    {/* Category tag on top of the title, then problem + result. */}
    {service && <p class="card-meta"><span class="card-type">{service}</span></p>}
    <h3 class="card-title">{c.title}</h3>
    {c.result && <p class="card-result">{c.result}</p>}
    {/* Award callout: always visible here in the body (not hidden in the hover
        reveal), so the accolade reads clearly - a trophy icon on a warm panel
        with an accent bar. */}
    {c.awards && c.awards.length > 0 && (
      <ul class="card-awards">
        {c.awards.map((a) => (
          <li class="card-award">
            <svg class="card-award-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 4h10v5a5 5 0 0 1-10 0V4z" />
              <path d="M7 5H4v2a3 3 0 0 0 3 3" />
              <path d="M17 5h3v2a3 3 0 0 1-3 3" />
              <path d="M12 14v3M9 21h6M10 17h4" />
            </svg>
            <span class="card-award-text">
              {a.url ? (
                <a href={a.url} target="_blank" rel="noopener noreferrer">
                  {a.label}<span class="sr-only"> ({newTab})</span>
                </a>
              ) : (
                a.label
              )}
            </span>
          </li>
        ))}
      </ul>
    )}
    {c.subtitle && <p class="card-client">{c.subtitle}</p>}
  </div>

  {/* Reveal - role tags and the link. Desktop: absolutely positioned over the
      image, category colour, faded in on hover / focus. Touch: falls into normal
      flow as a colour strip under the image (see the media query). Placed last in
      the DOM so that on touch it reads after the body. */}
  <div class="card-overlay">
    {(c.year || (c.keywords && c.keywords.length > 0)) && (
      <p class="card-tags">
        {c.year && <span class="card-tag card-tag-year">{c.year}</span>}
        {c.keywords && c.keywords.map((k) => <span class="card-tag">{k}</span>)}
      </p>
    )}
    {hasUrl && (
      <a
        class="card-cta"
        href={href}
        target={isExternal ? '_blank' : undefined}
        rel={isExternal ? 'noopener noreferrer' : undefined}
      >
        {d.cta}
        {isExternal && <span class="card-cta-arrow" aria-hidden="true">↗</span>}
        {isExternal && <span class="sr-only"> ({newTab})</span>}
      </a>
    )}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 30rem; /* every card the same height */
    border-radius: 4px;
    overflow: hidden;
    /* Soft tint of the category colour - kept the same at rest and on hover. */
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--cat) 13%, #ffffff),
      color-mix(in srgb, var(--cat) 30%, #ffffff)
    );
    color: var(--color-text);
    text-decoration: none;
    /* No shadow at rest: it sits directly behind the card (0 offset), hidden.
       On hover it slides out to a hard offset in the category shadow colour. */
    box-shadow: 0 0 0 0 var(--cat-shadow, transparent);
    transition: box-shadow 0.35s var(--ease);
  }
  /* Per-category hard-shadow colour, driven on hover. */
  .card[data-cat='landing']      { --cat-shadow: #9C5A0C; }
  .card[data-cat='storytelling'] { --cat-shadow: #235C48; }
  .card[data-cat='product']      { --cat-shadow: #525C2E; }
  /* Hover / keyboard focus: the card stays put; the hard offset shadow slides
     out from behind it toward the bottom-right. */
  .card:hover,
  .card:focus-within {
    box-shadow: 8px 8px 0 0 var(--cat-shadow);
  }
  .card-cta:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* --- Media (top): the image, with the pills overlaid and the colour reveal
     covering it on hover. Its height (36%) is mirrored by .card-overlay. */
  .card-media {
    position: relative;
    flex: 0 0 36%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  /* Every image fills the media area the same way (full-bleed cover). */
  .card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Category tag (in the body, above the title): a solid pill in the category
     colour, so it stays visible both at rest and under the hover reveal. */
  .card-type {
    font-family: var(--font-body);
    font-size: 0.82rem;
    line-height: 1.3;
    text-transform: lowercase;
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
    white-space: nowrap;
    background: var(--cat);
    color: var(--color-text);
  }
  /* The category fills are all too dark for dark text - flip to white. */
  .card[data-cat='landing'] .card-type,
  .card[data-cat='product'] .card-type,
  .card[data-cat='storytelling'] .card-type { color: #ffffff; }

  /* --- Body: problem, result, client. Title/result pinned to the top; the
     client name sits at the bottom. */
  .card-body {
    flex: 1 1 auto;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 2rem;
  }
  /* Category tag row above the title (flex so the pill hugs its content). */
  .card-meta { display: flex; }
  .card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-text);
    /* Bound the longest titles so the body can't overflow its fixed height. */
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Result: the payoff, sitting right under the problem - medium display weight
     so it reads as a distinct beat without competing with the title. */
  .card-result {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-client {
    margin-top: auto;
    font-family: var(--font-body); /* Fira Code */
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: clamp(0.8rem, 0.72rem + 0.3vw, 0.95rem);
    color: var(--color-text);
  }

  /* --- Reveal: covers the image on hover, filled with the category colour. */
  .card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 36%; /* mirrors .card-media's flex-basis so it covers just the image */
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between; /* tags at top, link at bottom */
    gap: 0.75rem;
    padding: 1.5rem 2rem; /* aligns with the pills + body text */
    overflow: hidden;
    background: var(--cat);
    color: var(--color-text);
    opacity: 0;
    pointer-events: none; /* invisible at rest - don't let a stray click hit the link */
    transition: opacity 0.35s var(--ease);
  }
  /* The category fills are all too dark for dark text - flip the reveal to white. */
  .card[data-cat='landing'] .card-overlay,
  .card[data-cat='product'] .card-overlay,
  .card[data-cat='storytelling'] .card-overlay { color: #ffffff; }
  .card:hover .card-overlay,
  .card:focus-within .card-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  /* Role tags - light frosted chips with dark text, matching the idle year
     chip, so they read the same on every category fill. */
  .card-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .card-tag {
    font-family: var(--font-body);
    font-size: 0.82rem;
    line-height: 1.3;
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
    white-space: nowrap;
    background: color-mix(in srgb, #ffffff 85%, transparent);
    color: var(--color-text);
  }
  /* The year: same chip, but a more transparent fill so it reads as a quieter,
     slightly category-tinted pill next to the role tags. */
  .card-tag-year {
    background: color-mix(in srgb, #ffffff 45%, transparent);
  }

  /* Award callout (in the body): a legible warm panel with a trophy icon and an
     accent bar, so the accolade stands out at rest instead of hiding in the
     hover reveal as faint text. */
  .card-awards {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .card-award {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    padding: 0.45rem 0.6rem;
    border-radius: 4px;
    border-left: 3px solid var(--color-primary);
    background: #ffffff;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.35;
    font-weight: 500;
    color: var(--color-text);
  }
  .card-award-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: var(--color-primary);
  }
  .card-award-text a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* The link - typeset like the client name (Fira Code, uppercase, spaced). */
  .card-cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-family: var(--font-body);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: clamp(0.8rem, 0.72rem + 0.3vw, 0.95rem);
    color: inherit;
    text-decoration: none;
  }
  /* Stretch the link across the whole reveal so the entire image area (the
     colour fill on hover) is clickable and leads to the project. */
  .card-cta::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card-cta-arrow { text-decoration: none; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Phones: no hover. The reveal leaves its absolute overlay and joins the body
     as one continuous block - no coloured fill (the card tint shows through),
     dark text, and padding aligned with the body - so the tags and link read as
     part of the card's main content. */
  @media (max-width: 720px) {
    .card { height: auto; }
    /* Card height is auto here, so a % basis has nothing to resolve against. */
    .card-media { flex-basis: 12rem; }
    /* Tighter inner padding on phones. */
    .card-body { padding: 1.25rem 1.25rem 1.75rem; }
    .card-overlay {
      position: static;
      height: auto;
      opacity: 1;
      pointer-events: auto;
      background: transparent;
      margin: 0 1.25rem;
      padding: 1.75rem 0;
      /* Tinted hairline that adapts to the card's category colour. */
      border-top: 1px solid color-mix(in srgb, var(--cat) 35%, transparent);
    }
    /* Keep the text dark on the light tint for every category (overrides the
       white-flip used over the coloured fill on desktop). */
    .card-overlay,
    .card[data-cat='landing'] .card-overlay,
    .card[data-cat='product'] .card-overlay,
    .card[data-cat='storytelling'] .card-overlay { color: var(--color-text); }
    /* No hover fill to click on touch - drop the full-area link target so it
       can't stretch across the whole (statically laid out) card. */
    .card-cta::after { content: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    /* Shadow still appears on hover, but snaps in rather than sliding. */
    .card { transition: none; }
  }
</style>
