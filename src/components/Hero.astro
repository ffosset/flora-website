---
import portrait from '../assets/foto-flora.png';
const { t } = Astro.props;
const roles = t.hero.roles?.length ? t.hero.roles : [t.hero.roleWord];
---
<section id="hero" class="hero" data-hero>
  <aside class="hero-aside">
    <a class="hero-photo" href="#about" aria-label={t.a11y.aboutMe}>
      <img src={portrait.src} alt="Flora Fosset" width="203" height="203" loading="eager" />
    </a>
    {t.hero.tagline && <p class="hero-tagline">{t.hero.tagline}</p>}
  </aside>

  <div class="container hero-inner">
    <div class="hero-bottom">
      <h1 class="hero-stack" data-hero-stack data-words={JSON.stringify(roles)}>
        <span class="flora-anchor">
          <span class="hero-name">{t.hero.nameWord}</span>
          <span class="hero-dot" aria-hidden="true">·</span>
        </span>
        {/* word rows are injected by the stack script below */}
      </h1>
    </div>
  </div>

  <!-- Spotlight cursor follower — additive, scoped to the hero. -->
  <div class="hero-cursor" data-hero-cursor aria-hidden="true"></div>
</section>

<script>
  // Lock the hero to the viewport height measured ON LOAD (mobile address bar
  // shown) and DON'T change it when the bar collapses on scroll — that height-
  // only resize is exactly what made the hero grow / the title drift on the
  // first scroll. We only re-measure when the width changes (orientation).
  const heroEl = document.querySelector('[data-hero]');
  if (heroEl) {
    const setHeroH = () => heroEl.style.setProperty('--hero-h', window.innerHeight + 'px');
    setHeroH();
    let lastW = window.innerWidth;
    window.addEventListener('resize', () => {
      if (window.innerWidth !== lastW) { lastW = window.innerWidth; setHeroH(); }
    });
  }
</script>

<script>
  // Rolling-slot word stack. Each word enters the pinned "flora ·" slot, becomes
  // the active (nearest, darkest) row, and shoves the previous words away as they
  // lighten. Runs ONCE on load and HOLDS on the full list forever — no loop, so a
  // visitor who never watches the motion still sees every word. Order comes from
  // i18n roles (data-words). Colour is by POSITION, recomputed on every step.
  const stack = document.querySelector('[data-hero-stack]');
  if (stack) {
    let ORDER = [];
    try { ORDER = JSON.parse(stack.dataset.words || '[]'); } catch {}
    const SHADES = ['--w5', '--w4', '--w3', '--w2', '--w1']; // idx 0 = active (next to flora·) = darkest
    const STEP = 550;   // word landing duration (≈ --dur)
    const HOLD = 1600;  // still time between words — the pacing dial (doubled)
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wait = (ms) => new Promise((r) => setTimeout(r, ms));

    const makeRow = (text) => {
      const row = document.createElement('span');
      row.className = 'word';
      const inner = document.createElement('span');
      inner.className = 'inner';
      inner.textContent = text;
      row.appendChild(inner);
      return row;
    };
    const recolor = () => {
      // firstChild in-flow = active row (bottom on desktop / top on mobile)
      stack.querySelectorAll('.word').forEach((row, i) => {
        row.style.color = `var(${SHADES[Math.min(i, SHADES.length - 1)]})`;
      });
    };
    const build = async () => {
      stack.querySelectorAll('.word').forEach((w) => w.remove());
      for (let i = 0; i < ORDER.length; i++) {
        const row = makeRow(ORDER[i]);
        stack.insertBefore(row, stack.firstChild); // becomes active; shoves the rest away
        recolor();
        if (reduce) { row.classList.add('show'); continue; } // reduced motion: final frame instantly
        requestAnimationFrame(() => requestAnimationFrame(() => row.classList.add('show')));
        await wait(STEP + HOLD);
      }
    };
    window.addEventListener('load', build);
  }
</script>

<script>
  // Spotlight cursor follower, scoped to the hero. This is ADDITIVE — the
  // native cursor stays visible; the follower is a decorative blend-mode disc.
  // SSR-safe: Astro only runs this on the client, but guard matchMedia anyway.
  const supportsMM = typeof window !== 'undefined' && 'matchMedia' in window;
  const reduceMotion =
    supportsMM && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const coarsePointer =
    supportsMM && window.matchMedia('(hover: none) and (pointer: coarse)').matches;

  const hero = document.querySelector('[data-hero]');
  const cursor = hero && hero.querySelector('[data-hero-cursor]');

  // Reduced motion: HIDE rather than snap. A high-contrast inverting disc that
  // teleports to the pointer is more distracting than no effect at all, so the
  // least-jarring honoring of the preference is to remove it (CSS also hides
  // it; here we simply never wire up the loop). Same for coarse/touch pointers.
  if (hero && cursor && !reduceMotion && !coarsePointer) {
    // Cache the element + its rect; never query the DOM inside the rAF loop.
    let rect = hero.getBoundingClientRect();
    let targetX = rect.width / 2;
    let targetY = rect.height / 2;
    let posX = targetX; // eased position
    let posY = targetY;
    let rafId = null;
    let visible = false;

    const refreshRect = () => { rect = hero.getBoundingClientRect(); };

    // Reveal + start the loop, snapping the eased position to (x, y) so the
    // disc appears under the pointer instead of sliding in from a stale spot.
    const reveal = (x, y) => {
      targetX = posX = x;
      targetY = posY = y;
      if (!visible) {
        visible = true;
        cursor.classList.add('is-visible');
      }
      start();
    };

    // Single rAF loop. Lerp the eased position toward the target for slight,
    // organic lag. Position is written via the `translate` property (its own
    // channel, so the hover `scale` can transition independently and we never
    // animate top/left).
    const render = () => {
      posX += (targetX - posX) * 0.18;
      posY += (targetY - posY) * 0.18;
      cursor.style.setProperty('--cx', posX + 'px');
      cursor.style.setProperty('--cy', posY + 'px');
      rafId = requestAnimationFrame(render);
    };
    const start = () => { if (rafId === null) rafId = requestAnimationFrame(render); };
    const stop = () => { if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; } };

    hero.addEventListener('mousemove', (e) => {
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      // Already visible: just steer the target (lerp does the smoothing).
      // Not yet visible (e.g. pointer was already inside on load): reveal here.
      if (visible) { targetX = x; targetY = y; } else { reveal(x, y); }
    });

    // Clean entry across the boundary: snap + fade in before the first move.
    hero.addEventListener('mouseenter', (e) => {
      reveal(e.clientX - rect.left, e.clientY - rect.top);
    });

    hero.addEventListener('mouseleave', () => {
      // Fade out and stop the loop to save cycles; it restarts on next enter.
      visible = false;
      cursor.classList.remove('is-visible');
      stop();
    });

    // The hero's top shifts as the page scrolls; its size changes on resize.
    window.addEventListener('scroll', refreshRect, { passive: true });
    window.addEventListener('resize', refreshRect);
  }
</script>

<style>
  .hero {
    /* Diagonal wash per Figma: white at the top-left, secondary peach at the
       bottom-right (stop runs past 100% so the peach stays soft). */
    background: linear-gradient(135deg, #ffffff 0%, var(--color-secondary) 50%, #f4c49d 118%);
    /* Keep the hero from growing as the mobile address bar collapses on the
       first scroll. svh is the stable (bar-shown) viewport for modern browsers;
       --hero-h is a JS-measured pixel height (taken on load, never updated on
       scroll) that locks it down everywhere else. */
    min-height: 100vh;
    min-height: 100svh;
    min-height: var(--hero-h, 100svh);
    padding-block: 0;
    display: flex;
    /* Contain the follower: relative for absolute positioning, overflow so it
       can't escape, isolate so its blend mode only mixes with hero content. */
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-cursor {
    /* One knob for the glow's size. */
    --cursor-size: 500px;
    position: absolute;
    top: 0;
    left: 0;
    width: var(--cursor-size);
    height: var(--cursor-size);
    /* Soft radial glow that fades to nothing — no hard edge, no flat circle.
       The inner stop is already softened to 60% so the glow stays a hint of
       warmth rather than a solid orange core. */
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-cursor-glow) 60%, transparent) 0%,
      transparent 70%
    );
    /* Extra diffusion on top of the gradient so it reads as light, not a shape. */
    filter: blur(40px);
    /* multiply keeps the orange truthful: it warmly tints the cream ground
       instead of inverting it. (difference turned the orange blue; plain
       opacity with no blend sat flat and grey-ish on top — multiply gives the
       warmest, most natural glow against this palette.) */
    mix-blend-mode: multiply;
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    /* Position on the `translate` channel (GPU-composited, never top/left).
       -50% is exactly --cursor-size / 2, so the glow stays centered on the
       pointer at any size — the larger 500px box is accounted for automatically. */
    translate: calc(var(--cx, 0px) - 50%) calc(var(--cy, 0px) - 50%);
    /* Promote to its own layer: a 500px blurred element is costly to repaint. */
    will-change: transform;
    transition: opacity 0.2s var(--ease);
  }
  .hero-cursor.is-visible { opacity: 0.28; }

  /* Touch / no-hover devices: there is no cursor to follow. */
  @media (hover: none) and (pointer: coarse) {
    .hero-cursor { display: none; }
  }
  /* Reduced motion: hide entirely (see script comment for the rationale). */
  @media (prefers-reduced-motion: reduce) {
    .hero-cursor { display: none; }
  }
  .hero-inner {
    max-width: var(--maxw-hero);
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: var(--space-5);
  }
  .hero-bottom { display: flex; flex-direction: column; gap: var(--space-4); }

  /* Portrait + subtitle cluster, upper-right (per Figma). */
  .hero-aside {
    position: absolute;
    top: clamp(7rem, 24vh, 13rem);
    right: var(--gutter);
    z-index: 1;
    width: 13rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }
  @media (min-width: 768px) {
    /* Pulled in from the right edge so it sits a bit more toward the centre. */
    .hero-aside { right: clamp(4rem, 13vw, 15rem); }
  }
  .hero-photo {
    --d: 203px;   /* 30% larger than before */
    --ring: 26px;
    display: block;
    position: relative;
    box-sizing: border-box; /* total stays --d; the border eats into it */
    width: var(--d);
    height: var(--d);
    border-radius: 50%;
    /* Soft primary ring — rgba(174,73,5,0.1) is --color-primary at 10%. */
    border: var(--ring) solid rgba(174, 73, 5, 0.1);
    overflow: hidden;
    cursor: pointer;
    /* Hover: the ring thins so the picture grows to fill it — total unchanged. */
    transition: border-width 0.45s var(--ease);
  }
  .hero-photo:hover,
  .hero-photo:focus-visible { border-width: 6px; }
  @media (prefers-reduced-motion: reduce) {
    .hero-photo { transition: none; }
    .hero-photo:hover,
    .hero-photo:focus-visible { border-width: var(--ring); }
  }
  .hero-photo img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
    display: block;
    /* luminosity lets the warm background tint the portrait (matches Figma). */
    mix-blend-mode: luminosity;
  }
  .hero-subtitle {
    font-weight: 300; /* Inter Light */
    font-size: 1rem;
    line-height: 1.35;
    color: var(--color-primary);
  }

  @media (max-width: 600px) {
    /* Keep the portrait clear of the title on small screens. */
    .hero-aside { width: 11rem; top: clamp(6rem, 18vh, 9rem); }
    .hero-photo { --d: 156px; --ring: 20px; }
  }

  /* --- Rolling-slot word stack -------------------------------------------
     "flora ·" is a single fixed gutter element (NOT re-parented between words);
     word rows are injected by the script and stack next to it. The active word
     is always the one sitting at the pinned edge, so the fixed anchor naturally
     reads as paired with it. Bottom-anchored on desktop, grows UP. */
  .hero-stack {
    /* Position-based shade ramp: active (next to flora·) is the brand primary
       #AE4905; each row further away lightens toward the peach secondary.
       Built from the brand tokens with color-mix (already used elsewhere in
       this hero). Injected .word rows inherit these. */
    --w5: var(--color-primary);                                              /* active */
    --w4: color-mix(in srgb, var(--color-primary) 78%, var(--color-secondary));
    --w3: color-mix(in srgb, var(--color-primary) 56%, var(--color-secondary));
    --w2: color-mix(in srgb, var(--color-primary) 36%, var(--color-secondary));
    --w1: color-mix(in srgb, var(--color-primary) 20%, var(--color-secondary)); /* furthest */
    --dur: 0.55s;                      /* STEP — word landing duration */

    position: relative;
    display: flex;
    flex-direction: column-reverse;    /* grows upward from the pinned edge */
    justify-content: flex-start;
    align-items: flex-start;
    gap: 0.34em;                       /* vertical breathing room between rows */
    padding-left: 3.6em;               /* gutter that flora· hangs in */
    font-family: var(--font-display);
    font-size: var(--fs-mega);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.01em;
    min-height: 5.8em;                 /* reserve space so layout never jumps */
  }
  .flora-anchor {
    position: absolute;
    left: 0;
    bottom: 0;                         /* desktop: pinned bottom-left */
    display: inline-flex;
    align-items: baseline;
    gap: 0.12em;
    white-space: nowrap;
    line-height: 1.02;
  }
  .hero-name { color: var(--color-text); font-weight: 800; } /* Extra Bold */
  .hero-dot { color: var(--color-primary); font-weight: 300; }

  /* mobile: flora· TOP-left, words stack DOWN — CSS flip only, no JS path */
  @media (max-width: 720px) {
    .hero-stack {
      flex-direction: column;
      justify-content: flex-start;
      min-height: auto;
    }
    .flora-anchor { bottom: auto; top: 0; }
  }

  /* Tagline, centered directly under the portrait (inside .hero-aside). */
  .hero-tagline {
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1rem, 0.85rem + 0.7vw, 1.25rem);
    line-height: 1.25;
    color: var(--color-primary);
  }
  @media (max-width: 600px) {
    .hero-tagline { font-size: 0.95rem; }
  }
</style>

<style is:global>
  /* Rows are injected by JS, so they never receive Astro's build-time scope
     attribute — their rules can't live in the scoped <style> above. They're
     kept here, tightly namespaced under .hero-stack so nothing leaks globally.
     --dur / --ease / the --wN ramp inherit from the scoped .hero-stack. */
  .hero-stack .word {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows var(--dur) var(--ease),
                opacity var(--dur) var(--ease),
                color var(--dur) var(--ease);
    font-weight: 300;                  /* Inter Light */
    white-space: nowrap;
  }
  .hero-stack .word > .inner {
    display: block;
    overflow: hidden;
    min-height: 0;
    transform: translateY(0.22em);
    transition: transform var(--dur) var(--ease);
  }
  .hero-stack .word.show { grid-template-rows: 1fr; opacity: 1; }
  .hero-stack .word.show > .inner { transform: none; }

  /* Reduced motion: no build-up — JS adds .show synchronously, so kill the
     transition and land on the final all-visible frame instantly. */
  @media (prefers-reduced-motion: reduce) {
    .hero-stack .word,
    .hero-stack .word > .inner { transition: none; }
  }
</style>
