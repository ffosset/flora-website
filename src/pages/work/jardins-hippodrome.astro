---
import Base from '../../layouts/Base.astro';

// Strip any trailing slash so `${base}/path` resolves correctly whether or not
// BASE_URL ends in one (config base is '/', so BASE_URL is '/').
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// What I handled on the festival, shown as a short list under the intro.
const roles = ['Relations Presse', 'Identité visuelle', 'Coordination du festival'];
---

<Base
  title="Jardins de l’Hippodrome · Flora Fosset"
  description="4 600 visiteurs pour la 1ère édition de la fête des plantes de Bruxelles : relations presse, identité visuelle et coordination du festival."
>
  <article class="article" lang="fr">
    <div class="wrap">
      <a class="back" href={`${base}/#work`}>← Retour aux projets</a>
    </div>

    <figure class="poster">
      <img src={`${base}/images/projects/jdh.jpg`} alt="Affiche illustrée de la fête des plantes de Bruxelles, 26-27 septembre 2026, devant les bâtiments en briques rouges et blanches de l’hippodrome" width="1050" height="522" loading="eager" />
    </figure>

    <div class="wrap">
      <p class="article-meta">Oyas Belgique &amp; Drohme Park · septembre 2026</p>
      <h1 class="article-title">4 600 visiteurs pour la 1ère édition de la fête des plantes de Bruxelles</h1>
      <p class="article-sub">
        Relations Presse, identité visuelle et coordination du festival.
      </p>

      <dl class="facts">
        <div><dt>Visiteurs</dt><dd>4 600</dd></div>
        <div><dt>Dates</dt><dd>26-27 sept. 2026</dd></div>
        <div><dt>Lieu</dt><dd>Jardins de l’Hippodrome, Bruxelles</dd></div>
      </dl>

      <h2 class="section-title">Ce que j’ai fait</h2>
      <ul class="roles">
        {roles.map((r) => (
          <li>{r}</li>
        ))}
      </ul>

      <p class="site-link">
        <a href="https://www.fetedesplantes.be/" target="_blank" rel="noopener noreferrer">
          Voir le site du festival <span aria-hidden="true">↗</span><span class="sr-only"> (s’ouvre dans un nouvel onglet)</span>
        </a>
      </p>
    </div>
  </article>
</Base>

<style>
  .article {
    font-family: var(--font-display);
    color: var(--color-text);
    /* Top padding clears the floating nav. */
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }

  /* The poster carries its own lettering, so it is shown whole, above the
     title, rather than cropped behind it. */
  .poster {
    max-width: 64rem;
    margin: 0 auto var(--space-5);
    padding-inline: var(--gutter);
  }
  .poster img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
  }
  .article-meta {
    font-family: var(--font-body);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    margin-bottom: var(--space-2);
  }

  .wrap {
    max-width: 48rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .back {
    display: inline-block;
    margin-bottom: var(--space-4);
    font-size: var(--fs-small);
    color: var(--color-muted);
    text-decoration: none;
  }
  .back:hover { color: var(--color-primary); }

  .article-title {
    font-size: clamp(2rem, 1.3rem + 3vw, 3.25rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .article-sub {
    margin-top: var(--space-3);
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* Key figures, side by side on wide screens, stacked on phones. */
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-3);
    margin-block: var(--space-5);
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-border, rgba(0, 0, 0, 0.1));
  }
  .facts dt {
    font-family: var(--font-body);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
  }
  .facts dd {
    margin: var(--space-1) 0 0;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }
  .roles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }
  .roles li {
    font-size: 1.125rem;
    font-weight: 600;
    padding-left: 1.25rem;
    position: relative;
  }
  .roles li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--color-primary);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .site-link { margin-top: var(--space-5); }
  .site-link a {
    color: var(--color-primary);
    font-weight: 600;
  }
</style>
