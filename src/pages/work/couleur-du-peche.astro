<script>
  const tablist = document.querySelector('[data-story-tabs]');
  if (tablist) {
    const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
    const panels = Array.from(document.querySelectorAll('[data-story-panel]'));
    const select = (i, focus) => {
      tabs.forEach((tab, j) => {
        const on = j === i;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        if (panels[j]) panels[j].hidden = !on;
      });
      if (focus) tabs[i].focus();
      // Start the newly selected story from the top of the selector.
      const y = tablist.getBoundingClientRect().top + window.scrollY - 96;
      window.scrollTo({ top: y, behavior: 'auto' });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const dir = e.key === 'ArrowRight' ? 1 : -1;
        select((i + dir + tabs.length) % tabs.length, true);
      });
    });
  }
</script>

