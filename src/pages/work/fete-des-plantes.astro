---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';

// Strip any trailing slash so `${base}/path` resolves correctly whether or not
// BASE_URL ends in one (config base is '/', so BASE_URL is '/').
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Images live under public/images/projects/fete-des-plantes/ (see the README
// there). Until a file is dropped in, its slot renders as a labelled dashed
// frame; once the file exists it shows automatically on the next build.
// TODO: add the 6 image files listed below.
const imgDir = 'images/projects/fete-des-plantes';
const img = (file, alt, label) => ({
  src: `${base}/${imgDir}/${file}`,
  exists: existsSync(join(process.cwd(), 'public', imgDir, file)),
  alt,
  label,
});
const images = {
  // TODO: photo de l'événement avec du monde
  hero: img('evenement.jpg', 'Des visiteurs se promènent entre les stands des exposants lors de la fête des plantes de Bruxelles, à l’Hippodrome de Boitsfort', 'Photo de l’événement avec du monde'),
  // TODO: affiche A3
  poster: img('affiche-a3.jpg', 'Affiche A3 de la fête des plantes de Bruxelles, avec son identité visuelle vive et colorée', 'Affiche A3'),
  // TODO: flyer A5 recto-verso
  flyer: img('flyer-a5.jpg', 'Recto et verso du flyer A5 de la fête des plantes de Bruxelles', 'Flyer A5 recto-verso'),
  // TODO: posts Instagram
  instagram: img('posts-instagram.jpg', 'Sélection de posts Instagram annonçant la fête des plantes de Bruxelles', 'Posts Instagram'),
  // TODO: affiche dans la rue
  street: img('affiche-rue.jpg', 'Affiche de la fête des plantes de Bruxelles placardée dans la rue', 'Affiche dans la rue'),
  // TODO: photo de Marie et moi
  team: img('equipe.jpg', 'Marie et Flora, les deux coordinatrices de la fête des plantes de Bruxelles', 'Photo de Marie et moi'),
};

const stats = [
  { value: '4 600', label: 'visiteurs' },
  { value: '48', label: 'exposants' },
  { value: '16', label: 'retombées presse' },
  { value: '4 mois', label: 'de préparation' },
];

const facts = [
  { term: 'Client', value: 'Oyas Belgique & DROHME Park' },
  { term: 'Quand, où', value: '26–27 septembre 2026, Hippodrome de Boitsfort' },
  { term: 'Soutiens', value: 'Bruxelles Environnement, commune de Watermael-Boitsfort' },
  { term: 'Mon rôle', value: 'Relations presse, direction artistique et identité visuelle, réseaux sociaux, relation exposants, coordination sur place' },
  { term: 'Équipe', value: 'Marie et moi' },
];

const angles = [
  { media: 'RTBF', angle: 'La biodiversité ramenée en ville' },
  { media: 'RTBF', angle: 'Reconnecter les citadins à la nature' },
  { media: 'So Soir', angle: 'L’ampleur : 1 000 m² de jardinage' },
  { media: 'Le Bonbon', angle: 'La sortie gratuite du week-end' },
];

const coverage = [
  { name: 'RTBF', url: 'https://www.rtbf.be/article/a-bruxelles-une-nouvelle-fete-des-plantes-veut-reconnecter-les-citadins-a-la-nature-11772180' },
  { name: 'So Soir', url: 'https://sosoir.lesoir.be/768814/article/2026-09-03/1-000-m2-de-jardinage-la-toute-premiere-foire-aux-plantes-debarque-bruxelles' },
  { name: 'Le Bonbon', url: 'https://www.lebonbon.be/bruxelles/loisirs/premiere-grande-fete-plantes-bruxelles-gratuit/' },
  { name: 'Bruxelles Secrète', url: 'https://bruxellessecrete.com/fete-des-plantes-hippodrome-de-boitsfort/' },
  { name: 'Bruxelles Today', url: 'https://www.bruxellestoday.be/que-faire/la-premiere-grande-fete-des-plantes-de-bruxelles-26-27-sept-15192854.html' },
  { name: 'BXFM', url: 'https://open.spotify.com/episode/6mrJmU7kOdV7mA8d3pIw5f' },
  { name: 'BX1', url: 'https://youtu.be/nSaFr2Hc_Ko' },
];

const testimonials = [
  { quote: '« J’en ai fait des marchés mais celui-ci restera le meilleur ! »', name: 'Isa', company: 'La Pazcualisa', url: 'https://www.lapazcualisa.com/' },
  { quote: '« Ça faisait longtemps qu’on n’avait pas participé à un évènement aussi bien organisé ! »', name: 'Cléo', company: 'Compostez-moi !', url: 'https://compostez-moi.be/' },
  { quote: '« Merci Marie et Flora pour l’organisation juste parfaite. »', name: 'Julie', company: 'MOOS Deco Design', url: 'https://moos-decodesign.com/' },
];

const newTab = '(s’ouvre dans un nouvel onglet)';
---

<Base
  title="La fête des plantes de Bruxelles · Flora Fosset"
  description="4 600 visiteurs et 16 retombées presse pour une première édition au budget pub à trois chiffres : relations presse, identité visuelle et coordination."
>
  <article class="project" lang="fr">
    <div class="container">
      <!-- 1. Intro -->
      <header class="intro">
        <a class="back" href={`${base}/#work`}>← Tous les projets</a>
        <p class="tags">
          <span class="tag">événement</span>
          <span class="tag">stratégie de com</span>
        </p>
        <h1 class="title">La fête des plantes de Bruxelles</h1>
        <p class="lede">
          Une première édition avec un budget pub à trois chiffres. Résultat : 4 600 entrées et une couverture presse que beaucoup d’événements installés n’obtiennent pas.
        </p>
      </header>

      <!-- 2. Hero image -->
      <figure class="media media--hero">
        {images.hero.exists
          ? <img src={images.hero.src} alt={images.hero.alt} loading="eager" />
          : <div class="slot" role="img" aria-label={images.hero.alt}><span>Image · {images.hero.label}</span></div>}
      </figure>

      <!-- 3. Key figures -->
      <dl class="stats">
        {stats.map((s) => (
          <div class="stat">
            <dt class="stat-label">{s.label}</dt>
            <dd class="stat-value">{s.value}</dd>
          </div>
        ))}
      </dl>

      <!-- 4. Project sheet + the constraint -->
      <div class="split split--sheet">
        <dl class="facts">
          {facts.map((f) => (
            <div>
              <dt>{f.term}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
        <section class="block">
          <p class="eyebrow"><span class="slash">·</span>La contrainte</p>
          <h2 class="block-title">Faire venir du monde sans acheter l’attention</h2>
          <p>
            Une première édition part de zéro : pas de public, pas de notoriété, et un format que beaucoup connaissent déjà ailleurs en Europe. Il fallait donner une raison de venir à des gens qui n’avaient jamais entendu parler de l’événement. Le budget pub tenait en trois chiffres ; acheter de la visibilité n’était pas une option.
          </p>
        </section>
      </div>

      <!-- 5. Decision: press over ads -->
      <section class="chapter">
        <div class="split">
          <div aria-hidden="true"></div>
          <div class="block">
            <p class="eyebrow"><span class="slash">·</span>Décision</p>
            <h2 class="block-title">La presse plutôt que la pub</h2>
            <p>
              J’ai construit un dossier de presse complet pour que les journalistes aient tout sous la main sans avoir à nous relancer. Puis j’ai proposé à chaque média un angle taillé pour son public, plutôt que d’envoyer le même communiqué à tout le monde. Le résultat : plusieurs couvertures radio et papier avant l’événement, puis la télévision locale sur place.
            </p>
          </div>
        </div>

        <table class="angles">
          <thead>
            <tr><th scope="col">Média</th><th scope="col">Angle retenu</th></tr>
          </thead>
          <tbody>
            {angles.map((a) => (
              <tr><th scope="row">{a.media}</th><td>{a.angle}</td></tr>
            ))}
          </tbody>
        </table>

        <div class="coverage">
          <h3 class="coverage-title">Ils en ont parlé</h3>
          <ul class="coverage-list">
            {coverage.map((c) => (
              <li>
                <a href={c.url} target="_blank" rel="noopener noreferrer">
                  {c.name}<span class="sr-only"> {newTab}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 6. Brand identity -->
      <section class="chapter">
        <div class="split">
          <div aria-hidden="true"></div>
          <div class="block">
            <p class="eyebrow"><span class="slash">·</span>Image de marque</p>
            <h2 class="block-title">Une identité à contre-courant</h2>
            <p>
              Les fêtes des plantes portent en général la même identité : ambiance calme, couleurs douces, codes du jardin. Pour notre première édition, il fallait être repérée au premier coup d’œil. J’ai créé une identité vive et dynamique, qui s’est aussi ressentie sur place lors de l’événement.
            </p>
          </div>
        </div>

        <div class="gallery">
          {[['poster', images.poster], ['flyer', images.flyer], ['instagram', images.instagram], ['street', images.street]].map(([key, im]) => (
            <figure class={`media media--${key}`}>
              {im.exists
                ? <img src={im.src} alt={im.alt} loading="lazy" />
                : <div class="slot" role="img" aria-label={im.alt}><span>Image · {im.label}</span></div>}
            </figure>
          ))}
        </div>
      </section>

      <!-- 7. The team -->
      <section class="chapter">
        <div class="split split--center">
          <figure class="media media--team">
            {images.team.exists
              ? <img src={images.team.src} alt={images.team.alt} loading="lazy" />
              : <div class="slot" role="img" aria-label={images.team.alt}><span>Image · {images.team.label}</span></div>}
          </figure>
          <div class="block">
            <p class="eyebrow"><span class="slash">·</span>L’équipe</p>
            <h2 class="block-title">Arrivée en renfort, partie co-organisatrice</h2>
            <p>Marie a lancé et porté le projet. Je l’ai rejointe pour gérer les réseaux sociaux.</p>
            <p>
              Au fil des semaines, j’ai pris en charge la presse, l’identité visuelle, la relation avec les exposants, puis la coordination sur place pendant le week-end. À l’arrivée, nous coordonnions l’événement à deux.
            </p>
          </div>
        </div>
      </section>

      <!-- 8. Testimonials -->
      <section class="chapter">
        <div class="quotes">
          {testimonials.map((q) => (
            <figure class="quote">
              <blockquote><p>{q.quote}</p></blockquote>
              <figcaption>
                {q.name}, <a href={q.url} target="_blank" rel="noopener noreferrer">{q.company}<span class="sr-only"> {newTab}</span></a>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <!-- 9. What's next -->
      <section class="chapter">
        <div class="split">
          <div aria-hidden="true"></div>
          <div class="block">
            <p class="eyebrow"><span class="slash">·</span>Et ensuite</p>
            <p class="next">Oyas et DROHME m’ont demandé de revenir pour la deuxième édition, qui se fera en 2027.</p>
          </div>
        </div>
      </section>

      <!-- 10. Call to action: points at the site's contact footer -->
      <aside class="cta">
        <p class="cta-title">Vous lancez un projet et vous avez besoin de visibilité ?</p>
        <a class="cta-btn btn-outline" href="#contact">Parlons-en</a>
      </aside>
    </div>
  </article>
</Base>

<style>
  .project {
    font-family: var(--font-display);
    color: var(--color-text);
    /* Top padding clears the floating nav. */
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }
  /* The global `section` rule adds big section gaps; chapters use their own. */
  .project section { padding-block: 0; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* --- 1. Intro */
  .intro { max-width: 56rem; }
  .back {
    display: inline-block;
    margin-bottom: var(--space-3);
    font-size: var(--fs-small);
    color: var(--color-muted);
    text-decoration: none;
  }
  .back:hover { color: var(--color-primary); }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-2);
  }
  /* Same pill as the project cards, in the communication category colour. */
  .tag {
    font-family: var(--font-body);
    font-size: 0.82rem;
    line-height: 1.3;
    text-transform: lowercase;
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
    background: var(--cat-storytelling);
    color: #ffffff;
  }
  .title {
    font-size: var(--fs-h1);
    font-weight: 800;
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
  }
  .lede {
    margin-top: var(--space-3);
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* --- Images and their placeholder frames */
  .media { margin: 0; }
  .media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-card);
  }
  .slot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: var(--space-2);
    text-align: center;
    border: 1px dashed var(--color-muted-soft);
    border-radius: var(--radius-card);
    background: var(--color-section-bg-alt);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    color: var(--color-muted);
  }
  .media--hero {
    margin-top: var(--space-5);
    aspect-ratio: 16 / 9;
  }

  /* --- 3. Key figures: 4 across, 2 x 2 on phones */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: var(--space-4) var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }
  /* Value reads first visually, label underneath. */
  .stat { display: flex; flex-direction: column-reverse; }
  .stat-value {
    margin: 0;
    font-size: var(--fs-h1);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-primary);
  }
  .stat-label {
    margin-top: var(--space-1);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    color: var(--color-muted);
  }

  /* --- Two-column grid (1/3 + 2/3) shared by the text chapters */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-5);
    align-items: start;
  }
  .split--center { align-items: center; }
  .split--sheet { margin-top: var(--space-5); }
  .chapter { margin-top: var(--space-6); }

  .eyebrow {
    font-family: var(--font-body);
    font-size: var(--fs-h4);
    letter-spacing: 0.04em;
    color: var(--color-primary);
    margin-bottom: var(--space-1);
  }
  .eyebrow .slash { margin-right: 0.4em; }
  .block-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }
  .block p:not(.eyebrow) {
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .block p:not(.eyebrow) + p { margin-top: var(--space-2); }

  /* --- 4. Project sheet */
  .facts {
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }
  .facts dt {
    font-family: var(--font-body);
    font-size: var(--fs-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
  }
  .facts dd {
    margin: 0.25rem 0 0;
    font-size: var(--fs-body);
    line-height: 1.5;
  }

  /* --- 5. Media angles table + coverage links */
  .angles {
    width: 100%;
    margin-top: var(--space-4);
    border-collapse: collapse;
    font-size: var(--fs-body);
  }
  .angles th,
  .angles td {
    padding: 0.85rem 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-line);
  }
  .angles thead th {
    font-family: var(--font-body);
    font-size: var(--fs-eyebrow);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    border-bottom-color: var(--color-text);
  }
  .angles tbody th {
    width: 33%;
    padding-right: var(--space-2);
    font-weight: 700;
  }
  .coverage { margin-top: var(--space-3); }
  .coverage-title {
    font-family: var(--font-body);
    font-size: var(--fs-eyebrow);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    margin-bottom: var(--space-1);
  }
  .coverage-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .coverage-list a,
  .quote figcaption a {
    color: var(--color-primary);
    font-weight: 600;
  }
  .coverage-list a:hover,
  .quote figcaption a:hover { color: var(--color-primary-deep); }

  /* --- 6. Identity gallery: tall A3 left; flyer on top right, two below */
  .gallery {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .media--poster { grid-column: 1; grid-row: 1 / span 2; min-height: 28rem; }
  .media--flyer { grid-column: 2 / span 2; grid-row: 1; aspect-ratio: 2 / 1; }
  .media--instagram { grid-column: 2; grid-row: 2; aspect-ratio: 1; }
  .media--street { grid-column: 3; grid-row: 2; aspect-ratio: 1; }

  /* --- 7. Team photo */
  .media--team { aspect-ratio: 4 / 5; }

  /* --- 8. Testimonials */
  .quotes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }
  .quote {
    margin: 0;
    padding: var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .quote blockquote { margin: 0; }
  .quote blockquote p {
    font-size: var(--fs-h4);
    font-weight: 700;
    line-height: 1.4;
  }
  .quote figcaption {
    margin-top: auto;
    font-size: var(--fs-small);
    color: var(--color-muted);
  }

  /* --- 9. What's next */
  .next {
    font-size: 1.25rem;
    line-height: 1.6;
  }

  /* --- 10. Call to action */
  .cta {
    margin-top: var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }
  .cta-title {
    max-width: 30ch;
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.25;
  }
  .cta-btn {
    flex-shrink: 0;
    padding: 0.7rem 1.7rem;
    font-size: 1rem;
    color: var(--color-primary);
    text-decoration: none;
  }

  /* --- Tablet and phones: one column */
  @media (max-width: 860px) {
    .split { grid-template-columns: 1fr; gap: var(--space-3); }
    /* The empty spacer column only exists to offset text on wide screens. */
    .split > [aria-hidden='true'] { display: none; }
    .quotes { grid-template-columns: 1fr; }
    .chapter { margin-top: var(--space-5); }
    .media--team { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 640px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); padding: var(--space-3) var(--space-2); }
    .gallery { grid-template-columns: 1fr 1fr; }
    .media--poster { grid-column: 1 / span 2; grid-row: auto; min-height: 0; aspect-ratio: 3 / 4; }
    .media--flyer { grid-column: 1 / span 2; grid-row: auto; }
    .media--instagram,
    .media--street { grid-column: auto; grid-row: auto; }
    .cta { flex-direction: column; align-items: flex-start; padding: var(--space-3); }
  }
</style>
